  use TestObjectives, only: RecordObjective, &
                            RecordedCount, &
                            ResetRecords
  use FunctionalOptimizationAlgorithms, only: BisectionRootFinding

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(1), RightPivot(1), Root(1), Tolerance
  integer(C_SIZE_T) :: MaxIterations

  call ResetRecords()

  LeftPivot     = 0.0_C_DOUBLE
  RightPivot    = 3.0_C_DOUBLE
  MaxIterations = 100_C_SIZE_T
  Tolerance     = IEEE_VALUE(0.0_C_DOUBLE, IEEE_QUIET_NAN)

  Root = BisectionRootFinding(LeftPivot         = LeftPivot, &
                              RightPivot        = RightPivot, &
                              ObjectiveFunction = RecordObjective, &
                              MaxIterations     = MaxIterations, &
                              Tolerance         = Tolerance)

  !A NaN residual bound cannot be compared with: the call is rejected.
  ASSERT(RecordedCount == 0)
  ASSERT(IEEE_IS_NAN(Root(1)))

#endif
END_TEST_E

TEST_E(FOAFortranZeroIterationsEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use, intrinsic :: IEEE_ARITHMETIC, only: IEEE_IS_NAN
  use TestObjectives, only: RecordObjective, &
                            RecordedCount, &
                            ResetRecords
  use FunctionalOptimizationAlgorithms, only: BisectionRootFinding

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(1), RightPivot(1), Root(1), Tolerance
  integer(C_SIZE_T) :: MaxIterations

  call ResetRecords()

  LeftPivot     = 0.0_C_DOUBLE
  RightPivot    = 3.0_C_DOUBLE
  MaxIterations = 0_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE

  Root = BisectionRootFinding(LeftPivot         = LeftPivot, &
                              RightPivot        = RightPivot, &
                              ObjectiveFunction = RecordObjective, &
                              MaxIterations     = MaxIterations, &
                              Tolerance         = Tolerance)

  !A cap of zero leaves no iteration to perform: the call is rejected.
  ASSERT(RecordedCount == 0)
  ASSERT(IEEE_IS_NAN(Root(1)))

#endif
END_TEST_E

TEST_E(FOAFortranEmptySpaceEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use TestObjectives, only: ResetRecords, &
                            RecordedCount
  use FunctionalOptimizationAlgorithms, only: BisectionRootFinding, &
                                              ObjectiveFunctionInterface

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: Root(0), Tolerance
  integer(C_SIZE_T) :: MaxIterations
  procedure(ObjectiveFunctionInterface), pointer :: NoObjective

  call ResetRecords()

  MaxIterations = 100_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE
  NoObjective   => null()

  Root = BisectionRootFinding(LeftPivot         = [real(C_DOUBLE) ::], &
                              RightPivot        = [real(C_DOUBLE) ::], &
                              ObjectiveFunction = NoObjective, &
                              MaxIterations     = MaxIterations, &
                              Tolerance         = Tolerance)

  !An empty space has no component to search: the result is empty, and the
  !objective is never evaluated.
  ASSERT(RecordedCount == 0)
  ASSERT(size(Root) == 0)

#endif
END_TEST_E

TEST_E(FOAFortranNullObjectiveEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use, intrinsic :: IEEE_ARITHMETIC, only: IEEE_IS_NAN
  use FunctionalOptimizationAlgorithms, only: BisectionRootFinding, &
                                              ObjectiveFunctionInterface

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(1), RightPivot(1), Root(1), Tolerance
  integer(C_SIZE_T) :: MaxIterations
  procedure(ObjectiveFunctionInterface), pointer :: NoObjective

  LeftPivot     = 0.0_C_DOUBLE
  RightPivot    = 3.0_C_DOUBLE
  MaxIterations = 100_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE
  NoObjective   => null()

  Root = BisectionRootFinding(LeftPivot         = LeftPivot, &
                              RightPivot        = RightPivot, &
                              ObjectiveFunction = NoObjective, &
                              MaxIterations     = MaxIterations, &
                              Tolerance         = Tolerance)

  !A disassociated objective leaves nothing to evaluate.
  ASSERT(IEEE_IS_NAN(Root(1)))

#endif
END_TEST_E

TEST_E(FOAFortranSizeMismatchEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use, intrinsic :: IEEE_ARITHMETIC, only: IEEE_IS_NAN
  use TestObjectives, only: QuadraticObjective
  use FunctionalOptimizationAlgorithms, only: BisectionRootFinding

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(2), RightPivot(3), Root(2), Tolerance
  integer(C_SIZE_T) :: MaxIterations

  LeftPivot     = [0.0_C_DOUBLE, 0.0_C_DOUBLE]
  RightPivot    = [1.0_C_DOUBLE, 1.0_C_DOUBLE, 1.0_C_DOUBLE]
  MaxIterations = 100_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE

  Root = BisectionRootFinding(LeftPivot         = LeftPivot, &
                              RightPivot        = RightPivot, &
                              ObjectiveFunction = QuadraticObjective, &
                              MaxIterations     = MaxIterations, &
                              Tolerance         = Tolerance)

  !Pivots of different lengths do not describe a segment.
  ASSERT(all(IEEE_IS_NAN(Root)))

#endif
END_TEST_E

TEST_E(FOAFortranNestedRunEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use TestObjectives, only: NestedObjective
  use FunctionalOptimizationAlgorithms, only: BisectionRootFinding

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(1), RightPivot(1), Root(1), Tolerance
  integer(C_SIZE_T) :: MaxIterations

  LeftPivot     = 0.0_C_DOUBLE
  RightPivot    = 5.0_C_DOUBLE
  MaxIterations = 100_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE

  !The objective starts a run of its own from inside its evaluation: each
  !activation keeps its own search state.
  Root = BisectionRootFinding(LeftPivot         = LeftPivot, &
                              RightPivot        = RightPivot, &
                              ObjectiveFunction = NestedObjective, &
                              MaxIterations     = MaxIterations, &
                              Tolerance         = Tolerance)

  ASSERT(abs(Root(1) - 2.0_C_DOUBLE) <= 1.0E-12_C_DOUBLE)

#endif
END_TEST_E

TEST_E(FOAFortranSquareOneDimensionalNominal)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use TestObjectives, only: SquareObjective
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(1), RightPivot(1), Minimum(1), Tolerance
  integer(C_SIZE_T) :: MaxIterations

  LeftPivot     = 0.0_C_DOUBLE
  RightPivot    = 2.0_C_DOUBLE
  MaxIterations = 200_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = SquareObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  !The minimum of (x - 1)^2 on [0, 2] sits at the center of the first bracket,
  !and a zero tolerance asks for all the accuracy there is.
  ASSERT(abs(Minimum(1) - 1.0_C_DOUBLE) <= 1.0E-12_C_DOUBLE)

#endif
END_TEST_E

TEST_E(FOAFortranBowlMultidimensionalNominal)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use TestObjectives, only: BowlObjective
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(2), RightPivot(2), Minimum(2), Tolerance
  real(C_DOUBLE)    :: Expected(2)
  integer(C_SIZE_T) :: MaxIterations

  LeftPivot     = [0.0_C_DOUBLE, 0.0_C_DOUBLE]
  RightPivot    = [4.0_C_DOUBLE, 6.0_C_DOUBLE]
  Expected      = [2.0_C_DOUBLE, 3.0_C_DOUBLE]
  MaxIterations = 200_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = BowlObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  !The minimum depends on both components: the search runs along the segment
  !which joins the pivots, so both reach their target.
  ASSERT(all(abs(Minimum - Expected) <= 1.0E-12_C_DOUBLE))

#endif
END_TEST_E

TEST_E(FOAFortranReversedPivotMinimizationNominal)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use TestObjectives, only: BowlObjective
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(2), RightPivot(2), Tolerance
  real(C_DOUBLE)    :: ForwardMinimum(2), BackwardMinimum(2), Expected(2)
  integer(C_SIZE_T) :: MaxIterations

  LeftPivot     = [0.0_C_DOUBLE, 0.0_C_DOUBLE]
  RightPivot    = [4.0_C_DOUBLE, 6.0_C_DOUBLE]
  Expected      = [2.0_C_DOUBLE, 3.0_C_DOUBLE]
  MaxIterations = 200_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE

  ForwardMinimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                             RightPivot        = RightPivot, &
                                             ObjectiveFunction = BowlObjective, &
                                             MaxIterations     = MaxIterations, &
                                             Tolerance         = Tolerance)

  BackwardMinimum = GoldenSectionMinimization(LeftPivot         = RightPivot, &
                                              RightPivot        = LeftPivot, &
                                              ObjectiveFunction = BowlObjective, &
                                              MaxIterations     = MaxIterations, &
                                              Tolerance         = Tolerance)

  !The pivots may be supplied in either order: the segment is the same, so the
  !two estimates agree.
  ASSERT(all(abs(ForwardMinimum - Expected) <= 1.0E-12_C_DOUBLE))
  ASSERT(all(abs(BackwardMinimum - Expected) <= 1.0E-12_C_DOUBLE))

#endif
END_TEST_E

TEST_E(FOAFortranMinimumContextForwardingNominal)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use TestObjectives, only: TargetObjective
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)          :: LeftPivot(1), RightPivot(1), Minimum(1), Tolerance
  integer(C_SIZE_T)       :: MaxIterations
  real(C_DOUBLE), target  :: ContextValue
  class(*),       pointer :: Context

  ContextValue = 3.0_C_DOUBLE
  Context      => ContextValue

  LeftPivot     = 0.0_C_DOUBLE
  RightPivot    = 4.0_C_DOUBLE
  MaxIterations = 200_C_SIZE_T
  Tolerance     = 1.0E-12_C_DOUBLE

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = TargetObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance, &
                                      UserContext       = Context)

  !The minimum of (x - 3)^2 on [0, 4] is 3, not the minimum of (x - 2)^2.
  ASSERT(abs(Minimum(1) - 3.0_C_DOUBLE) <= 1.0E-12_C_DOUBLE)

  nullify(Context)

#endif
END_TEST_E

TEST_E(FOAFortranMinimumNullContextNominal)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use TestObjectives, only: NullContextObjective, &
                            ResetRecords, &
                            SawNullContext
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(1), RightPivot(1), Minimum(1), Tolerance
  integer(C_SIZE_T) :: MaxIterations

  call ResetRecords()

  LeftPivot     = 0.0_C_DOUBLE
  RightPivot    = 3.0_C_DOUBLE
  MaxIterations = 200_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = NullContextObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  !An absent context is a value like any other, and reaches the objective. The
  !objective decreases, so the minimum is at the left pivot.
  ASSERT(SawNullContext)
  ASSERT(abs(Minimum(1) - 0.0_C_DOUBLE) <= 1.0E-12_C_DOUBLE)

#endif
END_TEST_E

TEST_E(FOAFortranMinimumCallbackProtocolNominal)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use TestObjectives, only: RecordObjective, &
                            RecordedPoints, &
                            RecordedCount, &
                            ResetRecords
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE), parameter :: Precision      = 1.0E-9_C_DOUBLE
  real(C_DOUBLE), parameter :: FirstProbe     = 1.5278640450004204_C_DOUBLE
  real(C_DOUBLE), parameter :: SecondProbe    = 2.4721359549995796_C_DOUBLE
  real(C_DOUBLE), parameter :: ThirdProbe     = 0.9442719099991592_C_DOUBLE
  real(C_DOUBLE), parameter :: SpannedMinimum = 1.2360679774997898_C_DOUBLE

  real(C_DOUBLE)    :: LeftPivot(1), RightPivot(1), Minimum(1), Tolerance
  integer(C_SIZE_T) :: MaxIterations

  call ResetRecords()

  LeftPivot     = 0.0_C_DOUBLE
  RightPivot    = 4.0_C_DOUBLE
  MaxIterations = 1_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = RecordObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  !The two interior points are evaluated before the first iteration, and one
  !point per iteration afterwards; the estimate is their midpoint.
  ASSERT(RecordedCount == 3)
  ASSERT(abs(RecordedPoints(1) - FirstProbe) <= Precision)
  ASSERT(abs(RecordedPoints(2) - SecondProbe) <= Precision)
  ASSERT(abs(RecordedPoints(3) - ThirdProbe) <= Precision)
  ASSERT(abs(Minimum(1) - SpannedMinimum) <= Precision)

#endif
END_TEST_E

TEST_E(FOAFortranMinimumAtPivotEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use TestObjectives, only: TargetObjective
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)          :: LeftPivot(1), RightPivot(1), Minimum(1), Tolerance
  integer(C_SIZE_T)       :: MaxIterations
  real(C_DOUBLE), target  :: ContextValue
  class(*),       pointer :: Context

  ContextValue = 2.0_C_DOUBLE
  Context      => ContextValue

  LeftPivot     = 2.0_C_DOUBLE
  RightPivot    = 5.0_C_DOUBLE
  MaxIterations = 200_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = TargetObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance, &
                                      UserContext       = Context)

  !A minimum at a pivot is approached but never reached: the bracket collapses
  !onto the end of the segment which holds it.
  ASSERT(Minimum(1) >= 2.0_C_DOUBLE)
  ASSERT(Minimum(1) - 2.0_C_DOUBLE <= 1.0E-12_C_DOUBLE)

  !The same at the right pivot, where the segment ends at the minimum.
  ContextValue = 3.0_C_DOUBLE
  LeftPivot    = 0.0_C_DOUBLE
  RightPivot   = 3.0_C_DOUBLE

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = TargetObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance, &
                                      UserContext       = Context)

  ASSERT(Minimum(1) <= 3.0_C_DOUBLE)
  ASSERT(3.0_C_DOUBLE - Minimum(1) <= 1.0E-12_C_DOUBLE)

  nullify(Context)

#endif
END_TEST_E

TEST_E(FOAFortranToleranceNotResidualEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use TestObjectives, only: SteepObjective
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(1), RightPivot(1), Minimum(1), Tolerance
  integer(C_SIZE_T) :: MaxIterations

  LeftPivot     = 0.0_C_DOUBLE
  RightPivot    = 2.0_C_DOUBLE
  MaxIterations = 200_C_SIZE_T
  Tolerance     = 1.0E-3_C_DOUBLE

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = SteepObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  !The tolerance measures the bracket, not the value of the objective: the
  !steep valley is left while its value at the estimate is still large.
  ASSERT(abs(Minimum(1) - 0.7_C_DOUBLE) <= 1.0E-3_C_DOUBLE)
  ASSERT(SteepObjective(Minimum) >= 1.0E-3_C_DOUBLE)

#endif
END_TEST_E

TEST_E(FOAFortranMinimumIterationCapAccuracyEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use TestObjectives, only: SquareObjective, &
                            RecordObjective, &
                            RecordedCount, &
                            ResetRecords
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(1), RightPivot(1), Minimum(1), Tolerance
  integer(C_SIZE_T) :: MaxIterations

  LeftPivot     = 0.0_C_DOUBLE
  RightPivot    = 2.0_C_DOUBLE
  MaxIterations = 10_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = SquareObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  !The bracket keeps a factor rho per iteration, so the cap and not the
  !tolerance sets the accuracy when the cap comes first.
  ASSERT(abs(Minimum(1) - 1.0_C_DOUBLE) <= 8.2E-3_C_DOUBLE)

  !Two interior points before the loop and one point per iteration.
  LeftPivot  = 0.0_C_DOUBLE
  RightPivot = 4.0_C_DOUBLE

  call ResetRecords()

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = RecordObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  ASSERT(RecordedCount == 12)

#endif
END_TEST_E

TEST_E(FOAFortranExtremePivotEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use, intrinsic :: IEEE_ARITHMETIC, only: IEEE_IS_NAN
  use TestObjectives, only: AbsObjective
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(1), RightPivot(1), Minimum(1), Tolerance
  integer(C_SIZE_T) :: MaxIterations

  LeftPivot     =   1.0E308_C_DOUBLE
  RightPivot    =  -1.0E308_C_DOUBLE
  MaxIterations = 200_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = AbsObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  !The interior points are convex combinations of the pivots, so their
  !difference never enters the computation and the minimum is reached.
  ASSERT(.not.IEEE_IS_NAN(Minimum(1)))
  ASSERT(abs(Minimum(1) - 0.0_C_DOUBLE) <= 0.0_C_DOUBLE)

#endif
END_TEST_E

TEST_E(FOAFortranMinimumCollapsedBracketEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use TestObjectives, only: RecordObjective, &
                            RecordedCount, &
                            ResetRecords
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(1), RightPivot(1), Minimum(1), Tolerance
  integer(C_SIZE_T) :: MaxIterations

  call ResetRecords()

  LeftPivot     = 1.0E16_C_DOUBLE
  RightPivot    = 1.0E16_C_DOUBLE + 2.0_C_DOUBLE
  MaxIterations = 200_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = RecordObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  !The pivots are two neighbouring numbers: there is no room for an interior
  !point, so the segment is returned unchanged and nothing is evaluated.
  ASSERT(RecordedCount == 0)
  ASSERT(abs(Minimum(1) - LeftPivot(1)) <= 0.0_C_DOUBLE)

#endif
END_TEST_E

TEST_E(FOAFortranNonUnimodalEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use TestObjectives, only: DeceptiveObjective
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(1), RightPivot(1), Minimum(1), Tolerance
  integer(C_SIZE_T) :: MaxIterations

  LeftPivot     = 0.0_C_DOUBLE
  RightPivot    = 4.0_C_DOUBLE
  MaxIterations = 200_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = DeceptiveObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  !The objective has a shallow valley at 2.5 and a deep one at 1. Golden
  !section needs no more than unimodality, so it returns the local minimum it
  !saw and reports nothing.
  ASSERT(abs(Minimum(1) - 2.5_C_DOUBLE) <= 1.0E-6_C_DOUBLE)

  !The value of the global minimum is -1 at x = 1, which is not what the
  !estimate holds.
  ASSERT(DeceptiveObjective(Minimum) > -1.0E-3_C_DOUBLE)

#endif
END_TEST_E

TEST_E(FOAFortranToleranceCoversSegmentEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use TestObjectives, only: RecordObjective, &
                            RecordedCount, &
                            ResetRecords
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(1), RightPivot(1), Minimum(1), Tolerance
  integer(C_SIZE_T) :: MaxIterations

  call ResetRecords()

  LeftPivot     = 0.0_C_DOUBLE
  RightPivot    = 4.0_C_DOUBLE
  MaxIterations = 200_C_SIZE_T
  Tolerance     = 4.0_C_DOUBLE

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = RecordObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  !A tolerance which covers the whole segment settles on its midpoint at once.
  ASSERT(RecordedCount == 0)
  ASSERT(abs(Minimum(1) - 2.0_C_DOUBLE) <= 0.0_C_DOUBLE)

  !Just below that width the bracket has to shrink first: two interior points
  !are evaluated, and one more after the width has fallen to 2.472, which
  !leaves the midpoint of [0, 0.618] of the segment.
  Tolerance = 3.9_C_DOUBLE

  call ResetRecords()

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = RecordObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  ASSERT(RecordedCount == 3)
  ASSERT(abs(Minimum(1) - 1.2360679774997898_C_DOUBLE) <= 1.0E-12_C_DOUBLE)

#endif
END_TEST_E

TEST_E(FOAFortranFlatObjectiveEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use TestObjectives, only: ConstantObjective
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(1), RightPivot(1), Minimum(1), Tolerance
  integer(C_SIZE_T) :: MaxIterations

  LeftPivot     = 0.0_C_DOUBLE
  RightPivot    = 4.0_C_DOUBLE
  MaxIterations = 200_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = ConstantObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  !A constant objective gives points of equal value to every iteration: each
  !tie keeps the right part of the bracket, so the estimate runs to the right
  !pivot.
  ASSERT(abs(Minimum(1) - 4.0_C_DOUBLE) <= 1.0E-12_C_DOUBLE)

#endif
END_TEST_E

TEST_E(FOAFortranMinimumNaNAtStartEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use, intrinsic :: IEEE_ARITHMETIC, only: IEEE_IS_NAN
  use TestObjectives, only: AlwaysNaNObjective, &
                            RecordedCount, &
                            ResetRecords
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(1), RightPivot(1), Minimum(1), Tolerance
  integer(C_SIZE_T) :: MaxIterations

  call ResetRecords()

  LeftPivot     = 0.0_C_DOUBLE
  RightPivot    = 4.0_C_DOUBLE
  MaxIterations = 200_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = AlwaysNaNObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  !An objective which is undefined everywhere stops the search at the first
  !comparison, after the two interior points.
  ASSERT(IEEE_IS_NAN(Minimum(1)))
  ASSERT(RecordedCount == 2)

#endif
END_TEST_E

TEST_E(FOAFortranNaNEncounteredEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use, intrinsic :: IEEE_ARITHMETIC, only: IEEE_IS_NAN
  use TestObjectives, only: NaNObjective
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(1), RightPivot(1), Minimum(1), Tolerance
  integer(C_SIZE_T) :: MaxIterations

  LeftPivot     = 0.0_C_DOUBLE
  RightPivot    = 4.0_C_DOUBLE
  MaxIterations = 200_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = NaNObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  !An objective which becomes undefined part of the way through stops the
  !search at the point which returned it.
  ASSERT(IEEE_IS_NAN(Minimum(1)))

#endif
END_TEST_E

TEST_E(FOAFortranMinimumNaNInsideLoopEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use, intrinsic :: IEEE_ARITHMETIC, only: IEEE_IS_NAN
  use TestObjectives, only: LowEdgeNaNObjective, &
                            PartialNaNObjective, &
                            RecordedCount, &
                            ResetRecords
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(1), RightPivot(1), Minimum(1), Tolerance
  integer(C_SIZE_T) :: MaxIterations

  call ResetRecords()

  LeftPivot     = 0.0_C_DOUBLE
  RightPivot    = 4.0_C_DOUBLE
  MaxIterations = 200_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE

  !(x - 1)^2 is smaller at the left interior point, so that end is refined
  !first, and the new point lies below the edge at 1.
  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = LowEdgeNaNObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  ASSERT(IEEE_IS_NAN(Minimum(1)))
  ASSERT(RecordedCount == 3)

  !(x - 2.5)^2 is smaller at the right interior point, so that end is refined
  !first, and the new point lies above the edge at 2.7.
  call ResetRecords()

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = PartialNaNObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  !A NaN which appears at a point refined inside the loop, and not at the two
  !with which the search opens, stops the search at that point.
  ASSERT(IEEE_IS_NAN(Minimum(1)))
  ASSERT(RecordedCount == 3)

#endif
END_TEST_E

TEST_E(FOAFortranMinimumNaNPivotEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use, intrinsic :: IEEE_ARITHMETIC, only: IEEE_IS_NAN, &
                                           IEEE_QUIET_NAN, &
                                           IEEE_VALUE
  use TestObjectives, only: RecordObjective, &
                            RecordedCount, &
                            ResetRecords
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(1), RightPivot(1), Minimum(1), Tolerance
  integer(C_SIZE_T) :: MaxIterations

  call ResetRecords()

  LeftPivot     = IEEE_VALUE(0.0_C_DOUBLE, IEEE_QUIET_NAN)
  RightPivot    = 4.0_C_DOUBLE
  MaxIterations = 100_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = RecordObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  !A NaN pivot is not a segment: the call is rejected before the objective is
  !evaluated, whatever the objective does with its argument.
  ASSERT(RecordedCount == 0)
  ASSERT(IEEE_IS_NAN(Minimum(1)))

#endif
END_TEST_E

TEST_E(FOAFortranMinimumInfinitePivotEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use, intrinsic :: IEEE_ARITHMETIC, only: IEEE_IS_NAN, &
                                           IEEE_NEGATIVE_INF, &
                                           IEEE_VALUE
  use TestObjectives, only: RecordObjective, &
                            RecordedCount, &
                            ResetRecords
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(1), RightPivot(1), Minimum(1), Tolerance
  integer(C_SIZE_T) :: MaxIterations

  call ResetRecords()

  LeftPivot     = IEEE_VALUE(0.0_C_DOUBLE, IEEE_NEGATIVE_INF)
  RightPivot    = 4.0_C_DOUBLE
  MaxIterations = 100_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = RecordObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  !An infinite pivot has no finite length: the call is rejected before the
  !objective is evaluated.
  ASSERT(RecordedCount == 0)
  ASSERT(IEEE_IS_NAN(Minimum(1)))

  !The same with the infinite value on the right: both ends are validated.
  LeftPivot  = 0.0_C_DOUBLE
  RightPivot = IEEE_VALUE(0.0_C_DOUBLE, IEEE_NEGATIVE_INF)

  call ResetRecords()

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = RecordObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  ASSERT(RecordedCount == 0)
  ASSERT(IEEE_IS_NAN(Minimum(1)))

#endif
END_TEST_E

TEST_E(FOAFortranMinimumNegativeToleranceEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use, intrinsic :: IEEE_ARITHMETIC, only: IEEE_IS_NAN
  use TestObjectives, only: RecordObjective, &
                            RecordedCount, &
                            ResetRecords
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(1), RightPivot(1), Minimum(1), Tolerance
  integer(C_SIZE_T) :: MaxIterations

  call ResetRecords()

  LeftPivot     = 0.0_C_DOUBLE
  RightPivot    = 3.0_C_DOUBLE
  MaxIterations = 100_C_SIZE_T
  Tolerance     = -1.0E-6_C_DOUBLE

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = RecordObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  !A negative bound on the width of the bracket can never be met: the call is
  !rejected before the objective is evaluated.
  ASSERT(RecordedCount == 0)
  ASSERT(IEEE_IS_NAN(Minimum(1)))

#endif
END_TEST_E

TEST_E(FOAFortranMinimumNaNToleranceEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use, intrinsic :: IEEE_ARITHMETIC, only: IEEE_IS_NAN, &
                                           IEEE_QUIET_NAN, &
                                           IEEE_VALUE
  use TestObjectives, only: RecordObjective, &
                            RecordedCount, &
                            ResetRecords
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(1), RightPivot(1), Minimum(1), Tolerance
  integer(C_SIZE_T) :: MaxIterations

  call ResetRecords()

  LeftPivot     = 0.0_C_DOUBLE
  RightPivot    = 3.0_C_DOUBLE
  MaxIterations = 100_C_SIZE_T
  Tolerance     = IEEE_VALUE(0.0_C_DOUBLE, IEEE_QUIET_NAN)

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = RecordObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  !A NaN bound cannot be compared with: the call is rejected.
  ASSERT(RecordedCount == 0)
  ASSERT(IEEE_IS_NAN(Minimum(1)))

#endif
END_TEST_E

TEST_E(FOAFortranMinimumZeroIterationsEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use, intrinsic :: IEEE_ARITHMETIC, only: IEEE_IS_NAN
  use TestObjectives, only: RecordObjective, &
                            RecordedCount, &
                            ResetRecords
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(1), RightPivot(1), Minimum(1), Tolerance
  integer(C_SIZE_T) :: MaxIterations

  call ResetRecords()

  LeftPivot     = 0.0_C_DOUBLE
  RightPivot    = 3.0_C_DOUBLE
  MaxIterations = 0_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = RecordObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  !Without iterations there is no estimate to report: the call is rejected.
  ASSERT(RecordedCount == 0)
  ASSERT(IEEE_IS_NAN(Minimum(1)))

