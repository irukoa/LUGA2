TEST_E(FOAFortranMinimumEmptySpaceEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use TestObjectives, only: ResetRecords, &
                            RecordedCount
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization, &
                                              ObjectiveFunctionInterface

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: Minimum(0), Tolerance
  integer(C_SIZE_T) :: MaxIterations
  procedure(ObjectiveFunctionInterface), pointer :: NoObjective

  call ResetRecords()

  MaxIterations = 100_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE
  NoObjective   => null()

  Minimum = GoldenSectionMinimization(LeftPivot         = [real(C_DOUBLE) ::], &
                                      RightPivot        = [real(C_DOUBLE) ::], &
                                      ObjectiveFunction = NoObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  !A segment without components has no minimum to look for: the result is
  !empty, and the objective is never evaluated.
  ASSERT(RecordedCount == 0)
  ASSERT(size(Minimum) == 0)

#endif
END_TEST_E

TEST_E(FOAFortranMinimumSizeMismatchEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use, intrinsic :: IEEE_ARITHMETIC, only: IEEE_IS_NAN
  use TestObjectives, only: BowlObjective
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(2), RightPivot(3), Minimum(2), Tolerance
  integer(C_SIZE_T) :: MaxIterations

  LeftPivot     = [0.0_C_DOUBLE, 0.0_C_DOUBLE]
  RightPivot    = [4.0_C_DOUBLE, 6.0_C_DOUBLE, 1.0_C_DOUBLE]
  MaxIterations = 100_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = BowlObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  !Pivots of different lengths do not describe a segment.
  ASSERT(all(IEEE_IS_NAN(Minimum)))

#endif
END_TEST_E

TEST_E(FOAFortranMinimumNullObjectiveEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
