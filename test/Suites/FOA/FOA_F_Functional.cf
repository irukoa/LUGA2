  LeftPivot     = 0.0_C_DOUBLE
  RightPivot    = 3.0_C_DOUBLE
  MaxIterations = 100_C_SIZE_T
  Tolerance     = IEEE_VALUE(0.0_C_DOUBLE, IEEE_QUIET_NAN)

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = RecordObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  !A NaN bound cannot be compared with: the call is rejected.
  ASSERT(RecordedCount == 0)
  ASSERT(IEEE_IS_NAN(Minimum(1)))

#endif
END_TEST_E

TEST_E(FOAFortranMinimumZeroIterationsEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use, intrinsic :: IEEE_ARITHMETIC, only: IEEE_IS_NAN
  use TestObjectives, only: RecordObjective, &
                            RecordedCount, &
                            ResetRecords
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(1), RightPivot(1), Minimum(1), Tolerance
  integer(C_SIZE_T) :: MaxIterations

  call ResetRecords()

  LeftPivot     = 0.0_C_DOUBLE
  RightPivot    = 3.0_C_DOUBLE
  MaxIterations = 0_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = RecordObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  !Without iterations there is no estimate to report: the call is rejected.
  ASSERT(RecordedCount == 0)
  ASSERT(IEEE_IS_NAN(Minimum(1)))

#endif
END_TEST_E

TEST_E(FOAFortranMinimumEmptySpaceEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use TestObjectives, only: ResetRecords, &
                            RecordedCount
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization, &
                                              ObjectiveFunctionInterface

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: Minimum(0), Tolerance
  integer(C_SIZE_T) :: MaxIterations
  procedure(ObjectiveFunctionInterface), pointer :: NoObjective

  call ResetRecords()

  MaxIterations = 100_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE
  NoObjective   => null()

  Minimum = GoldenSectionMinimization(LeftPivot         = [real(C_DOUBLE) ::], &
                                      RightPivot        = [real(C_DOUBLE) ::], &
                                      ObjectiveFunction = NoObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  !A segment without components has no minimum to look for: the result is
  !empty, and the objective is never evaluated.
  ASSERT(RecordedCount == 0)
  ASSERT(size(Minimum) == 0)

#endif
END_TEST_E

TEST_E(FOAFortranMinimumSizeMismatchEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use, intrinsic :: IEEE_ARITHMETIC, only: IEEE_IS_NAN
  use TestObjectives, only: BowlObjective
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(2), RightPivot(3), Minimum(2), Tolerance
  integer(C_SIZE_T) :: MaxIterations

  LeftPivot     = [0.0_C_DOUBLE, 0.0_C_DOUBLE]
  RightPivot    = [4.0_C_DOUBLE, 6.0_C_DOUBLE, 1.0_C_DOUBLE]
  MaxIterations = 100_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = BowlObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  !Pivots of different lengths do not describe a segment.
  ASSERT(all(IEEE_IS_NAN(Minimum)))

#endif
END_TEST_E

TEST_E(FOAFortranMinimumNullObjectiveEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use, intrinsic :: IEEE_ARITHMETIC, only: IEEE_IS_NAN
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization, &
                                              ObjectiveFunctionInterface

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(1), RightPivot(1), Minimum(1), Tolerance
  integer(C_SIZE_T) :: MaxIterations
  procedure(ObjectiveFunctionInterface), pointer :: NoObjective

  LeftPivot     = 0.0_C_DOUBLE
  RightPivot    = 3.0_C_DOUBLE
  MaxIterations = 100_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE
  NoObjective   => null()

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = NoObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  !A missing objective is a rejection before anything is evaluated.
  ASSERT(IEEE_IS_NAN(Minimum(1)))

#endif
END_TEST_E

TEST_E(FOAFortranMinimumNestedRunEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use TestObjectives, only: NestedMinimumObjective
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(1), RightPivot(1), Minimum(1), Tolerance
  integer(C_SIZE_T) :: MaxIterations

  LeftPivot     = -5.0_C_DOUBLE
  RightPivot    =  5.0_C_DOUBLE
  MaxIterations = 100_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE

  !The objective starts a minimization of its own from inside its evaluation:
  !each activation keeps its own search state.
  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = NestedMinimumObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  ASSERT(abs(Minimum(1) - 1.0_C_DOUBLE) <= 1.0E-6_C_DOUBLE)

#endif
END_TEST_E

TEST_E(FOAFortranMinimumOverflowEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use, intrinsic :: IEEE_ARITHMETIC, only: IEEE_IS_NAN, &
                                           IEEE_OVERFLOW, &
                                           IEEE_GET_FLAG, &
                                           IEEE_SET_FLAG
  use TestObjectives, only: AbsObjective
  use FunctionalOptimizationAlgorithms, only: GoldenSectionMinimization

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: LeftPivot(1), RightPivot(1), Minimum(1), Tolerance
  integer(C_SIZE_T) :: MaxIterations
  logical           :: Overflow

  !The segment spans twice the range of the type, so the difference between its
  !ends and the length restored from the halves both overflow: the length
  !saturates at the largest value of the type, which raises no exception.
  LeftPivot     = -huge(1.0_C_DOUBLE)
  RightPivot    =  huge(1.0_C_DOUBLE)
  MaxIterations = 200_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE

  call IEEE_SET_FLAG(IEEE_OVERFLOW, .false.)

  Minimum = GoldenSectionMinimization(LeftPivot         = LeftPivot, &
                                      RightPivot        = RightPivot, &
                                      ObjectiveFunction = AbsObjective, &
                                      MaxIterations     = MaxIterations, &
                                      Tolerance         = Tolerance)

  call IEEE_GET_FLAG(IEEE_OVERFLOW, Overflow)

  ASSERT(.not.Overflow)
  ASSERT(.not.IEEE_IS_NAN(Minimum(1)))

  !The pivots are symmetric about the minimum of |x|, so the bracket collapses
  !on it and the estimate is exact up to the spacing of the type.
  ASSERT(abs(Minimum(1)) <= epsilon(1.0_C_DOUBLE) * huge(1.0_C_DOUBLE))

#endif
END_TEST_E

TEST_E(FOAFortranBisectionOverflowEdgeCase)
#ifdef TSD_FORTRAN_IMPL

  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, &
                                         C_SIZE_T
  use, intrinsic :: IEEE_ARITHMETIC, only: IEEE_OVERFLOW, &
                                           IEEE_GET_FLAG, &
                                           IEEE_SET_FLAG
  use TestObjectives, only: TargetLineObjective
  use FunctionalOptimizationAlgorithms, only: BisectionRootFinding

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)          :: LeftPivot(1), RightPivot(1), Root(1), Tolerance
  integer(C_SIZE_T)       :: MaxIterations
  real(C_DOUBLE), target  :: Target
  class(*),       pointer :: UserContext
  logical                 :: Overflow

  !The two ends are enormous and of the same sign, so their sum overflows: the
  !midpoint is formed from their halves, and it is the zero of the objective.
  LeftPivot     = 1.0E308_C_DOUBLE
  RightPivot    = 1.5E308_C_DOUBLE
  Target        = 1.25E308_C_DOUBLE
  MaxIterations = 100_C_SIZE_T
  Tolerance     = 0.0_C_DOUBLE

  UserContext => Target

  call IEEE_SET_FLAG(IEEE_OVERFLOW, .false.)

  Root = BisectionRootFinding(LeftPivot         = LeftPivot, &
                              RightPivot        = RightPivot, &
                              ObjectiveFunction = TargetLineObjective, &
                              MaxIterations     = MaxIterations, &
                              Tolerance         = Tolerance, &
                              UserContext       = UserContext)

  call IEEE_GET_FLAG(IEEE_OVERFLOW, Overflow)

  ASSERT(.not.Overflow)
  ASSERT(abs(Root(1) - Target) <= 1.0E293_C_DOUBLE)

#endif
END_TEST_E

