#include "test/TSD/TSD_Fortran.h"
#ifdef TSD_FORTRAN_IMPL
#include "src/MCI/MessageCodingInterface.M90"
#endif

TEST_E(MCIFortranCompileAndAccessors)
#ifdef TSD_FORTRAN_IMPL
  use MessageCodingInterface, only: MCICompiledFormat, C_SIZE_T

  implicit none
  TSD_TEST_E_INTERFACES

  type(MCICompiledFormat)      :: CompiledFormat
  character(24)                :: Format
  integer(C_SIZE_T), parameter :: InvalidFieldId = not(0_C_SIZE_T)

  !A default-initialized wrapper owns no C-side state.
  ASSERT(.not.CompiledFormat%Initialized())
  ASSERT(CompiledFormat%ByteSize() == 0_C_SIZE_T)
  ASSERT(CompiledFormat%FieldCount() == 0_C_SIZE_T)
  call CheckFieldId(CompiledFormat, "1", InvalidFieldId)

  Format = "8|2R(2|3)"
  call CompiledFormat%New(Format, 8_C_SIZE_T)
  ASSERT_X(CompiledFormat%Initialized())
  ASSERT(CompiledFormat%ByteSize() == 3_C_SIZE_T)
  ASSERT(CompiledFormat%FieldCount() == 5_C_SIZE_T)
  call CheckFieldId(CompiledFormat, "1", 0_C_SIZE_T)
  call CheckFieldId(CompiledFormat, "2.1", 1_C_SIZE_T)
  call CheckFieldId(CompiledFormat, "2.2", 2_C_SIZE_T)
  call CheckFieldId(CompiledFormat, "3.1", 3_C_SIZE_T)
  call CheckFieldId(CompiledFormat, "3.2", 4_C_SIZE_T)
  call CheckFieldId(CompiledFormat, "2", InvalidFieldId)
  call CheckFieldId(CompiledFormat, "2.3", InvalidFieldId)
  call CheckFieldId(CompiledFormat, "4.1", InvalidFieldId)

  !The wrapper trims the format and semantic identifiers before the C call,
  !so trailing blanks in either character argument are harmless.
  Format = "8|2R(2|3)   "
  call CompiledFormat%New(Format, 8_C_SIZE_T)
  ASSERT_X(CompiledFormat%Initialized())
  call CheckFieldId(CompiledFormat, "2.1   ", 1_C_SIZE_T)
  call CheckFieldId(CompiledFormat, "3.2   ", 4_C_SIZE_T)

  Format = "2R(3R(4|5))"
  call CompiledFormat%New(Format, 5_C_SIZE_T)
  ASSERT_X(CompiledFormat%Initialized())
  ASSERT(CompiledFormat%ByteSize() == 7_C_SIZE_T)
  ASSERT(CompiledFormat%FieldCount() == 12_C_SIZE_T)
  call CheckFieldId(CompiledFormat, "1.1.1", 0_C_SIZE_T)
  call CheckFieldId(CompiledFormat, "1.3.2", 5_C_SIZE_T)
  call CheckFieldId(CompiledFormat, "2.3.2", 11_C_SIZE_T)
  call CheckFieldId(CompiledFormat, "3.1.1", InvalidFieldId)

  !The compiled format keeps its own copy of the source string.
  Format = "7|2R(3|5)"
  call CompiledFormat%New(Format, 7_C_SIZE_T)
  ASSERT_X(CompiledFormat%Initialized())
  Format = "not the original format"
  call CheckFieldId(CompiledFormat, "2.2", 2_C_SIZE_T)
  call CheckFieldId(CompiledFormat, "3.2", 4_C_SIZE_T)

  !Renewing an owner releases its previous handle before compiling again.
  Format = "8"
  call CompiledFormat%New(Format, 8_C_SIZE_T)
  ASSERT_X(CompiledFormat%Initialized())
  ASSERT(CompiledFormat%ByteSize() == 1_C_SIZE_T)
  ASSERT(CompiledFormat%FieldCount() == 1_C_SIZE_T)

  Format = "16|16"
  call CompiledFormat%New(Format, 16_C_SIZE_T)
  ASSERT_X(CompiledFormat%Initialized())
  ASSERT(CompiledFormat%ByteSize() == 4_C_SIZE_T)
  ASSERT(CompiledFormat%FieldCount() == 2_C_SIZE_T)

  call CompiledFormat%Free()
  ASSERT(.not.CompiledFormat%Initialized())
  ASSERT(CompiledFormat%ByteSize() == 0_C_SIZE_T)
  ASSERT(CompiledFormat%FieldCount() == 0_C_SIZE_T)
  call CheckFieldId(CompiledFormat, "1", InvalidFieldId)

  !Releasing an already released format is a no-op.
  call CompiledFormat%Free()
  ASSERT(.not.CompiledFormat%Initialized())

  contains

    subroutine CheckFieldId(CompiledFormat, SemanticId, Expected)
      type(MCICompiledFormat), intent(in) :: CompiledFormat
      character(*),            intent(in) :: SemanticId
      integer(C_SIZE_T),       intent(in) :: Expected

      ASSERT_X(CompiledFormat%FieldId(SemanticId) == Expected)
    end subroutine CheckFieldId
#endif
END_TEST_E

TEST_E(MCIFortranCompileRejectsInvalidFormats)
#ifdef TSD_FORTRAN_IMPL
  use MessageCodingInterface, only: MCICompiledFormat, C_SIZE_T

  implicit none
  TSD_TEST_E_INTERFACES

  type(MCICompiledFormat) :: CompiledFormat

  call CompiledFormat%New("0", 8_C_SIZE_T)
  ASSERT(.not.CompiledFormat%Initialized())

  call CompiledFormat%New("1|", 8_C_SIZE_T)
  ASSERT(.not.CompiledFormat%Initialized())

  call CompiledFormat%New("1R(0)", 8_C_SIZE_T)
  ASSERT(.not.CompiledFormat%Initialized())

  call CompiledFormat%New("1r(2)", 8_C_SIZE_T)
  ASSERT(.not.CompiledFormat%Initialized())

  call CompiledFormat%New("1 R(2)", 8_C_SIZE_T)
  ASSERT(.not.CompiledFormat%Initialized())

  !The maximum field width is enforced by the C compiler.
  call CompiledFormat%New("9", 8_C_SIZE_T)
  ASSERT(.not.CompiledFormat%Initialized())

  call CompiledFormat%New("1", 0_C_SIZE_T)
  ASSERT(.not.CompiledFormat%Initialized())

  !A blank Fortran string trims to the empty format.
  call CompiledFormat%New("   ", 8_C_SIZE_T)
  ASSERT(.not.CompiledFormat%Initialized())

  !A failed recompilation leaves no stale handle behind.
  call CompiledFormat%New("8", 8_C_SIZE_T)
  ASSERT_X(CompiledFormat%Initialized())
  call CompiledFormat%New("1R(0)", 8_C_SIZE_T)
  ASSERT(.not.CompiledFormat%Initialized())
  ASSERT(CompiledFormat%ByteSize() == 0_C_SIZE_T)
  ASSERT(CompiledFormat%FieldCount() == 0_C_SIZE_T)
#endif
END_TEST_E

TEST_E(MCIFortranCopyOwnership)
#ifdef TSD_FORTRAN_IMPL
  use MessageCodingInterface, only: MCICompiledFormat, C_SIZE_T

  implicit none
  TSD_TEST_E_INTERFACES

  type(MCICompiledFormat) :: Original, Copy, Empty, EmptyCopy

  !Copying an empty format yields another empty, non-owning alias.
  EmptyCopy = Empty
  ASSERT(.not.EmptyCopy%Initialized())
  call EmptyCopy%Free()
  ASSERT(.not.EmptyCopy%Initialized())

  call Original%New("8|8", 8_C_SIZE_T)
  ASSERT_X(Original%Initialized())

  !Assignment aliases the C-side format instead of duplicating it.
  Copy = Original
  ASSERT_X(Copy%Initialized())
  ASSERT(Copy%ByteSize() == 2_C_SIZE_T)
  call CheckFieldId(Copy, "2", 1_C_SIZE_T)

  !Releasing the alias leaves the owner untouched.
  call Copy%Free()
  ASSERT(.not.Copy%Initialized())
  ASSERT(Original%Initialized())
  ASSERT(Original%ByteSize() == 2_C_SIZE_T)

  !Rebinding an owning alias releases its previous handle first.
  call Copy%New("4", 4_C_SIZE_T)
  ASSERT_X(Copy%Initialized())
  ASSERT(Copy%ByteSize() == 1_C_SIZE_T)
  Copy = Original
  ASSERT_X(Copy%Initialized())
  ASSERT(Copy%ByteSize() == 2_C_SIZE_T)
  call Copy%Free()
  ASSERT(.not.Copy%Initialized())
  ASSERT(Original%Initialized())

  !Renewing a live alias unbinds it and allocates a new owned format without
  !touching the aliased target.
  Copy = Original
  ASSERT_X(Copy%Initialized())
  call Copy%New("4", 4_C_SIZE_T)
  ASSERT_X(Copy%Initialized())
  ASSERT(Copy%ByteSize() == 1_C_SIZE_T)
  ASSERT(Copy%FieldCount() == 1_C_SIZE_T)
  ASSERT(Original%ByteSize() == 2_C_SIZE_T)
  ASSERT(Original%FieldCount() == 2_C_SIZE_T)
  call Copy%Free()
  ASSERT(.not.Copy%Initialized())
  ASSERT(Original%Initialized())

  !Leaving the block finalizes the owning format and only unbinds the alias.
  block
    type(MCICompiledFormat) :: Scoped, Alias

    call Scoped%New("16", 16_C_SIZE_T)
    ASSERT_X(Scoped%Initialized())
    Alias = Scoped
    ASSERT_X(Alias%Initialized())
  end block

  ASSERT(Original%Initialized())
  call Original%Free()
  ASSERT(.not.Original%Initialized())

  contains

    subroutine CheckFieldId(CompiledFormat, SemanticId, Expected)
      type(MCICompiledFormat), intent(in) :: CompiledFormat
      character(*),            intent(in) :: SemanticId
      integer(C_SIZE_T),       intent(in) :: Expected

      ASSERT_X(CompiledFormat%FieldId(SemanticId) == Expected)
    end subroutine CheckFieldId
#endif
END_TEST_E


TEST_E(MCIFortranEncodeMSB_FIRST)
#ifdef TSD_FORTRAN_IMPL
  use MessageCodingInterface, only: MCICompiledFormat, MSB_FIRST, &
                                    EncodingLayout, C_SIZE_T, C_UINT8_T

  implicit none
  TSD_TEST_E_INTERFACES

  !Byte vectors mirror the C-side functional encoding cases. Each tuple is a
  !format, the maximum field width, the field values and the expected bytes.
  call ExpectEncoded("1", 1_C_SIZE_T, MSB_FIRST, [1_C_SIZE_T], [128])
  call ExpectEncoded("01", 1_C_SIZE_T, MSB_FIRST, [1_C_SIZE_T], [128])
  call ExpectEncoded("4|4", 4_C_SIZE_T, MSB_FIRST, [10_C_SIZE_T, 5_C_SIZE_T], &
                     [165])
  call ExpectEncoded("3|5", 5_C_SIZE_T, MSB_FIRST, [5_C_SIZE_T, 13_C_SIZE_T], &
                     [173])
  call ExpectEncoded("16", 16_C_SIZE_T, MSB_FIRST, [4660_C_SIZE_T], [18, 52])
  call ExpectEncoded("12|4", 12_C_SIZE_T, MSB_FIRST, &
                     [2748_C_SIZE_T, 13_C_SIZE_T], [171, 205])
  call ExpectEncoded("008|004", 8_C_SIZE_T, MSB_FIRST, &
                     [171_C_SIZE_T, 12_C_SIZE_T], [171, 192])
  call ExpectEncoded("8|2R(2|3)", 8_C_SIZE_T, MSB_FIRST, &
                     [171_C_SIZE_T, 1_C_SIZE_T, 2_C_SIZE_T, 3_C_SIZE_T, &
                     4_C_SIZE_T], [171, 87, 0])
  call ExpectEncoded("24", 24_C_SIZE_T, MSB_FIRST, [1193046_C_SIZE_T], &
                     [18, 52, 86])
  call ExpectEncoded("12|12", 12_C_SIZE_T, MSB_FIRST, &
                     [2748_C_SIZE_T, 3567_C_SIZE_T], [171, 205, 239])

  contains

    subroutine ExpectEncoded(Format, MaxFieldBitSize, Encoding, Values, &
                             Expected)
      character(*),            intent(in) :: Format
      integer(C_SIZE_T),       intent(in) :: MaxFieldBitSize
      integer(EncodingLayout), intent(in) :: Encoding
      integer(C_SIZE_T),       intent(in) :: Values(:)
      integer,                 intent(in) :: Expected(:)

      type(MCICompiledFormat)          :: CompiledFormat
      unsigned(C_UINT8_T), allocatable :: Message(:)
      integer(C_SIZE_T)                :: FieldId
      integer                          :: i

      call CompiledFormat%New(Format, MaxFieldBitSize)
      ASSERT_X(CompiledFormat%Initialized())
      ASSERT(CompiledFormat%ByteSize() == int(size(Expected), C_SIZE_T))

      allocate(Message(CompiledFormat%ByteSize()))
      Message = uint(0, C_UINT8_T)

      do i = 1, size(Values)
        FieldId = int(i - 1, C_SIZE_T)
        ASSERT(CompiledFormat%Encode(Message, FieldId, Encoding, Values(i)))
      enddo

      do i = 1, size(Expected)
        ASSERT(int(Message(i)) == Expected(i))
      enddo

      call CompiledFormat%Free()
      ASSERT(.not.CompiledFormat%Initialized())
    end subroutine ExpectEncoded
#endif
END_TEST_E

TEST_E(MCIFortranEncodeLSB_FIRST)
#ifdef TSD_FORTRAN_IMPL
  use MessageCodingInterface, only: MCICompiledFormat, LSB_FIRST, &
                                    EncodingLayout, C_SIZE_T, C_UINT8_T

  implicit none
