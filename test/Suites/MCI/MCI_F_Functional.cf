      call CompiledFormat%New(Format, MaxFieldBitSize)
      ASSERT_X(CompiledFormat%Initialized())
      ASSERT(CompiledFormat%ByteSize() == int(size(Expected), C_SIZE_T))

      allocate(Message(CompiledFormat%ByteSize()))
      Message = uint(0, C_UINT8_T)

      do i = 1, size(Values)
        FieldId = int(i - 1, C_SIZE_T)
        ASSERT(CompiledFormat%Encode(Message, FieldId, Encoding, Values(i)))
      enddo

      do i = 1, size(Expected)
        ASSERT(int(Message(i)) == Expected(i))
      enddo

      call CompiledFormat%Free()
      ASSERT(.not.CompiledFormat%Initialized())
    end subroutine ExpectEncoded
#endif
END_TEST_E


TEST_E(MCIFortranEncodePreservesBits)
#ifdef TSD_FORTRAN_IMPL
  use MessageCodingInterface, only: MCICompiledFormat, MSB_FIRST, LSB_FIRST, &
                                    C_SIZE_T, C_UINT8_T

  implicit none
  TSD_TEST_E_INTERFACES

  type(MCICompiledFormat) :: CompiledFormat
  unsigned(C_UINT8_T)     :: Message(3)

  call CompiledFormat%New("3", 3_C_SIZE_T)
  ASSERT_X(CompiledFormat%Initialized())

  !Only the three field bits are written; the unused padding bits are kept.
  Message(1) = uint(255, C_UINT8_T)
  ASSERT(CompiledFormat%Encode(Message(1:1), 0_C_SIZE_T, MSB_FIRST, 0_C_SIZE_T))
  ASSERT(int(Message(1)) == 31)

  Message(1) = uint(255, C_UINT8_T)
  ASSERT(CompiledFormat%Encode(Message(1:1), 0_C_SIZE_T, LSB_FIRST, 0_C_SIZE_T))
  ASSERT(int(Message(1)) == 248)

  Message(1) = uint(0, C_UINT8_T)
  ASSERT(CompiledFormat%Encode(Message(1:1), 0_C_SIZE_T, MSB_FIRST, 7_C_SIZE_T))
  ASSERT(int(Message(1)) == 224)

  Message(1) = uint(0, C_UINT8_T)
  ASSERT(CompiledFormat%Encode(Message(1:1), 0_C_SIZE_T, LSB_FIRST, 7_C_SIZE_T))
  ASSERT(int(Message(1)) == 7)

  call CompiledFormat%Free()
  ASSERT(.not.CompiledFormat%Initialized())

  !Encoding one field leaves neighbouring fields and trailing bytes untouched.
  call CompiledFormat%New("8|8", 8_C_SIZE_T)
  ASSERT_X(CompiledFormat%Initialized())

  Message = [uint(170, C_UINT8_T), uint(187, C_UINT8_T), &
    uint(204, C_UINT8_T)]
  ASSERT(CompiledFormat%Encode(Message, 0_C_SIZE_T, MSB_FIRST, 18_C_SIZE_T))
  ASSERT(int(Message(1)) == 18)
  ASSERT(int(Message(2)) == 187)
  ASSERT(int(Message(3)) == 204)

  ASSERT(CompiledFormat%Encode(Message, 1_C_SIZE_T, MSB_FIRST, 52_C_SIZE_T))
  ASSERT(int(Message(1)) == 18)
  ASSERT(int(Message(2)) == 52)
  ASSERT(int(Message(3)) == 204)

  call CompiledFormat%Free()
  ASSERT(.not.CompiledFormat%Initialized())
#endif
END_TEST_E

TEST_E(MCIFortranDecodeMSB_FIRST)
#ifdef TSD_FORTRAN_IMPL
  use MessageCodingInterface, only: MCICompiledFormat, MSB_FIRST, &
                                    EncodingLayout, C_SIZE_T, C_UINT8_T

  implicit none
  TSD_TEST_E_INTERFACES

  call ExpectDecoded("1", 1_C_SIZE_T, MSB_FIRST, [128], [1_C_SIZE_T])
  call ExpectDecoded("01", 1_C_SIZE_T, MSB_FIRST, [128], [1_C_SIZE_T])
  call ExpectDecoded("4|4", 4_C_SIZE_T, MSB_FIRST, [165], &
                     [10_C_SIZE_T, 5_C_SIZE_T])
  call ExpectDecoded("3|5", 5_C_SIZE_T, MSB_FIRST, [173], &
                     [5_C_SIZE_T, 13_C_SIZE_T])
  call ExpectDecoded("16", 16_C_SIZE_T, MSB_FIRST, [18, 52], &
                     [4660_C_SIZE_T])
  call ExpectDecoded("12|4", 12_C_SIZE_T, MSB_FIRST, [171, 205], &
                     [2748_C_SIZE_T, 13_C_SIZE_T])
  call ExpectDecoded("008|004", 8_C_SIZE_T, MSB_FIRST, [171, 192], &
                     [171_C_SIZE_T, 12_C_SIZE_T])
  call ExpectDecoded("8|2R(2|3)", 8_C_SIZE_T, MSB_FIRST, [171, 87, 0], &
                     [171_C_SIZE_T, 1_C_SIZE_T, 2_C_SIZE_T, 3_C_SIZE_T, &
                     4_C_SIZE_T])
  call ExpectDecoded("24", 24_C_SIZE_T, MSB_FIRST, [18, 52, 86], &
                     [1193046_C_SIZE_T])
  call ExpectDecoded("12|12", 12_C_SIZE_T, MSB_FIRST, [171, 205, 239], &
                     [2748_C_SIZE_T, 3567_C_SIZE_T])

  contains

    subroutine ExpectDecoded(Format, MaxFieldBitSize, Encoding, Bytes, Values)
      character(*),            intent(in) :: Format
      integer(C_SIZE_T),       intent(in) :: MaxFieldBitSize
      integer(EncodingLayout), intent(in) :: Encoding
      integer,                 intent(in) :: Bytes(:)
      integer(C_SIZE_T),       intent(in) :: Values(:)

      type(MCICompiledFormat)          :: CompiledFormat
      unsigned(C_UINT8_T), allocatable :: Message(:)
      integer(C_SIZE_T)                :: FieldId, Value
      integer                          :: i

      call CompiledFormat%New(Format, MaxFieldBitSize)
      ASSERT_X(CompiledFormat%Initialized())
      ASSERT(CompiledFormat%ByteSize() == int(size(Bytes), C_SIZE_T))

      allocate(Message(CompiledFormat%ByteSize()))
      do i = 1, size(Bytes)
        Message(i) = uint(Bytes(i), C_UINT8_T)
      enddo

      do i = 1, size(Values)
        FieldId = int(i - 1, C_SIZE_T)
        Value   = 0_C_SIZE_T
        ASSERT(CompiledFormat%Decode(Message, FieldId, Encoding, Value))
        ASSERT(Value == Values(i))
      enddo

      call CompiledFormat%Free()
      ASSERT(.not.CompiledFormat%Initialized())
    end subroutine ExpectDecoded
#endif
END_TEST_E


