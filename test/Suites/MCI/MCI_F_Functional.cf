      ASSERT(CompiledFormat%ByteSize() == int(size(Bytes), C_SIZE_T))

      allocate(Message(CompiledFormat%ByteSize()))
      do i = 1, size(Bytes)
        Message(i) = uint(Bytes(i), C_UINT8_T)
      enddo

      do i = 1, size(Values)
        FieldId = int(i - 1, C_SIZE_T)
        Value   = 0_C_SIZE_T
        ASSERT(CompiledFormat%Decode(Message, FieldId, Encoding, Value))
        ASSERT(Value == Values(i))
      enddo

      call CompiledFormat%Free()
      ASSERT(.not.CompiledFormat%Initialized())
    end subroutine ExpectDecoded
#endif
END_TEST_E


TEST_E(MCIFortranDecodeHandlesPaddingAndExtraBytes)
#ifdef TSD_FORTRAN_IMPL
  use MessageCodingInterface, only: MCICompiledFormat, MSB_FIRST, LSB_FIRST, &
                                    C_SIZE_T, C_UINT8_T

  implicit none
  TSD_TEST_E_INTERFACES

  type(MCICompiledFormat) :: CompiledFormat
  unsigned(C_UINT8_T)     :: Message(2)
  integer(C_SIZE_T)       :: Value

  !Padding bits outside the field are ignored.
  call CompiledFormat%New("3", 3_C_SIZE_T)
  ASSERT_X(CompiledFormat%Initialized())

  Message(1) = uint(255, C_UINT8_T)
  Value      = 0_C_SIZE_T
  ASSERT(CompiledFormat%Decode(Message(1:1), 0_C_SIZE_T, MSB_FIRST, Value))
  ASSERT(Value == 7_C_SIZE_T)

  Value = 0_C_SIZE_T
  ASSERT(CompiledFormat%Decode(Message(1:1), 0_C_SIZE_T, LSB_FIRST, Value))
  ASSERT(Value == 7_C_SIZE_T)

  Message(1) = uint(7, C_UINT8_T)
  Value      = 0_C_SIZE_T
  ASSERT(CompiledFormat%Decode(Message(1:1), 0_C_SIZE_T, MSB_FIRST, Value))
  ASSERT(Value == 0_C_SIZE_T)

  Value = 0_C_SIZE_T
  ASSERT(CompiledFormat%Decode(Message(1:1), 0_C_SIZE_T, LSB_FIRST, Value))
  ASSERT(Value == 7_C_SIZE_T)

  call CompiledFormat%Free()
  ASSERT(.not.CompiledFormat%Initialized())

  !A buffer larger than the compiled message is accepted; trailing bytes are
  !ignored and decoding does not modify the message.
  call CompiledFormat%New("8", 8_C_SIZE_T)
  ASSERT_X(CompiledFormat%Initialized())

  Message = [uint(18, C_UINT8_T), uint(52, C_UINT8_T)]

  Value = 0_C_SIZE_T
  ASSERT(CompiledFormat%Decode(Message, 0_C_SIZE_T, MSB_FIRST, Value))
  ASSERT(Value == 18_C_SIZE_T)
  ASSERT(int(Message(1)) == 18)
  ASSERT(int(Message(2)) == 52)

  Value = 0_C_SIZE_T
  ASSERT(CompiledFormat%Decode(Message, 0_C_SIZE_T, LSB_FIRST, Value))
  ASSERT(Value == 18_C_SIZE_T)
  ASSERT(int(Message(1)) == 18)
  ASSERT(int(Message(2)) == 52)

  call CompiledFormat%Free()
  ASSERT(.not.CompiledFormat%Initialized())
#endif
END_TEST_E

TEST_E(MCIFortranRejectsInvalidInputs)
#ifdef TSD_FORTRAN_IMPL
  use MessageCodingInterface, only: MCICompiledFormat, MSB_FIRST, &
                                    EncodingLayout, C_SIZE_T, C_UINT8_T

  implicit none
  TSD_TEST_E_INTERFACES

  type(MCICompiledFormat) :: CompiledFormat, Empty
  unsigned(C_UINT8_T)     :: Message(2)
  integer(C_SIZE_T)       :: Value, InvalidFieldId
  integer(EncodingLayout) :: BadEncoding
  logical                 :: Success

  InvalidFieldId = not(0_C_SIZE_T)
  Message        = [uint(170, C_UINT8_T), uint(187, C_UINT8_T)]

  !Codec calls through a default-initialized format fail cleanly.
  ASSERT(.not.Empty%Initialized())
  ASSERT(.not.Empty%Encode(Message, 0_C_SIZE_T, MSB_FIRST, 0_C_SIZE_T))
  Value = 42_C_SIZE_T
  ASSERT(.not.Empty%Decode(Message, 0_C_SIZE_T, MSB_FIRST, Value))
  ASSERT(Value == 42_C_SIZE_T)
  call CheckFieldId(Empty, "1", InvalidFieldId)

  call CompiledFormat%New("4", 4_C_SIZE_T)
  ASSERT_X(CompiledFormat%Initialized())

  !Malformed and missing semantic identifiers resolve to SIZE_MAX.
  call CheckFieldId(CompiledFormat, "", InvalidFieldId)
  call CheckFieldId(CompiledFormat, "0", InvalidFieldId)
  call CheckFieldId(CompiledFormat, "01", InvalidFieldId)
  call CheckFieldId(CompiledFormat, "1.", InvalidFieldId)
  call CheckFieldId(CompiledFormat, ".1", InvalidFieldId)
  call CheckFieldId(CompiledFormat, "1..2", InvalidFieldId)
  call CheckFieldId(CompiledFormat, "1.0", InvalidFieldId)
  call CheckFieldId(CompiledFormat, "1x", InvalidFieldId)
  call CheckFieldId(CompiledFormat, " 1", InvalidFieldId)
  call CheckFieldId(CompiledFormat, "2", InvalidFieldId)

  !An out-of-range field leaves the message untouched.
  ASSERT(.not.CompiledFormat%Encode(Message, 1_C_SIZE_T, MSB_FIRST, 0_C_SIZE_T))
  ASSERT(int(Message(1)) == 170)
  ASSERT(int(Message(2)) == 187)

  Value = 42_C_SIZE_T
  ASSERT(.not.CompiledFormat%Decode(Message, 1_C_SIZE_T, MSB_FIRST, Value))
  ASSERT(Value == 42_C_SIZE_T)

  !Invalid layout values are rejected for both directions.
  BadEncoding = 0
  Success     = .not.CompiledFormat%Encode(Message, 0_C_SIZE_T, BadEncoding, &
                                           0_C_SIZE_T)
  ASSERT(Success)
  BadEncoding = 3
  Success     = .not.CompiledFormat%Encode(Message, 0_C_SIZE_T, BadEncoding, &
                                           0_C_SIZE_T)
  ASSERT(Success)
  ASSERT(int(Message(1)) == 170)
  ASSERT(int(Message(2)) == 187)

  Value       = 42_C_SIZE_T
  BadEncoding = 0
  ASSERT(.not.CompiledFormat%Decode(Message, 0_C_SIZE_T, BadEncoding, Value))
  ASSERT(Value == 42_C_SIZE_T)
  BadEncoding = 3
  ASSERT(.not.CompiledFormat%Decode(Message, 0_C_SIZE_T, BadEncoding, Value))
  ASSERT(Value == 42_C_SIZE_T)

  !A value that does not fit the four-bit field is rejected before any bit is
  !written.
  Success = .not.CompiledFormat%Encode(Message, 0_C_SIZE_T, MSB_FIRST, &
                                       16_C_SIZE_T)
  ASSERT(Success)
  ASSERT(int(Message(1)) == 170)
  ASSERT(int(Message(2)) == 187)

  call CompiledFormat%Free()
  ASSERT(.not.CompiledFormat%Initialized())

  !The Fortran array shape supplies MessageByteSize, so a short buffer is
  !reported as a failure without reading or writing beyond it.
  call CompiledFormat%New("8|8", 8_C_SIZE_T)
  ASSERT_X(CompiledFormat%Initialized())

  Message(1) = uint(170, C_UINT8_T)
  Success    = .not.CompiledFormat%Encode(Message(1:1), 0_C_SIZE_T, MSB_FIRST, &
                                          18_C_SIZE_T)
  ASSERT(Success)
  ASSERT(int(Message(1)) == 170)

  Value = 42_C_SIZE_T
  ASSERT(.not.CompiledFormat%Decode(Message(1:1), 0_C_SIZE_T, MSB_FIRST, Value))
  ASSERT(Value == 42_C_SIZE_T)

  call CompiledFormat%Free()
  ASSERT(.not.CompiledFormat%Initialized())

  contains

    subroutine CheckFieldId(CompiledFormat, SemanticId, Expected)
      type(MCICompiledFormat), intent(in) :: CompiledFormat
      character(*),            intent(in) :: SemanticId
      integer(C_SIZE_T),       intent(in) :: Expected

      ASSERT_X(CompiledFormat%FieldId(SemanticId) == Expected)
    end subroutine CheckFieldId
#endif
END_TEST_E

TEST_E(MCIFortranRoundTrip)
#ifdef TSD_FORTRAN_IMPL
  use MessageCodingInterface, only: MCICompiledFormat, MSB_FIRST, LSB_FIRST, &
                                    EncodingLayout, C_SIZE_T, C_UINT8_T

  implicit none
  TSD_TEST_E_INTERFACES

  integer(EncodingLayout) :: Layouts(2)
  integer                 :: i

  Layouts = [MSB_FIRST, LSB_FIRST]

  do i = 1, size(Layouts)
    call ExpectRoundTrip("1|1|1|1|1|1|1|1", 1_C_SIZE_T, Layouts(i), &
                         [0_C_SIZE_T, 1_C_SIZE_T, 0_C_SIZE_T, 1_C_SIZE_T, &
                         0_C_SIZE_T, 1_C_SIZE_T, 0_C_SIZE_T, 1_C_SIZE_T])
    call ExpectRoundTrip("4|4", 4_C_SIZE_T, Layouts(i), &
                         [10_C_SIZE_T, 5_C_SIZE_T])
    call ExpectRoundTrip("3|5", 5_C_SIZE_T, Layouts(i), &
                         [0_C_SIZE_T, 0_C_SIZE_T])
    call ExpectRoundTrip("3|5", 5_C_SIZE_T, Layouts(i), &
                         [7_C_SIZE_T, 31_C_SIZE_T])
    call ExpectRoundTrip("3|5", 5_C_SIZE_T, Layouts(i), &
                         [5_C_SIZE_T, 13_C_SIZE_T])
    call ExpectRoundTrip("16", 16_C_SIZE_T, Layouts(i), [0_C_SIZE_T])
    call ExpectRoundTrip("16", 16_C_SIZE_T, Layouts(i), [1_C_SIZE_T])
    call ExpectRoundTrip("16", 16_C_SIZE_T, Layouts(i), [65535_C_SIZE_T])
    call ExpectRoundTrip("16", 16_C_SIZE_T, Layouts(i), [4660_C_SIZE_T])
    call ExpectRoundTrip("8|2R(2|3)", 8_C_SIZE_T, Layouts(i), &
                         [171_C_SIZE_T, 1_C_SIZE_T, 2_C_SIZE_T, 3_C_SIZE_T, &
                         4_C_SIZE_T])
    call ExpectRoundTrip("008|004", 8_C_SIZE_T, Layouts(i), &
                         [171_C_SIZE_T, 12_C_SIZE_T])
    call ExpectRoundTrip("24", 24_C_SIZE_T, Layouts(i), [1193046_C_SIZE_T])
    call ExpectRoundTrip("12|12", 12_C_SIZE_T, Layouts(i), &
                         [2748_C_SIZE_T, 3567_C_SIZE_T])
  enddo

  contains

    subroutine ExpectRoundTrip(Format, MaxFieldBitSize, Encoding, Values)
      character(*),            intent(in) :: Format
      integer(C_SIZE_T),       intent(in) :: MaxFieldBitSize
      integer(EncodingLayout), intent(in) :: Encoding
      integer(C_SIZE_T),       intent(in) :: Values(:)

      type(MCICompiledFormat)          :: CompiledFormat
      unsigned(C_UINT8_T), allocatable :: Message(:)
      integer(C_SIZE_T)                :: FieldId, Value
      integer                          :: i

      call CompiledFormat%New(Format, MaxFieldBitSize)
      ASSERT_X(CompiledFormat%Initialized())
      ASSERT(CompiledFormat%ByteSize() > 0_C_SIZE_T)

      allocate(Message(CompiledFormat%ByteSize()))
      Message = uint(0, C_UINT8_T)

      do i = 1, size(Values)
        FieldId = int(i - 1, C_SIZE_T)
        ASSERT(CompiledFormat%Encode(Message, FieldId, Encoding, Values(i)))
      enddo

      do i = 1, size(Values)
        FieldId = int(i - 1, C_SIZE_T)
        Value   = 0_C_SIZE_T
        ASSERT(CompiledFormat%Decode(Message, FieldId, Encoding, Value))
        ASSERT(Value == Values(i))
      enddo

      call CompiledFormat%Free()
      ASSERT(.not.CompiledFormat%Initialized())
    end subroutine ExpectRoundTrip
#endif
END_TEST_E

