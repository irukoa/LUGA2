  call ExpectEncoded("1", 1_C_SIZE_T, LSB_FIRST, [1_C_SIZE_T], [1])
  call ExpectEncoded("01", 1_C_SIZE_T, LSB_FIRST, [1_C_SIZE_T], [1])
  call ExpectEncoded("4|4", 4_C_SIZE_T, LSB_FIRST, [10_C_SIZE_T, 5_C_SIZE_T], &
                     [90])
  call ExpectEncoded("3|5", 5_C_SIZE_T, LSB_FIRST, [5_C_SIZE_T, 13_C_SIZE_T], &
                     [109])
  call ExpectEncoded("16", 16_C_SIZE_T, LSB_FIRST, [4660_C_SIZE_T], [52, 18])
  call ExpectEncoded("12|4", 12_C_SIZE_T, LSB_FIRST, &
                     [2748_C_SIZE_T, 13_C_SIZE_T], [188, 218])
  call ExpectEncoded("008|004", 8_C_SIZE_T, LSB_FIRST, &
                     [171_C_SIZE_T, 12_C_SIZE_T], [171, 12])
  call ExpectEncoded("8|2R(2|3)", 8_C_SIZE_T, LSB_FIRST, &
                     [171_C_SIZE_T, 1_C_SIZE_T, 2_C_SIZE_T, 3_C_SIZE_T, &
                     4_C_SIZE_T], [171, 105, 2])
  call ExpectEncoded("24", 24_C_SIZE_T, LSB_FIRST, [1193046_C_SIZE_T], &
                     [86, 52, 18])
  call ExpectEncoded("12|12", 12_C_SIZE_T, LSB_FIRST, &
                     [2748_C_SIZE_T, 3567_C_SIZE_T], [188, 250, 222])

  contains

    subroutine ExpectEncoded(Format, MaxFieldBitSize, Encoding, Values, &
