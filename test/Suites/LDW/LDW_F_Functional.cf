TEST_E(LDWFortranDegenFastReturn)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_SIZE_T, DegeneracyGroup

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: E(1)
  integer(C_SIZE_T) :: D(1)

  E = 0.0_C_DOUBLE
  D = 99_C_SIZE_T

  !Dimension zero is a fast return: the result is left untouched.
  call DegeneracyGroup(0_C_SIZE_T, E, 0.1_C_DOUBLE, D)

  ASSERT(D(1) == 99_C_SIZE_T)

#endif
END_TEST_E

TEST_E(LDWFortranDegenSingle)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_SIZE_T, DegeneracyGroup

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: E(1)
  integer(C_SIZE_T) :: D(1)

  E = 7.0_C_DOUBLE
  D = 99_C_SIZE_T

  !A single level is always a group of one.
  call DegeneracyGroup(1_C_SIZE_T, E, 0.1_C_DOUBLE, D)

  ASSERT(D(1) == 1_C_SIZE_T)

#endif
END_TEST_E

TEST_E(LDWFortranDegenThresholdBoundary)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_SIZE_T, DegeneracyGroup

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: E(3)
  integer(C_SIZE_T) :: D(3)

  !Consecutive levels whose difference equals the threshold belong to the
  !same group (the comparison is <=). The values are exact binary fractions.
  E = real([0.0, 0.25, 0.5], C_DOUBLE)
  D = 99_C_SIZE_T

  call DegeneracyGroup(3_C_SIZE_T, E, 0.25_C_DOUBLE, D)

  ASSERT(all(D == int([3, 0, 0], C_SIZE_T)))

#endif
END_TEST_E

TEST_E(LDWFortranDegenNegativeThr)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_SIZE_T, DegeneracyGroup

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: E(1)
  integer(C_SIZE_T) :: D(1)

  E = 0.0_C_DOUBLE
  D = 99_C_SIZE_T

  !A negative threshold is a no-op.
  call DegeneracyGroup(1_C_SIZE_T, E, -0.1_C_DOUBLE, D)

  ASSERT(D(1) == 99_C_SIZE_T)

#endif
END_TEST_E

TEST_E(LDWFortranDegenZeroThr)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_SIZE_T, DegeneracyGroup

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: E(3)
  integer(C_SIZE_T) :: D(3)

  E = real([0.0, 1.0, 2.0], C_DOUBLE)
  D = 99_C_SIZE_T

  !A zero threshold is a no-op as well.
  call DegeneracyGroup(3_C_SIZE_T, E, 0.0_C_DOUBLE, D)

  ASSERT(all(D == 99_C_SIZE_T))

#endif
END_TEST_E

TEST_E(LDWFortranDegenTransitive)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_SIZE_T, DegeneracyGroup

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: E(3)
  integer(C_SIZE_T) :: D(3)

  !Degeneracy propagates transitively: each consecutive gap is below the
  !threshold even though the first and last levels are farther apart than it.
  E = real([0.0, 0.375, 0.75], C_DOUBLE)
  D = 99_C_SIZE_T

  call DegeneracyGroup(3_C_SIZE_T, E, 0.5_C_DOUBLE, D)

  ASSERT(all(D == int([3, 0, 0], C_SIZE_T)))

#endif
END_TEST_E

TEST_E(LDWFortranDegenMultipleGroups)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_SIZE_T, DegeneracyGroup

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: E(5)
  integer(C_SIZE_T) :: D(5)

  E = real([0.0, 0.25, 0.5, 1.0, 1.25], C_DOUBLE)
  D = 99_C_SIZE_T

  call DegeneracyGroup(5_C_SIZE_T, E, 0.25_C_DOUBLE, D)

  ASSERT(all(D == int([3, 0, 0, 2, 0], C_SIZE_T)))

#endif
END_TEST_E

TEST_E(LDWFortranDegenAllEqual)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_SIZE_T, DegeneracyGroup

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: E(4)
  integer(C_SIZE_T) :: D(4)

  E = 2.0_C_DOUBLE
  D = 99_C_SIZE_T

  call DegeneracyGroup(4_C_SIZE_T, E, 0.1_C_DOUBLE, D)

  ASSERT(all(D == int([4, 0, 0, 0], C_SIZE_T)))

#endif
END_TEST_E

TEST_E(LDWFortranDegenAllDistinct)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_SIZE_T, DegeneracyGroup

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: E(4)
  integer(C_SIZE_T) :: D(4)

  E = real([0.0, 1.0, 2.0, 3.0], C_DOUBLE)
  D = 99_C_SIZE_T

  call DegeneracyGroup(4_C_SIZE_T, E, 0.5_C_DOUBLE, D)

  ASSERT(all(D == int([1, 1, 1, 1], C_SIZE_T)))

#endif
END_TEST_E

