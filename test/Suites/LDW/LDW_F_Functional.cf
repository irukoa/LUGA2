#include "test/TSD/TSD_Fortran.h"
#ifdef TSD_FORTRAN_IMPL
#include "src/LDW/LapackDeferredWrappers.M90"

!< Deterministic ZHEEVD stand-in and numerical helpers for the LDW
!< functional tests.
!<
!< The stub reports a workspace query of N elements per workspace buffer
!< and records how many times the query and the computational call were
!< made. This keeps the fast-return and failure-propagation tests
!< independent of a real LAPACK build.
module LDWFortranFunctionalSupport

  use, intrinsic :: ISO_FORTRAN_ENV, only: INT64, LOGICAL32
  use LapackDeferredWrappers, only: INT32, REAL64

  implicit none
  private

  !Status reported by the failing workspace query.
  integer(INT32), parameter, public :: LDWStubFailingQuery = 9_INT32

  integer(INT32) :: QueryStatus   = 0_INT32
  integer(INT32) :: ComputeStatus = 0_INT32
  integer(INT32) :: QueryCalls    = 0_INT32
  integer(INT32) :: ComputeCalls  = 0_INT32

  !ZGEES stub state. It is tracked separately so that the DiagHermitian and
  !SchurDecomposition tests never interfere.
  integer(INT32) :: ZGEESQueryStatus   = 0_INT32
  integer(INT32) :: ZGEESComputeStatus = 0_INT32
  integer(INT32) :: ZGEESQueryCalls    = 0_INT32
  integer(INT32) :: ZGEESComputeCalls  = 0_INT32

  !ZGESDD stub state. It is tracked separately so that the other drivers
  !never interfere.
  integer(INT32) :: ZGESDDQueryStatus   = 0_INT32
  integer(INT32) :: ZGESDDComputeStatus = 0_INT32
  integer(INT32) :: ZGESDDQueryCalls    = 0_INT32
  integer(INT32) :: ZGESDDComputeCalls  = 0_INT32

  !ZGGES stub state. It is tracked separately so that the other drivers
  !never interfere.
  integer(INT32) :: ZGGESQueryStatus   = 0_INT32
  integer(INT32) :: ZGGESComputeStatus = 0_INT32
  integer(INT32) :: ZGGESQueryCalls    = 0_INT32
  integer(INT32) :: ZGGESComputeCalls  = 0_INT32

  public :: ResetZHEEVDStub
  public :: SetZHEEVDStubStatus
  public :: GetZHEEVDStubCalls
  public :: ZHEEVDStub
  public :: ResetZGEESStub
  public :: SetZGEESStubStatus
  public :: GetZGEESStubCalls
  public :: ZGEESStub
  public :: ResetZGESDDStub
  public :: SetZGESDDStubStatus
  public :: GetZGESDDStubCalls
  public :: ZGESDDStub
  public :: ResetZGGESStub
  public :: SetZGGESStubStatus
  public :: GetZGGESStubCalls
  public :: ZGGESStub
  public :: FourierUnitary
  public :: SpectralHermitian
  public :: EigenvectorOverlap
  public :: OrthonormalityError
  public :: ResidualError
  public :: SVResidualError
  public :: UpperTriangularError
  public :: DiagonalError
  public :: StrictUpperNorm
  public :: SchurResidualError
  public :: SpectrumError
  public :: GeneralizedSpectrumError
  public :: GeneralizedSchurForms
  public :: PairError
  public :: GeneralizedReconstructionError
  public :: RandomPair

contains

  !< Restores the nominal stub behaviour and clears the call counters.
  subroutine ResetZHEEVDStub()
    QueryStatus   = 0_INT32
    ComputeStatus = 0_INT32
    QueryCalls    = 0_INT32
    ComputeCalls  = 0_INT32
  end subroutine ResetZHEEVDStub

  !< Selects the statuses returned by the workspace query and by the
  !< computational call.
  subroutine SetZHEEVDStubStatus(NewQueryStatus, NewComputeStatus)
    integer(INT32), intent(in) :: NewQueryStatus
    integer(INT32), intent(in) :: NewComputeStatus

    QueryStatus   = NewQueryStatus
    ComputeStatus = NewComputeStatus
  end subroutine SetZHEEVDStubStatus

  !< Returns how many workspace queries and computational calls were made.
  subroutine GetZHEEVDStubCalls(Queries, Computations)
    integer(INT32), intent(out) :: Queries
    integer(INT32), intent(out) :: Computations

    Queries      = QueryCalls
    Computations = ComputeCalls
  end subroutine GetZHEEVDStubCalls

  !< Minimal ZHEEVD stand-in. The query reports N workspace elements; the
  !< computational call overwrites the matrix and the eigenvalue buffers.
  subroutine ZHEEVDStub(JOBZ, UPLO, &
                        N, A, LDA, &
                        W, &
                        WORK, LWORK, RWORK, LRWORK, IWORK, LIWORK, &
                        INFO)
    character,       intent(in)    :: JOBZ
    character,       intent(in)    :: UPLO
    integer(INT32),  intent(in)    :: N
    integer(INT32),  intent(in)    :: LDA
    complex(REAL64), intent(inout) :: A(LDA, N)
    real(REAL64),    intent(out)   :: W(N)
    integer(INT32),  intent(in)    :: LWORK
    complex(REAL64), intent(out)   :: WORK(max(1, LWORK))
    integer(INT32),  intent(in)    :: LRWORK
    real(REAL64),    intent(out)   :: RWORK(max(1, LRWORK))
    integer(INT32),  intent(in)    :: LIWORK
    integer(INT32),  intent(out)   :: IWORK(max(1, LIWORK))
    integer(INT32),  intent(out)   :: INFO

    logical        :: IsQuery
    integer(INT32) :: i

    IsQuery = LWORK < 0_INT32 .or. LRWORK < 0_INT32 .or. LIWORK < 0_INT32

    if (IsQuery) then
      QueryCalls = QueryCalls + 1_INT32
      !A single element is enough for the workspace validation.
      WORK(1)  = cmplx(real(N, REAL64), 0.0_REAL64, REAL64)
      RWORK(1) = real(N, REAL64)
      IWORK(1) = N
      INFO     = QueryStatus
    else
      ComputeCalls = ComputeCalls + 1_INT32
      !Reference JOBZ, UPLO and LDA so that no dummy argument is unused and
      !make every written output buffer distinguishable.
      do i = 1, N
        W(i) = real(len(JOBZ) + len(UPLO) + LDA + i, REAL64)
      enddo
      A    = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
      INFO = ComputeStatus
    endif
  end subroutine ZHEEVDStub

  !< Restores the nominal ZGEES stub behaviour and clears the call counters.
  subroutine ResetZGEESStub()
    ZGEESQueryStatus   = 0_INT32
    ZGEESComputeStatus = 0_INT32
    ZGEESQueryCalls    = 0_INT32
    ZGEESComputeCalls  = 0_INT32
  end subroutine ResetZGEESStub

  !< Selects the statuses returned by the ZGEES workspace query and by the
  !< computational call.
  subroutine SetZGEESStubStatus(NewQueryStatus, NewComputeStatus)
    integer(INT32), intent(in) :: NewQueryStatus
    integer(INT32), intent(in) :: NewComputeStatus

    ZGEESQueryStatus   = NewQueryStatus
    ZGEESComputeStatus = NewComputeStatus
  end subroutine SetZGEESStubStatus

  !< Returns how many ZGEES workspace queries and computational calls were
  !< made.
  subroutine GetZGEESStubCalls(Queries, Computations)
    integer(INT32), intent(out) :: Queries
    integer(INT32), intent(out) :: Computations

    Queries      = ZGEESQueryCalls
    Computations = ZGEESComputeCalls
  end subroutine GetZGEESStubCalls

  !< Minimal ZGEES stand-in. The query reports N workspace elements; the
  !< computational call overwrites every output buffer. The argument checks
  !< fail the call when LDW does not use the documented JOBVS/SORT contract
  !< or when the SELECT callback accepts an eigenvalue.
  subroutine ZGEESStub(JOBVS, SORT, SELECT, &
                       N, A, LDA, &
                       SDIM, W, &
                       VS, LDVS, WORK, LWORK, RWORK, BWORK, &
                       INFO)
    character,          intent(in)    :: JOBVS
    character,          intent(in)    :: SORT
    interface
      logical(LOGICAL32) function SELECT(C)
        import REAL64, LOGICAL32
        complex(REAL64), intent(in) :: C
      end function SELECT
    end interface
    integer(INT32),     intent(in)    :: N
    integer(INT32),     intent(in)    :: LDA
    complex(REAL64),    intent(inout) :: A(LDA, N)
    integer(INT32),     intent(out)   :: SDIM
    complex(REAL64),    intent(out)   :: W(N)
    integer(INT32),     intent(in)    :: LDVS
    complex(REAL64),    intent(out)   :: VS(LDVS, N)
    integer(INT32),     intent(in)    :: LWORK
    complex(REAL64),    intent(out)   :: WORK(max(1, LWORK))
    real(REAL64),       intent(out)   :: RWORK(N)
    logical(LOGICAL32), intent(out)   :: BWORK(N)
    integer(INT32),     intent(out)   :: INFO

    integer(INT32)     :: i
    logical(LOGICAL32) :: Selected

    INFO     = 0_INT32
    SDIM     = 0_INT32
    Selected = SELECT(cmplx(0.0_REAL64, 0.0_REAL64, REAL64))

    if (JOBVS /= 'V' .or. SORT /= 'N' .or. LDA < N .or. LDVS < N .or. Selected) then
      INFO = -1_INT32
      return
    endif

    if (LWORK < 0_INT32) then
      ZGEESQueryCalls = ZGEESQueryCalls + 1_INT32
      !A single element is enough for the workspace validation.
      WORK(1)  = cmplx(real(N, REAL64), 0.0_REAL64, REAL64)
      RWORK(1) = 0.0_REAL64
      BWORK(1) = .false.
      INFO     = ZGEESQueryStatus
    else
      ZGEESComputeCalls = ZGEESComputeCalls + 1_INT32
      !Make every written output buffer distinguishable.
      A    = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
      VS   = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
      WORK = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
      W    = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
      do i = 1, N
        A(i, i) = cmplx(real(len(JOBVS) + len(SORT) + LDA + LDVS + i, REAL64), &
                        0.0_REAL64, REAL64)
      enddo
      RWORK = 0.0_REAL64
      BWORK = .false.
      INFO  = ZGEESComputeStatus
    endif

  end subroutine ZGEESStub

  !< Restores the nominal ZGGES stub behaviour and clears the call counters.
  subroutine ResetZGGESStub()
    ZGGESQueryStatus   = 0_INT32
    ZGGESComputeStatus = 0_INT32
    ZGGESQueryCalls    = 0_INT32
    ZGGESComputeCalls  = 0_INT32
  end subroutine ResetZGGESStub

  !< Selects the statuses returned by the ZGGES workspace query and by the
  !< computational call.
  subroutine SetZGGESStubStatus(NewQueryStatus, NewComputeStatus)
    integer(INT32), intent(in) :: NewQueryStatus
    integer(INT32), intent(in) :: NewComputeStatus

    ZGGESQueryStatus   = NewQueryStatus
    ZGGESComputeStatus = NewComputeStatus
  end subroutine SetZGGESStubStatus

  !< Returns how many ZGGES workspace queries and computational calls were
  !< made.
  subroutine GetZGGESStubCalls(Queries, Computations)
    integer(INT32), intent(out) :: Queries
    integer(INT32), intent(out) :: Computations

    Queries      = ZGGESQueryCalls
    Computations = ZGGESComputeCalls
  end subroutine GetZGGESStubCalls

  !< Minimal ZGGES stand-in. The query reports the LAPACK minimum of 2*N
  !< workspace elements; the computational call overwrites every output
  !< buffer. The argument checks fail the call when LDW does not use the
  !< documented JOBVSL/JOBVSR/SORT contract or when the SELCTG callback
  !< accepts a pair.
  subroutine ZGGESStub(JOBVSL, JOBVSR, SORT, SELCTG, &
                       N, A, LDA, B, LDB, &
                       SDIM, ALPHA, BETA, &
                       VSL, LDVSL, VSR, LDVSR, &
                       WORK, LWORK, RWORK, BWORK, INFO)
    character,          intent(in)    :: JOBVSL
    character,          intent(in)    :: JOBVSR
    character,          intent(in)    :: SORT
    interface
      logical(LOGICAL32) function SELCTG(ALPHA, BETA)
        import REAL64, LOGICAL32
        complex(REAL64), intent(in) :: ALPHA
        complex(REAL64), intent(in) :: BETA
      end function SELCTG
    end interface
    integer(INT32),     intent(in)    :: N
    integer(INT32),     intent(in)    :: LDA
    complex(REAL64),    intent(inout) :: A(LDA, N)
    integer(INT32),     intent(in)    :: LDB
    complex(REAL64),    intent(inout) :: B(LDB, N)
    integer(INT32),     intent(out)   :: SDIM
    complex(REAL64),    intent(out)   :: ALPHA(N)
    complex(REAL64),    intent(out)   :: BETA(N)
    integer(INT32),     intent(in)    :: LDVSL
    complex(REAL64),    intent(out)   :: VSL(LDVSL, N)
    integer(INT32),     intent(in)    :: LDVSR
    complex(REAL64),    intent(out)   :: VSR(LDVSR, N)
    integer(INT32),     intent(in)    :: LWORK
    complex(REAL64),    intent(out)   :: WORK(max(1, LWORK))
    real(REAL64),       intent(out)   :: RWORK(8 * N)
    logical(LOGICAL32), intent(out)   :: BWORK(N)
    integer(INT32),     intent(out)   :: INFO

    integer(INT32)     :: i
    logical(LOGICAL32) :: Selected

    INFO     = 0_INT32
    SDIM     = 0_INT32
    Selected = SELCTG(cmplx(0.0_REAL64, 0.0_REAL64, REAL64), &
                      cmplx(0.0_REAL64, 0.0_REAL64, REAL64))

    if (JOBVSL /= 'V' .or. JOBVSR /= 'V' .or. SORT /= 'N' .or. &
        LDA < N .or. LDB < N .or. LDVSL < N .or. LDVSR < N .or. Selected) then
      INFO = -1_INT32
      return
    endif

    if (LWORK < 0_INT32) then
      ZGGESQueryCalls = ZGGESQueryCalls + 1_INT32
      !The queried size is exactly the LAPACK minimum, max(1, 2*N).
      WORK(1)  = cmplx(real(2 * N, REAL64), 0.0_REAL64, REAL64)
      RWORK(1) = 0.0_REAL64
      BWORK(1) = .false.
      INFO     = ZGGESQueryStatus
    else
      ZGGESComputeCalls = ZGGESComputeCalls + 1_INT32
      !Make every written output buffer distinguishable.
      A     = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
      B     = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
      VSL   = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
      VSR   = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
      ALPHA = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
      BETA  = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
      do i = 1, N
        A(i, i)   = cmplx(real(len(JOBVSL) + len(JOBVSR) + LDA + LDVSL + &
                               LDVSR + i, REAL64), 0.0_REAL64, REAL64)
        B(i, i)   = cmplx(1.0_REAL64, 0.0_REAL64, REAL64)
        VSL(i, i) = cmplx(1.0_REAL64, 0.0_REAL64, REAL64)
        VSR(i, i) = cmplx(1.0_REAL64, 0.0_REAL64, REAL64)
        ALPHA(i)  = cmplx(real(i, REAL64), 0.0_REAL64, REAL64)
        BETA(i)   = cmplx(1.0_REAL64, 0.0_REAL64, REAL64)
      enddo
      WORK  = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
      RWORK = 0.0_REAL64
      BWORK = .false.
      INFO  = ZGGESComputeStatus
    endif

  end subroutine ZGGESStub

  !< Restores the nominal ZGESDD stub behaviour and clears the call counters.
  subroutine ResetZGESDDStub()
    ZGESDDQueryStatus   = 0_INT32
    ZGESDDComputeStatus = 0_INT32
    ZGESDDQueryCalls    = 0_INT32
    ZGESDDComputeCalls  = 0_INT32
  end subroutine ResetZGESDDStub

  !< Selects the statuses returned by the ZGESDD workspace query and by the
  !< computational call.
  subroutine SetZGESDDStubStatus(NewQueryStatus, NewComputeStatus)
    integer(INT32), intent(in) :: NewQueryStatus
    integer(INT32), intent(in) :: NewComputeStatus

    ZGESDDQueryStatus   = NewQueryStatus
    ZGESDDComputeStatus = NewComputeStatus
  end subroutine SetZGESDDStubStatus

  !< Returns how many ZGESDD workspace queries and computational calls were
  !< made.
  subroutine GetZGESDDStubCalls(Queries, Computations)
    integer(INT32), intent(out) :: Queries
    integer(INT32), intent(out) :: Computations

    Queries      = ZGESDDQueryCalls
    Computations = ZGESDDComputeCalls
  end subroutine GetZGESDDStubCalls

  !< Minimal ZGESDD stand-in. The query reports max(M, N) workspace elements;
  !< the computational call overwrites every output buffer. The argument
  !< checks fail the call when LDW does not request the full factor shapes.
  subroutine ZGESDDStub(JOBZ, M, N, A, LDA, S, U, LDU, VT, LDVT, &
                        WORK, LWORK, RWORK, IWORK, INFO)
    character,       intent(in)    :: JOBZ
    integer(INT32),  intent(in)    :: M
    integer(INT32),  intent(in)    :: N
    integer(INT32),  intent(in)    :: LDA
    integer(INT32),  intent(in)    :: LDU
    integer(INT32),  intent(in)    :: LDVT
    integer(INT32),  intent(in)    :: LWORK
    complex(REAL64), intent(inout) :: A(LDA, N)
    real(REAL64),    intent(out)   :: S(min(M, N))
    complex(REAL64), intent(out)   :: U(LDU, *)
    complex(REAL64), intent(out)   :: VT(LDVT, N)
    complex(REAL64), intent(out)   :: WORK(max(1, LWORK))
    real(REAL64),    intent(out)   :: RWORK(*)
    integer(INT32),  intent(out)   :: IWORK(*)
    integer(INT32),  intent(out)   :: INFO

    integer(INT32) :: i, j, MinMN

    INFO  = 0_INT32
    MinMN = min(M, N)

    if (JOBZ /= 'A' .or. LDA < M .or. LDU < M .or. LDVT < N) then
      INFO = -1_INT32
      return
    endif

    if (LWORK < 0_INT32) then
      ZGESDDQueryCalls = ZGESDDQueryCalls + 1_INT32
      !A single element is enough for the workspace validation.
      WORK(1)  = cmplx(real(max(M, N), REAL64), 0.0_REAL64, REAL64)
      RWORK(1) = 0.0_REAL64
      IWORK(1) = 0_INT32
      INFO     = ZGESDDQueryStatus
    else
      ZGESDDComputeCalls = ZGESDDComputeCalls + 1_INT32
      !Make every written output buffer distinguishable.
      A    = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
      S    = 0.0_REAL64
      VT   = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
      WORK = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)

      do j = 1, M
        do i = 1, M
          U(i, j) = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
        enddo
      enddo

      do i = 1, MinMN
        A(i, i)  = cmplx(real(len(JOBZ) + LDA + LDU + LDVT + i, REAL64), &
                         0.0_REAL64, REAL64)
        U(i, i)  = cmplx(1.0_REAL64, 0.0_REAL64, REAL64)
        VT(i, i) = cmplx(1.0_REAL64, 0.0_REAL64, REAL64)
      enddo

      RWORK(1) = 0.0_REAL64
      IWORK(1) = 0_INT32
      INFO     = ZGESDDComputeStatus
    endif

  end subroutine ZGESDDStub

  pure function OrthonormalityError(U, N) result(Error)
    integer,         intent(in) :: N
    complex(REAL64), intent(in) :: U(N, N)
    real(REAL64)                :: Error, Dot
    integer                     :: i, j, k

    Error = 0.0_REAL64
    do j = 1, N
      do i = 1, N
        Dot = 0.0_REAL64
        do k = 1, N
          Dot = Dot + real(U(k, i) * conjg(U(k, j)), REAL64)
        enddo
        if (i == j) then
          Error = max(Error, abs(Dot - 1.0_REAL64))
        else
          Error = max(Error, abs(Dot))
        endif
      enddo
    enddo
  end function OrthonormalityError

  !< Maximum deviation of U^H H U from diag(E).
  pure function ResidualError(H, U, E, N) result(Error)
    integer,         intent(in) :: N
    complex(REAL64), intent(in) :: H(N, N)
    complex(REAL64), intent(in) :: U(N, N)
    real(REAL64),    intent(in) :: E(N)
    real(REAL64)                :: Error
    complex(REAL64)             :: Entry
    integer                     :: i, j, k, l

    Error = 0.0_REAL64
    do j = 1, N
      do i = 1, N
        Entry = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
        do l = 1, N
          do k = 1, N
            Entry = Entry + conjg(U(k, i)) * H(k, l) * U(l, j)
          enddo
        enddo
        if (i == j) Entry = Entry - cmplx(E(i), 0.0_REAL64, REAL64)
        Error = max(Error, abs(Entry))
      enddo
    enddo
  end function ResidualError

  !< Maximum absolute entry of A - U*diag(DiagSigma)*VH for an M-by-N matrix
  !< A. The product uses the first min(M, N) columns of U and rows of VH, so
  !< it is the defining identity of the decomposition for any shape.
  pure function SVResidualError(A, U, DiagSigma, VH, M, N) result(Error)
    integer,         intent(in) :: M
    integer,         intent(in) :: N
    complex(REAL64), intent(in) :: A(M, N)
    complex(REAL64), intent(in) :: U(M, M)
    real(REAL64),    intent(in) :: DiagSigma(min(M, N))
    complex(REAL64), intent(in) :: VH(N, N)
    real(REAL64)                :: Error
    complex(REAL64)             :: Entry
    integer                     :: i, j, k

    Error = 0.0_REAL64
    do j = 1, N
      do i = 1, M
        Entry = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
        do k = 1, min(M, N)
          Entry = Entry &
            +U(i, k) * cmplx(DiagSigma(k), 0.0_REAL64, REAL64) * VH(k, j)
        enddo
        Error = max(Error, abs(Entry - A(i, j)))
      enddo
    enddo
  end function SVResidualError

  !< Fills Unitary with the normalized N-point Fourier matrix. Its columns
  !< are orthonormal and are the eigenvectors of every circulant matrix.
  pure subroutine FourierUnitary(Unitary, N)
    integer,         intent(in)  :: N
    complex(REAL64), intent(out) :: Unitary(N, N)

    real(REAL64), parameter :: &
      Pi = acos(-1.0_REAL64)

    integer :: i, k

    do k = 1, N
      do i = 1, N
        Unitary(i, k) = exp(cmplx(0.0_REAL64, &
                                  2.0_REAL64 * Pi * real((i - 1) * (k - 1), REAL64) / real(N, REAL64), REAL64)) &
          / sqrt(real(N, REAL64))
      enddo
    enddo
  end subroutine FourierUnitary

  !< Builds Matrix = Fourier diag(Eigenvalues) Fourier^H, a Hermitian matrix
  !< whose eigenvalues are Eigenvalues and whose eigenvectors are the columns
  !< of Fourier (the columns of a degenerate eigenvalue span its eigenspace).
  pure subroutine SpectralHermitian(Eigenvalues, Fourier, Matrix, N)
    integer,         intent(in)  :: N
    real(REAL64),    intent(in)  :: Eigenvalues(N)
    complex(REAL64), intent(in)  :: Fourier(N, N)
    complex(REAL64), intent(out) :: Matrix(N, N)

    Matrix = matmul(Fourier * spread(Eigenvalues, 1, N), &
                    conjg(transpose(Fourier)))
  end subroutine SpectralHermitian

  !< Absolute overlap |U(:, i)^H V(:, j)| between two unit columns. It is one
  !< when the columns are equal up to an arbitrary phase factor.
  pure function EigenvectorOverlap(U, V, N, i, j) result(Overlap)
    integer,         intent(in) :: N
    integer,         intent(in) :: i
    integer,         intent(in) :: j
    complex(REAL64), intent(in) :: U(N, N)
    complex(REAL64), intent(in) :: V(N, N)
    real(REAL64)                :: Overlap

    Overlap = abs(sum(conjg(U(:, i)) * V(:, j)))
  end function EigenvectorOverlap

  !< Maximum absolute entry below the diagonal of S.
  pure function UpperTriangularError(S, N) result(Error)
    integer,         intent(in) :: N
    complex(REAL64), intent(in) :: S(N, N)
    real(REAL64)                :: Error
    integer                     :: i, j

    Error = 0.0_REAL64
    do j = 1, N
      do i = j + 1, N
        Error = max(Error, abs(S(i, j)))
      enddo
    enddo
  end function UpperTriangularError

  !< Maximum absolute entry outside the diagonal of S. It is zero when S is
  !< diagonal, which is the Schur form of a normal matrix.
  pure function DiagonalError(S, N) result(Error)
    integer,         intent(in) :: N
    complex(REAL64), intent(in) :: S(N, N)
    real(REAL64)                :: Error
    integer                     :: i, j

    Error = 0.0_REAL64
    do j = 1, N
      do i = 1, N
        if (i /= j) Error = max(Error, abs(S(i, j)))
      enddo
    enddo
  end function DiagonalError

  !< Frobenius norm of the strictly upper triangle of S. Unitary similarity
  !< preserves ||S|| and the diagonal of a Schur form holds the eigenvalues,
  !< so this norm equals sqrt(||A||^2 - sum |lambda|^2): it is independent of
  !< the choice of Schur vectors and vanishes only when S is diagonal.
  pure function StrictUpperNorm(S, N) result(Norm)
    integer,         intent(in) :: N
    complex(REAL64), intent(in) :: S(N, N)
    real(REAL64)                :: Norm
    integer                     :: i, j

    Norm = 0.0_REAL64
    do j = 1, N
      do i = 1, j - 1
        Norm = Norm + abs(S(i, j))**2
      enddo
    enddo
    Norm = sqrt(Norm)
  end function StrictUpperNorm

  !< Maximum absolute entry of A*U - U*S.
  pure function SchurResidualError(A, U, S, N) result(Error)
    integer,         intent(in) :: N
    complex(REAL64), intent(in) :: A(N, N)
    complex(REAL64), intent(in) :: U(N, N)
    complex(REAL64), intent(in) :: S(N, N)
    real(REAL64)                :: Error

    Error = maxval(abs(matmul(A, U) - matmul(U, S)))
  end function SchurResidualError

  !< Maximum distance between the diagonal of S and the expected spectrum.
  !< The order of the eigenvalues is implementation-defined, so each
  !< expected value is matched to the closest unused diagonal entry.
  pure function SpectrumError(S, Expected, N) result(Error)
    integer,         intent(in) :: N
    complex(REAL64), intent(in) :: S(N, N)
    complex(REAL64), intent(in) :: Expected(N)
    real(REAL64)                :: Error, Best
    logical                     :: Used(N)
    integer                     :: i, j, BestIndex

    Used  = .false.
    Error = 0.0_REAL64

    do i = 1, N
      Best      = huge(1.0_REAL64)
      BestIndex = 0
      do j = 1, N
        if (.not.Used(j)) then
          if (abs(S(j, j) - Expected(i)) < Best) then
            Best      = abs(S(j, j) - Expected(i))
            BestIndex = j
          endif
        endif
      enddo
      Used(BestIndex) = .true.
      Error           = max(Error, Best)
    enddo
  end function SpectrumError

  !< Maximum distance between the generalized eigenvalue ratios and the
  !< expected spectrum. A pair with Beta(j) == 0 encodes an infinite
  !< eigenvalue; those pairs are skipped, so Expected must list only the
  !< finite eigenvalues, and a missing finite pair yields huge().
  pure function GeneralizedSpectrumError(Alpha, Beta, Expected, N) result(Error)
    integer,         intent(in) :: N
    complex(REAL64), intent(in) :: Alpha(N)
    complex(REAL64), intent(in) :: Beta(N)
    complex(REAL64), intent(in) :: Expected(N)
    real(REAL64)                :: Error, Best, Distance
    logical                     :: Used(N)
    integer                     :: i, j, BestIndex

    Used  = .false.
    Error = 0.0_REAL64

    do i = 1, N
      Best      = huge(1.0_REAL64)
      BestIndex = 0
      do j = 1, N
        if (.not.Used(j) .and. abs(Beta(j)) > 0.0_REAL64) then
          Distance = abs(Alpha(j) / Beta(j) - Expected(i))
          if (Distance < Best) then
            Best      = Distance
            BestIndex = j
          endif
        endif
      enddo
      if (BestIndex == 0) then
        Error = huge(1.0_REAL64)
        return
      endif
      Used(BestIndex) = .true.
      Error           = max(Error, Best)
    enddo
  end function GeneralizedSpectrumError

  !< Reconstructs the generalized Schur forms S = U^H*A*V and T = U^H*B*V
  !< from the returned factors, where V = VH^H.
  pure subroutine GeneralizedSchurForms(A, B, U, VH, S, T, N)
    integer,         intent(in)  :: N
    complex(REAL64), intent(in)  :: A(N, N)
    complex(REAL64), intent(in)  :: B(N, N)
    complex(REAL64), intent(in)  :: U(N, N)
    complex(REAL64), intent(in)  :: VH(N, N)
    complex(REAL64), intent(out) :: S(N, N)
    complex(REAL64), intent(out) :: T(N, N)

    complex(REAL64) :: V(N, N)

    V = conjg(transpose(VH))
    S = matmul(conjg(transpose(U)), matmul(A, V))
    T = matmul(conjg(transpose(U)), matmul(B, V))
  end subroutine GeneralizedSchurForms

  !< Maximum deviation between the returned generalized eigenvalue pairs and
  !< the diagonal of the generalized Schur forms. Alpha is compared with the
  !< diagonal of S and Beta with the diagonal of T, so no quotient is formed
  !< and a vanishing Beta needs no special case.
  pure function PairError(Alpha, Beta, S, T, N) result(Error)
    integer,         intent(in) :: N
    complex(REAL64), intent(in) :: Alpha(N)
    complex(REAL64), intent(in) :: Beta(N)
    complex(REAL64), intent(in) :: S(N, N)
    complex(REAL64), intent(in) :: T(N, N)
    real(REAL64)                :: Error

    integer :: i

    Error = 0.0_REAL64
    do i = 1, N
      Error = max(Error, abs(Alpha(i) - S(i, i)), abs(Beta(i) - T(i, i)))
    enddo
  end function PairError

  !< Maximum entry of U*S*VH - A relative to the largest entry of A. The
  !< relative form keeps the acceptance threshold independent of the scale of
  !< the random test pairs.
  pure function GeneralizedReconstructionError(A, U, S, VH, N) result(Error)
    integer,         intent(in) :: N
    complex(REAL64), intent(in) :: A(N, N)
    complex(REAL64), intent(in) :: U(N, N)
    complex(REAL64), intent(in) :: S(N, N)
    complex(REAL64), intent(in) :: VH(N, N)
    real(REAL64)                :: Error, Scale

    Scale = max(1.0_REAL64, maxval(abs(A)))
    Error = maxval(abs(matmul(U, matmul(S, VH)) - A)) / Scale
  end function GeneralizedReconstructionError

  !< Fills A and B with a reproducible pseudo-random complex pair. Both
  !< arrays are assumed-shape so that a caller may pass either a whole array
  !< or an array section. The generator is advanced through the Seed
  !< argument, so the routine is not pure.
  subroutine RandomPair(Seed, A, B, N)
    integer(INT64),  intent(inout) :: Seed
    integer,         intent(in)    :: N
    complex(REAL64), intent(out)   :: A(:, :)
    complex(REAL64), intent(out)   :: B(:, :)

    real(REAL64) :: RealPart, ImagPart
    integer      :: i, j

    do j = 1, N
      do i = 1, N
        RealPart = NextRandom(Seed)
        ImagPart = NextRandom(Seed)
        A(i, j)  = cmplx(RealPart, ImagPart, REAL64)
        RealPart = NextRandom(Seed)
        ImagPart = NextRandom(Seed)
        B(i, j)  = cmplx(RealPart, ImagPart, REAL64)
      enddo
    enddo
  end subroutine RandomPair

  !< Park-Miller minimal standard generator mapped to [-1, 1). Every product
  !< stays below 2**47, so the state update cannot overflow INT64.
  function NextRandom(Seed) result(Value)
    integer(INT64), intent(inout) :: Seed
    real(REAL64)                  :: Value

    Seed  = mod(48271_INT64 * Seed, 2147483647_INT64)
    Value = real(Seed - 1_INT64, REAL64) / 1073741823.0_REAL64 - 1.0_REAL64
  end function NextRandom

end module LDWFortranFunctionalSupport
#endif

TEST_E(LDWFortranDHNominal)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx1, CmplxI, DiagHermitian
  use LDWFortranFunctionalSupport, only: OrthonormalityError, ResidualError

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zheevd

  real(C_DOUBLE), parameter :: &
    Tolerance = 10.0_C_DOUBLE * epsilon(1.0_C_DOUBLE)

  complex(C_DOUBLE_COMPLEX) :: H(3, 3), HOriginal(3, 3), U(3, 3)
  real(C_DOUBLE)            :: E(3)
  integer(C_INT)            :: Info

  H(1, :)   = [ 3*Cmplx1,  1*CmplxI, 1*Cmplx1]
  H(2, :)   = [-1*CmplxI,  3*Cmplx1, 1*CmplxI]
  H(3, :)   = [ 1*Cmplx1, -1*CmplxI, 3*Cmplx1]
  HOriginal = H

  call DiagHermitian(Dimension = 3_C_SIZE_T, &
                     Matrix = H, &
                     Unitary = U, &
                     Eigenvalues = E, &
                     ZHEEVDProcedure = zheevd, &
                     Info = Info)

  ASSERT(Info == 0_C_INT)
  ASSERT(all(abs(E - [1.0_C_DOUBLE, 4.0_C_DOUBLE, 4.0_C_DOUBLE]) < Tolerance))
  ASSERT(OrthonormalityError(U, 3) < Tolerance)
  ASSERT(ResidualError(HOriginal, U, E, 3) < Tolerance)
  !Matrix is an input-only argument and must not be overwritten.
  ASSERT(all(abs(H - HOriginal) < Tolerance))

#endif
END_TEST_E

TEST_E(LDWFortranDHNominalNoEigenvalues)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx1, CmplxI, DiagHermitian
  use LDWFortranFunctionalSupport, only: OrthonormalityError, ResidualError

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zheevd

  real(C_DOUBLE), parameter :: &
    Tolerance = 10.0_C_DOUBLE * epsilon(1.0_C_DOUBLE)

  complex(C_DOUBLE_COMPLEX) :: H(3, 3), U(3, 3)
  real(C_DOUBLE)            :: KnownE(3)
  integer(C_INT)            :: Info

  H(1, :) = [ 3*Cmplx1,  1*CmplxI, 1*Cmplx1]
  H(2, :) = [-1*CmplxI,  3*Cmplx1, 1*CmplxI]
  H(3, :) = [ 1*Cmplx1, -1*CmplxI, 3*Cmplx1]

  KnownE = [1.0_C_DOUBLE, 4.0_C_DOUBLE, 4.0_C_DOUBLE]

  !Eigenvalues is optional: omitting it must not change the unitary matrix.
  call DiagHermitian(Dimension = 3_C_SIZE_T, &
                     Matrix = H, &
                     Unitary = U, &
                     ZHEEVDProcedure = zheevd, &
                     Info = Info)

  ASSERT(Info == 0_C_INT)
  ASSERT(OrthonormalityError(U, 3) < Tolerance)
  ASSERT(ResidualError(H, U, KnownE, 3) < Tolerance)

#endif
END_TEST_E

TEST_E(LDWFortranDHNominal1x1)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    DiagHermitian
  use LDWFortranFunctionalSupport, only: OrthonormalityError, ResidualError

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zheevd

  real(C_DOUBLE), parameter :: &
    Tolerance = 10.0_C_DOUBLE * epsilon(1.0_C_DOUBLE)

  complex(C_DOUBLE_COMPLEX) :: H(1, 1), U(1, 1)
  real(C_DOUBLE)            :: E(1)
  integer(C_INT)            :: Info

  H(1, 1) = cmplx(-3.5_C_DOUBLE, 0.0_C_DOUBLE, C_DOUBLE_COMPLEX)

  !Smallest dimension: the workspace query returns the minimum sizes.
  call DiagHermitian(Dimension = 1_C_SIZE_T, &
                     Matrix = H, &
                     Unitary = U, &
                     Eigenvalues = E, &
                     ZHEEVDProcedure = zheevd, &
                     Info = Info)

  ASSERT(Info == 0_C_INT)
  ASSERT(abs(E(1) + 3.5_C_DOUBLE) < Tolerance)
  ASSERT(OrthonormalityError(U, 1) < Tolerance)
  ASSERT(ResidualError(H, U, E, 1) < Tolerance)

#endif
END_TEST_E

TEST_E(LDWFortranDHNominal2x2)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx1, CmplxI, DiagHermitian
  use LDWFortranFunctionalSupport, only: OrthonormalityError, ResidualError

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zheevd

  real(C_DOUBLE), parameter :: &
    Tolerance = 10.0_C_DOUBLE * epsilon(1.0_C_DOUBLE)

  complex(C_DOUBLE_COMPLEX) :: H(2, 2), U(2, 2)
  real(C_DOUBLE)            :: E(2)
  integer(C_INT)            :: Info

  H(1, :) = [ 2*Cmplx1,  1*CmplxI]
  H(2, :) = [-1*CmplxI,  2*Cmplx1]

  call DiagHermitian(Dimension = 2_C_SIZE_T, &
                     Matrix = H, &
                     Unitary = U, &
                     Eigenvalues = E, &
                     ZHEEVDProcedure = zheevd, &
                     Info = Info)

  ASSERT(Info == 0_C_INT)
  ASSERT(all(abs(E - [1.0_C_DOUBLE, 3.0_C_DOUBLE]) < Tolerance))
  ASSERT(OrthonormalityError(U, 2) < Tolerance)
  ASSERT(ResidualError(H, U, E, 2) < Tolerance)

#endif
END_TEST_E

TEST_E(LDWFortranDHNominal8x8)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, &
                                    C_INT, DiagHermitian
  use LDWFortranFunctionalSupport, only: FourierUnitary, SpectralHermitian, &
                                         EigenvectorOverlap, &
                                         OrthonormalityError, ResidualError

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zheevd

  integer, parameter :: N = 8

  !Tolerance grows with the order because the residual and the orthonormality
  !sums accumulate O(N) rounding errors.
  real(C_DOUBLE), parameter :: &
    Tolerance = 10.0_C_DOUBLE * real(N, C_DOUBLE) * epsilon(1.0_C_DOUBLE)

  !Partially degenerate spectrum: twofold at 1 and threefold at 3.
  real(C_DOUBLE), parameter :: KnownE(N) = &
    [1.0_C_DOUBLE, 1.0_C_DOUBLE, 2.0_C_DOUBLE, 3.0_C_DOUBLE, &
    3.0_C_DOUBLE, 3.0_C_DOUBLE, 5.0_C_DOUBLE, 7.0_C_DOUBLE]

  complex(C_DOUBLE_COMPLEX) :: Fourier(N, N), H(N, N), U(N, N)
  real(C_DOUBLE)            :: E(N)
  integer(C_INT)            :: Info

  !H = Fourier*diag(KnownE)*Fourier^H is dense Hermitian and circulant, so its
  !eigenvectors are the Fourier columns.
  call FourierUnitary(Fourier, N)
  call SpectralHermitian(KnownE, Fourier, H, N)

  call DiagHermitian(Dimension = int(N, C_SIZE_T), &
                     Matrix = H, &
                     Unitary = U, &
                     Eigenvalues = E, &
                     ZHEEVDProcedure = zheevd, &
                     Info = Info)

  ASSERT(Info == 0_C_INT)
  ASSERT(all(abs(E - KnownE) < Tolerance))
  ASSERT(OrthonormalityError(U, N) < Tolerance)
  ASSERT(ResidualError(H, U, E, N) < Tolerance)

  !Eigenvectors of a simple eigenvalue are unique up to a phase factor.
  ASSERT(abs(EigenvectorOverlap(U, Fourier, N, 3, 3) - 1.0_C_DOUBLE) < Tolerance)
  ASSERT(abs(EigenvectorOverlap(U, Fourier, N, 7, 7) - 1.0_C_DOUBLE) < Tolerance)
  ASSERT(abs(EigenvectorOverlap(U, Fourier, N, 8, 8) - 1.0_C_DOUBLE) < Tolerance)

#endif
END_TEST_E

TEST_E(LDWFortranDHNominal16x16)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, &
                                    C_INT, DiagHermitian
  use LDWFortranFunctionalSupport, only: FourierUnitary, SpectralHermitian, &
                                         EigenvectorOverlap, &
                                         OrthonormalityError, ResidualError

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zheevd

  integer, parameter :: N = 16

  real(C_DOUBLE), parameter :: &
    Tolerance = 10.0_C_DOUBLE * real(N, C_DOUBLE) * epsilon(1.0_C_DOUBLE)

  !Partially degenerate spectrum: threefold at 1, twofold at 3 and fourfold
  !at 7, which stresses the workspace sizing of a non-trivial order.
  real(C_DOUBLE), parameter :: KnownE(N) = &
    [1.0_C_DOUBLE, 1.0_C_DOUBLE, 1.0_C_DOUBLE, 2.0_C_DOUBLE, &
    3.0_C_DOUBLE, 3.0_C_DOUBLE, 4.0_C_DOUBLE, 5.0_C_DOUBLE, &
    6.0_C_DOUBLE, 7.0_C_DOUBLE, 7.0_C_DOUBLE, 7.0_C_DOUBLE, &
    7.0_C_DOUBLE, 8.0_C_DOUBLE, 9.0_C_DOUBLE, 10.0_C_DOUBLE]

  complex(C_DOUBLE_COMPLEX) :: Fourier(N, N), H(N, N), U(N, N)
  real(C_DOUBLE)            :: E(N)
  integer(C_INT)            :: Info

  call FourierUnitary(Fourier, N)
  call SpectralHermitian(KnownE, Fourier, H, N)

  call DiagHermitian(Dimension = int(N, C_SIZE_T), &
                     Matrix = H, &
                     Unitary = U, &
                     Eigenvalues = E, &
                     ZHEEVDProcedure = zheevd, &
                     Info = Info)

  ASSERT(Info == 0_C_INT)
  ASSERT(all(abs(E - KnownE) < Tolerance))
  ASSERT(OrthonormalityError(U, N) < Tolerance)
  ASSERT(ResidualError(H, U, E, N) < Tolerance)

  !The first, middle and last eigenvectors of a simple eigenvalue.
  ASSERT(abs(EigenvectorOverlap(U, Fourier, N, 4, 4) - 1.0_C_DOUBLE) < Tolerance)
  ASSERT(abs(EigenvectorOverlap(U, Fourier, N, 9, 9) - 1.0_C_DOUBLE) < Tolerance)
  ASSERT(abs(EigenvectorOverlap(U, Fourier, N, 16, 16) - 1.0_C_DOUBLE) < Tolerance)

#endif
END_TEST_E

TEST_E(LDWFortranDHFastReturn)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: INT32, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx1, DiagHermitian
  use LDWFortranFunctionalSupport, only: ResetZHEEVDStub, &
                                         GetZHEEVDStubCalls, ZHEEVDStub

  implicit none
  TSD_TEST_E_INTERFACES

  complex(C_DOUBLE_COMPLEX) :: H(1, 1), U(1, 1)
  integer(C_INT)            :: Info
  integer(INT32)            :: Queries, Computations

  H = 42 * Cmplx1
  U = 42 * Cmplx1

  call ResetZHEEVDStub()

  !Dimension zero is a fast return: the deferred procedure is never called
  !and the output arguments are left untouched.
  call DiagHermitian(Dimension = 0_C_SIZE_T, &
                     Matrix = H, &
                     Unitary = U, &
                     ZHEEVDProcedure = ZHEEVDStub, &
                     Info = Info)

  ASSERT(Info == 0_C_INT)
  ASSERT(all(abs(U - 42 * Cmplx1) <= 0.0_C_DOUBLE))

  call GetZHEEVDStubCalls(Queries, Computations)
  ASSERT(Queries == 0_INT32)
  ASSERT(Computations == 0_INT32)

#endif
END_TEST_E

TEST_E(LDWFortranDHTooLarge)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: INT32, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx1, DiagHermitian
  use LDWFortranFunctionalSupport, only: ResetZHEEVDStub, &
                                         GetZHEEVDStubCalls, ZHEEVDStub

  implicit none
  TSD_TEST_E_INTERFACES

  complex(C_DOUBLE_COMPLEX) :: H(1, 1), U(1, 1)
  integer(C_INT)            :: Info
  integer(INT32)            :: Queries, Computations

  H = 42 * Cmplx1
  U = 42 * Cmplx1

  call ResetZHEEVDStub()

  !Dimensions beyond the LAPACK integer range are rejected before any buffer
  !is allocated or the deferred procedure is called.
  call DiagHermitian(Dimension = int(huge(1_INT32), C_SIZE_T) + 1_C_SIZE_T, &
                     Matrix = H, &
                     Unitary = U, &
                     ZHEEVDProcedure = ZHEEVDStub, &
                     Info = Info)

  ASSERT(Info == int(huge(1_INT32), C_INT))
  ASSERT(all(abs(U - 42 * Cmplx1) <= 0.0_C_DOUBLE))

  call GetZHEEVDStubCalls(Queries, Computations)
  ASSERT(Queries == 0_INT32)
  ASSERT(Computations == 0_INT32)

#endif
END_TEST_E

TEST_E(LDWFortranDHFailWorkspaceQuery)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: INT32, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx1, CmplxI, DiagHermitian
  use LDWFortranFunctionalSupport, only: &
    LDWStubFailingQuery, ResetZHEEVDStub, SetZHEEVDStubStatus, &
    GetZHEEVDStubCalls, ZHEEVDStub

  implicit none
  TSD_TEST_E_INTERFACES

  complex(C_DOUBLE_COMPLEX) :: H(3, 3), U(3, 3)
  integer(C_INT)            :: Info
  integer(INT32)            :: Queries, Computations

  H(1, :) = [ 3*Cmplx1,  1*CmplxI, 1*Cmplx1]
  H(2, :) = [-1*CmplxI,  3*Cmplx1, 1*CmplxI]
  H(3, :) = [ 1*Cmplx1, -1*CmplxI, 3*Cmplx1]

  U = 42 * Cmplx1

  call ResetZHEEVDStub()
  call SetZHEEVDStubStatus(LDWStubFailingQuery, 0_INT32)

  !A failing workspace query is propagated unchanged and the computational
  !call is never made.
  call DiagHermitian(Dimension = 3_C_SIZE_T, &
                     Matrix = H, &
                     Unitary = U, &
                     ZHEEVDProcedure = ZHEEVDStub, &
                     Info = Info)

  ASSERT(Info == int(LDWStubFailingQuery, C_INT))
  ASSERT(all(abs(U - 42 * Cmplx1) <= 0.0_C_DOUBLE))

  call GetZHEEVDStubCalls(Queries, Computations)
  ASSERT(Queries == 1_INT32)
  ASSERT(Computations == 0_INT32)

#endif
END_TEST_E

TEST_E(LDWFortranDHFailComputation)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: INT32, C_DOUBLE, C_DOUBLE_COMPLEX, &
                                    C_INT, Cmplx1, CmplxI, DiagHermitian
  use LDWFortranFunctionalSupport, only: ResetZHEEVDStub, &
                                         SetZHEEVDStubStatus, &
                                         GetZHEEVDStubCalls, ZHEEVDStub

  implicit none
  TSD_TEST_E_INTERFACES

  integer(INT32), parameter :: ComputeStatus = -6_INT32

  complex(C_DOUBLE_COMPLEX) :: H(3, 3), U(3, 3)
  real(C_DOUBLE)            :: E(3)
  integer(C_INT)            :: Info
  integer(INT32)            :: Queries, Computations

  H(1, :) = [ 3*Cmplx1,  1*CmplxI, 1*Cmplx1]
  H(2, :) = [-1*CmplxI,  3*Cmplx1, 1*CmplxI]
  H(3, :) = [ 1*Cmplx1, -1*CmplxI, 3*Cmplx1]

  call ResetZHEEVDStub()
  call SetZHEEVDStubStatus(0_INT32, ComputeStatus)

  !A nonzero status from the computational call is propagated unchanged.
  call DiagHermitian(Dimension = 3_C_SIZE_T, &
                     Matrix = H, &
                     Unitary = U, &
                     Eigenvalues = E, &
                     ZHEEVDProcedure = ZHEEVDStub, &
                     Info = Info)

  ASSERT(Info == int(ComputeStatus, C_INT))

  call GetZHEEVDStubCalls(Queries, Computations)
  ASSERT(Queries == 1_INT32)
  ASSERT(Computations == 1_INT32)

#endif
END_TEST_E

