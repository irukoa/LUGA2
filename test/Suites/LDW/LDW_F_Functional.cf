TEST_E(LDWFortranZGEESNominal1x1)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx1, SchurDecomposition
  use LDWFortranFunctionalSupport, only: UpperTriangularError, &
                                         SchurResidualError, SpectrumError

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zgees

  real(C_DOUBLE), parameter :: &
    Tolerance = 10.0_C_DOUBLE * epsilon(1.0_C_DOUBLE)

  complex(C_DOUBLE_COMPLEX), parameter :: &
    KnownE(1) = [-3.5_C_DOUBLE*Cmplx1]

  complex(C_DOUBLE_COMPLEX) :: A(1, 1), U(1, 1), S(1, 1)
  integer(C_INT)            :: Info

  A(1, 1) = -3.5_C_DOUBLE * Cmplx1

  !Smallest dimension: the workspace query returns the minimum size.
  call SchurDecomposition(Dimension = 1_C_SIZE_T, &
                          Matrix = A, &
                          Unitary = U, &
                          SchurForm = S, &
                          ZGEESProcedure = zgees, &
                          Info = Info)

  ASSERT(Info == 0_C_INT)
  ASSERT(UpperTriangularError(S, 1) < Tolerance)
  ASSERT(SchurResidualError(A, U, S, 1) < Tolerance)
  ASSERT(SpectrumError(S, KnownE, 1) < Tolerance)
  ASSERT(abs(abs(U(1, 1)) - 1.0_C_DOUBLE) < Tolerance)

#endif
END_TEST_E

TEST_E(LDWFortranZGEESNominal2x2)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx0, Cmplx1, CmplxI, SchurDecomposition
  use LDWFortranFunctionalSupport, only: DiagonalError, &
                                         OrthonormalityError, &
                                         SchurResidualError, SpectrumError

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zgees

  real(C_DOUBLE), parameter :: &
    Tolerance = 100.0_C_DOUBLE * epsilon(1.0_C_DOUBLE)

  complex(C_DOUBLE_COMPLEX), parameter :: &
    KnownE(2) = [Cmplx1, -Cmplx1]

  complex(C_DOUBLE_COMPLEX) :: A(2, 2), AOriginal(2, 2), U(2, 2), S(2, 2)
  integer(C_INT)            :: Info
  integer                   :: i

  !Second Pauli matrix: Hermitian and unitary, hence normal. Its eigenvalues
  !are +1 and -1 and its Schur form is diagonal.
  A(1, :)   = [Cmplx0, -CmplxI]
  A(2, :)   = [CmplxI,  Cmplx0]
  AOriginal = A

  call SchurDecomposition(Dimension = 2_C_SIZE_T, &
                          Matrix = A, &
                          Unitary = U, &
                          SchurForm = S, &
                          ZGEESProcedure = zgees, &
                          Info = Info)

  ASSERT(Info == 0_C_INT)
  !Matrix is an input-only argument and must not be overwritten.
  ASSERT(all(abs(A - AOriginal) <= 0.0_C_DOUBLE))
  ASSERT(OrthonormalityError(U, 2) < Tolerance)

  !A normal matrix has a diagonal Schur form, so this is a diagonalization.
  ASSERT(DiagonalError(S, 2) < Tolerance)
  do i = 1, 2
    ASSERT(abs(abs(S(i, i)) - 1.0_C_DOUBLE) < Tolerance)
  enddo

  ASSERT(SchurResidualError(AOriginal, U, S, 2) < Tolerance)
  ASSERT(SpectrumError(S, KnownE, 2) < Tolerance)

#endif
END_TEST_E

TEST_E(LDWFortranZGEESNominal4x4)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx0, Cmplx1, CmplxI, SchurDecomposition
  use LDWFortranFunctionalSupport, only: DiagonalError, &
                                         OrthonormalityError, &
                                         SchurResidualError, SpectrumError

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zgees

  integer, parameter :: N = 4

  real(C_DOUBLE), parameter :: &
    Tolerance = 100.0_C_DOUBLE * epsilon(1.0_C_DOUBLE)

  complex(C_DOUBLE_COMPLEX), parameter :: &
    KnownE(N) = [Cmplx1, CmplxI, -Cmplx1, -CmplxI]

  complex(C_DOUBLE_COMPLEX) :: A(N, N), AOriginal(N, N), U(N, N), S(N, N)
  integer(C_INT)            :: Info
  integer                   :: i

  !Four-cycle permutation matrix: unitary, hence normal, with the fourth
  !roots of unity as eigenvalues.
  A         = Cmplx0
  A(2, 1)   = Cmplx1
  A(3, 2)   = Cmplx1
  A(4, 3)   = Cmplx1
  A(1, 4)   = Cmplx1
  AOriginal = A

  call SchurDecomposition(Dimension = int(N, C_SIZE_T), &
                          Matrix = A, &
                          Unitary = U, &
                          SchurForm = S, &
                          ZGEESProcedure = zgees, &
                          Info = Info)

  ASSERT(Info == 0_C_INT)
  ASSERT(all(abs(A - AOriginal) <= 0.0_C_DOUBLE))
  ASSERT(OrthonormalityError(U, N) < Tolerance)

  !A normal matrix has a diagonal Schur form, so this is a diagonalization.
  ASSERT(DiagonalError(S, N) < Tolerance)
  do i = 1, N
    ASSERT(abs(abs(S(i, i)) - 1.0_C_DOUBLE) < Tolerance)
  enddo

  ASSERT(SchurResidualError(AOriginal, U, S, N) < Tolerance)
  ASSERT(SpectrumError(S, KnownE, N) < Tolerance)

#endif
END_TEST_E

TEST_E(LDWFortranZGEESNominalComplex)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx0, Cmplx1, CmplxI, SchurDecomposition
  use LDWFortranFunctionalSupport, only: FourierUnitary, &
                                         OrthonormalityError, &
                                         StrictUpperNorm, &
                                         UpperTriangularError, &
                                         SchurResidualError, SpectrumError

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zgees

  integer, parameter :: N = 3

  complex(C_DOUBLE_COMPLEX), parameter :: &
    KnownE(N) = [Cmplx1, -Cmplx1, CmplxI]

  complex(C_DOUBLE_COMPLEX) :: Triangular(N, N), Fourier(N, N), A(N, N), &
                               U(N, N), S(N, N)

  real(C_DOUBLE) :: Tolerance
  integer(C_INT) :: Info

  !Triangular is complex, non-normal and well conditioned: its eigenvalues
  !(1, -1 and i) are separated and its entries are of order one.
  Triangular       = Cmplx0
  Triangular(1, 1) = Cmplx1
  Triangular(2, 2) = -Cmplx1
  Triangular(3, 3) = CmplxI
  Triangular(1, 2) = 2.0_C_DOUBLE * CmplxI
  Triangular(2, 3) = Cmplx1

  !A = Fourier * Triangular * Fourier^H is a unitary similarity, so A is a
  !dense complex non-normal matrix with the same eigenvalues. Unlike a normal
  !matrix, it has no diagonal Schur form.
  call FourierUnitary(Fourier, N)
  A = matmul(Fourier, matmul(Triangular, conjg(transpose(Fourier))))

  !The Schur decomposition is backward stable, so the residual is a small
  !multiple of eps times the norm of the matrix.
  Tolerance = 100.0_C_DOUBLE * epsilon(1.0_C_DOUBLE) * &
    max(1.0_C_DOUBLE, maxval(abs(A)))

  call SchurDecomposition(Dimension = int(N, C_SIZE_T), &
                          Matrix = A, &
                          Unitary = U, &
                          SchurForm = S, &
                          ZGEESProcedure = zgees, &
                          Info = Info)

  ASSERT(Info == 0_C_INT)
  ASSERT(OrthonormalityError(U, N) < Tolerance)
  ASSERT(UpperTriangularError(S, N) < Tolerance)

  !Because A is not normal, no Schur form of it can be diagonal: the Frobenius
  !norm of the strictly upper triangle is sqrt(||A||^2 - sum |lambda|^2),
  !which is about 2.2 here, so it cannot be a rounding artifact.
  ASSERT(StrictUpperNorm(S, N) > 2.0_C_DOUBLE)

  ASSERT(SchurResidualError(A, U, S, N) < Tolerance)
  ASSERT(SpectrumError(S, KnownE, N) < Tolerance)

#endif
END_TEST_E

TEST_E(LDWFortranZGEESNominalCongruence)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    C_SIZE_T, Cmplx1, CmplxI, SchurDecomposition
  use LDWFortranFunctionalSupport, only: OrthonormalityError, &
                                         SchurResidualError, SpectrumError, &
                                         StrictUpperNorm, UpperTriangularError

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zgees

  integer, parameter :: N = 3

  complex(C_DOUBLE_COMPLEX), parameter :: &
    KnownE(N) = [Cmplx1 - 2*CmplxI, 3*Cmplx1 + 3*CmplxI, 2*CmplxI]

  complex(C_DOUBLE_COMPLEX) :: A(N, N), AOriginal(N, N), U(N, N), S(N, N)

  real(C_DOUBLE) :: CongruenceError, Tolerance
  integer(C_INT) :: Info

  !An arbitrary dense matrix with a well-separated spectrum: it is neither
  !normal, nor unitary, nor triangular, so its Schur form is triangular
  !without being diagonal. Its eigenvalues are 1 - 2i, 3 + 3i and 2i.
  A(1, :)   = [ Cmplx1 + 2*CmplxI, 3*Cmplx1 - CmplxI, Cmplx1]
  A(2, :)   = [-2*Cmplx1 + CmplxI, 4*Cmplx1, Cmplx1 + 3*CmplxI]
  A(3, :)   = [ Cmplx1 - CmplxI, 2*CmplxI, -Cmplx1 + CmplxI]
  AOriginal = A

  !The Schur decomposition is backward stable, so the residual is a small
  !multiple of eps times the norm of the matrix.
  Tolerance = 100.0_C_DOUBLE * epsilon(1.0_C_DOUBLE) * &
    max(1.0_C_DOUBLE, maxval(abs(A)))

  call SchurDecomposition(Dimension = int(N, C_SIZE_T), &
                          Matrix = A, &
                          Unitary = U, &
                          SchurForm = S, &
                          ZGEESProcedure = zgees, &
                          Info = Info)

  ASSERT(Info == 0_C_INT)
  !Matrix is an input-only argument and must not be overwritten.
  ASSERT(all(abs(A - AOriginal) <= 0.0_C_DOUBLE))
  ASSERT(OrthonormalityError(U, N) < Tolerance)

  !Every Schur form is upper triangular, and A is not normal here, so the
  !strictly upper triangle has a Frobenius norm of about 5.3.
  ASSERT(UpperTriangularError(S, N) < Tolerance)
  ASSERT(StrictUpperNorm(S, N) > 5.0_C_DOUBLE)

  !S = U^H*A*U and, equivalently, A*U = U*S, entry by entry.
  CongruenceError = maxval(abs(matmul(conjg(transpose(U)), &
                                      matmul(AOriginal, U)) - S))
  ASSERT(CongruenceError < Tolerance)
  ASSERT(SchurResidualError(AOriginal, U, S, N) < Tolerance)

  !The diagonal of S holds the spectrum of A.
  ASSERT(SpectrumError(S, KnownE, N) < Tolerance)

#endif
END_TEST_E

TEST_E(LDWFortranZGEESNominalNoSchurForm)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx0, Cmplx1, CmplxI, SchurDecomposition
  use LDWFortranFunctionalSupport, only: DiagonalError, &
                                         OrthonormalityError, SpectrumError

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zgees

  real(C_DOUBLE), parameter :: &
    Tolerance = 100.0_C_DOUBLE * epsilon(1.0_C_DOUBLE)

  complex(C_DOUBLE_COMPLEX), parameter :: &
    KnownE(2) = [Cmplx1, -Cmplx1]

  complex(C_DOUBLE_COMPLEX) :: A(2, 2), U(2, 2), S(2, 2)
  integer(C_INT)            :: Info

  !The unitary Pauli matrix of Nominal2x2.
  A(1, :) = [Cmplx0, -CmplxI]
  A(2, :) = [CmplxI,  Cmplx0]

  !SchurForm is optional: it can be reconstructed from Matrix and Unitary,
  !so omitting it must not change the unitary transformation.
  call SchurDecomposition(Dimension = 2_C_SIZE_T, &
                          Matrix = A, &
                          Unitary = U, &
                          ZGEESProcedure = zgees, &
                          Info = Info)

  ASSERT(Info == 0_C_INT)
  ASSERT(OrthonormalityError(U, 2) < Tolerance)

  S = matmul(conjg(transpose(U)), matmul(A, U))
  ASSERT(DiagonalError(S, 2) < Tolerance)
  ASSERT(SpectrumError(S, KnownE, 2) < Tolerance)

#endif
END_TEST_E

TEST_E(LDWFortranZGEESFastReturn)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: INT32, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx1, SchurDecomposition
  use LDWFortranFunctionalSupport, only: ResetZGEESStub, &
                                         GetZGEESStubCalls, ZGEESStub

  implicit none
  TSD_TEST_E_INTERFACES

  complex(C_DOUBLE_COMPLEX) :: A(1, 1), U(1, 1), S(1, 1)
  integer(C_INT)            :: Info
  integer(INT32)            :: Queries, Computations

  A = 42 * Cmplx1
  U = 42 * Cmplx1
  S = 42 * Cmplx1

  call ResetZGEESStub()

  !Dimension zero is a fast return: the deferred procedure is never called
  !and the output arguments are left untouched.
  call SchurDecomposition(Dimension = 0_C_SIZE_T, &
                          Matrix = A, &
                          Unitary = U, &
                          SchurForm = S, &
                          ZGEESProcedure = ZGEESStub, &
                          Info = Info)

  ASSERT(Info == 0_C_INT)
  ASSERT(all(abs(U - 42 * Cmplx1) <= 0.0_C_DOUBLE))
  ASSERT(all(abs(S - 42 * Cmplx1) <= 0.0_C_DOUBLE))

  call GetZGEESStubCalls(Queries, Computations)
  ASSERT(Queries == 0_INT32)
  ASSERT(Computations == 0_INT32)

#endif
END_TEST_E

TEST_E(LDWFortranZGEESTooLarge)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: INT32, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx1, SchurDecomposition
  use LDWFortranFunctionalSupport, only: ResetZGEESStub, &
                                         GetZGEESStubCalls, ZGEESStub

  implicit none
  TSD_TEST_E_INTERFACES

  complex(C_DOUBLE_COMPLEX) :: A(1, 1), U(1, 1), S(1, 1)
  integer(C_INT)            :: Info
  integer(INT32)            :: Queries, Computations

  A = 42 * Cmplx1
  U = 42 * Cmplx1
  S = 42 * Cmplx1

  call ResetZGEESStub()

  !Dimensions beyond the LAPACK integer range are rejected before any buffer
  !is allocated or the deferred procedure is called.
  call SchurDecomposition(Dimension = int(huge(1_INT32), C_SIZE_T) + 1_C_SIZE_T, &
                          Matrix = A, &
                          Unitary = U, &
                          SchurForm = S, &
                          ZGEESProcedure = ZGEESStub, &
                          Info = Info)

  ASSERT(Info == int(huge(1_INT32), C_INT))
  ASSERT(all(abs(U - 42 * Cmplx1) <= 0.0_C_DOUBLE))
  ASSERT(all(abs(S - 42 * Cmplx1) <= 0.0_C_DOUBLE))

  call GetZGEESStubCalls(Queries, Computations)
  ASSERT(Queries == 0_INT32)
  ASSERT(Computations == 0_INT32)

#endif
END_TEST_E

TEST_E(LDWFortranZGEESFailWorkspaceQuery)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: INT32, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx1, SchurDecomposition
  use LDWFortranFunctionalSupport, only: &
    LDWStubFailingQuery, ResetZGEESStub, SetZGEESStubStatus, &
    GetZGEESStubCalls, ZGEESStub

  implicit none
  TSD_TEST_E_INTERFACES

  complex(C_DOUBLE_COMPLEX) :: A(3, 3), U(3, 3), S(3, 3)
  integer(C_INT)            :: Info
  integer(INT32)            :: Queries, Computations

  A = 0 * Cmplx1

  U = 42 * Cmplx1
  S = 42 * Cmplx1

  call ResetZGEESStub()
  call SetZGEESStubStatus(LDWStubFailingQuery, 0_INT32)

  !A failing workspace query is propagated unchanged and the computational
  !call is never made. The outputs are left untouched.
  call SchurDecomposition(Dimension = 3_C_SIZE_T, &
                          Matrix = A, &
                          Unitary = U, &
                          SchurForm = S, &
                          ZGEESProcedure = ZGEESStub, &
                          Info = Info)

  ASSERT(Info == int(LDWStubFailingQuery, C_INT))
  ASSERT(all(abs(U - 42 * Cmplx1) <= 0.0_C_DOUBLE))
  ASSERT(all(abs(S - 42 * Cmplx1) <= 0.0_C_DOUBLE))

  call GetZGEESStubCalls(Queries, Computations)
  ASSERT(Queries == 1_INT32)
  ASSERT(Computations == 0_INT32)

#endif
END_TEST_E

TEST_E(LDWFortranZGEESFailComputation)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: INT32, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx1, SchurDecomposition
  use LDWFortranFunctionalSupport, only: ResetZGEESStub, &
                                         SetZGEESStubStatus, &
                                         GetZGEESStubCalls, ZGEESStub

  implicit none
  TSD_TEST_E_INTERFACES

  integer(INT32), parameter :: ComputeStatus = -6_INT32

  complex(C_DOUBLE_COMPLEX) :: A(3, 3), U(3, 3), S(3, 3)
  integer(C_INT)            :: Info
  integer(INT32)            :: Queries, Computations

  A = 0 * Cmplx1

  call ResetZGEESStub()
  call SetZGEESStubStatus(0_INT32, ComputeStatus)

  !A nonzero status from the computational call is propagated unchanged.
  call SchurDecomposition(Dimension = 3_C_SIZE_T, &
                          Matrix = A, &
                          Unitary = U, &
                          SchurForm = S, &
                          ZGEESProcedure = ZGEESStub, &
                          Info = Info)

  ASSERT(Info == int(ComputeStatus, C_INT))

  call GetZGEESStubCalls(Queries, Computations)
  ASSERT(Queries == 1_INT32)
  ASSERT(Computations == 1_INT32)

#endif
END_TEST_E

