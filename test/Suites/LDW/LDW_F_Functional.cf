TEST_E(LDWFortranDiagHermitianReference)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE_COMPLEX, C_DOUBLE, C_INT, &
                                    Cmplx1, CmplxI, &
                                    DiagHermitian

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zheevd

  complex(C_DOUBLE_COMPLEX) :: H(3, 3), U(3, 3)
  real(C_DOUBLE)            :: E(3)
  integer(C_INT)            :: Info

  integer :: i, j

  H(1, :) = [ 3*Cmplx1,  1*CmplxI, 1*Cmplx1]
  H(2, :) = [-1*CmplxI,  3*Cmplx1, 1*CmplxI]
  H(3, :) = [ 1*Cmplx1, -1*CmplxI, 3*Cmplx1]

  call DiagHermitian(Dimension = 3_C_SIZE_T, &
                     Matrix = H, &
                     Unitary = U, &
                     Eigenvalues = E, &
                     ZHEEVDProcedure = zheevd, &
                     Info = Info)
  ASSERT(Info == 0_C_INT)

  ASSERT(abs(E(1) - 1.0_C_DOUBLE) < 10 * epsilon(1.0_C_DOUBLE))
  ASSERT(abs(abs(sum(U(:, 1) * conjg(U(:, 1)))) - 1.0_C_DOUBLE) < 10 * epsilon(1.0_C_DOUBLE))
  ASSERT(abs(abs(sum(U(:, 1) * conjg(U(:, 2)))) - 0.0_C_DOUBLE) < 10 * epsilon(1.0_C_DOUBLE))
  ASSERT(abs(abs(sum(U(:, 1) * conjg(U(:, 3)))) - 0.0_C_DOUBLE) < 10 * epsilon(1.0_C_DOUBLE))

  ASSERT(abs(E(2) - 4.0_C_DOUBLE) < 10 * epsilon(1.0_C_DOUBLE))
  ASSERT(abs(abs(sum(U(:, 2) * conjg(U(:, 1)))) - 0.0_C_DOUBLE) < 10 * epsilon(1.0_C_DOUBLE))
  ASSERT(abs(abs(sum(U(:, 2) * conjg(U(:, 2)))) - 1.0_C_DOUBLE) < 10 * epsilon(1.0_C_DOUBLE))
  ASSERT(abs(abs(sum(U(:, 2) * conjg(U(:, 3)))) - 0.0_C_DOUBLE) < 10 * epsilon(1.0_C_DOUBLE))

  ASSERT(abs(E(3) - 4.0_C_DOUBLE) < 10 * epsilon(1.0_C_DOUBLE))
  ASSERT(abs(abs(sum(U(:, 3) * conjg(U(:, 1)))) - 0.0_C_DOUBLE) < 10 * epsilon(1.0_C_DOUBLE))
  ASSERT(abs(abs(sum(U(:, 3) * conjg(U(:, 2)))) - 0.0_C_DOUBLE) < 10 * epsilon(1.0_C_DOUBLE))
  ASSERT(abs(abs(sum(U(:, 3) * conjg(U(:, 3)))) - 1.0_C_DOUBLE) < 10 * epsilon(1.0_C_DOUBLE))

  H = matmul(conjg(transpose(U)), matmul(H, U))
  do i = 1, 3
    do j = 1, 3
      if (i == j) then
        ASSERT(abs(H(i, j) - E(i) * Cmplx1) < 10 * epsilon(1.0_C_DOUBLE))
      else
        ASSERT(abs(H(i, j)) < 10 * epsilon(1.0_C_DOUBLE))
      endif
    enddo
  enddo

#endif
END_TEST_E

TEST_E(LDWFortranZGEESReference)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx0, Cmplx1, CmplxI, SchurDecomposition
  use LDWFortranFunctionalSupport, only: DiagonalError, OrthonormalityError, &
                                         SchurResidualError, SpectrumError

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zgees

  real(C_DOUBLE), parameter :: &
    Tolerance = 100.0_C_DOUBLE * epsilon(1.0_C_DOUBLE)

  complex(C_DOUBLE_COMPLEX) :: A(3, 3), AOriginal(3, 3), U(3, 3), S(3, 3)
  complex(C_DOUBLE_COMPLEX) :: KnownE(3)

  real(C_DOUBLE) :: CongruenceError
  integer(C_INT) :: Info
  integer        :: i

  !Cyclic permutation matrix. It is unitary (hence normal), so its Schur
  !form is diagonal: the diagonal holds the cube roots of unity.
  A         = Cmplx0
  A(2, 1)   = Cmplx1
  A(3, 2)   = Cmplx1
  A(1, 3)   = Cmplx1
  AOriginal = A

  KnownE(1) = Cmplx1
  KnownE(2) = -0.5_C_DOUBLE * Cmplx1 + 0.5_C_DOUBLE * sqrt(3.0_C_DOUBLE) * CmplxI
  KnownE(3) = -0.5_C_DOUBLE * Cmplx1 - 0.5_C_DOUBLE * sqrt(3.0_C_DOUBLE) * CmplxI

  call SchurDecomposition(Dimension = 3_C_SIZE_T, &
                          Matrix = A, &
                          Unitary = U, &
                          SchurForm = S, &
                          ZGEESProcedure = zgees, &
                          Info = Info)

  ASSERT(Info == 0_C_INT)
  ASSERT(all(abs(A - AOriginal) <= 0.0_C_DOUBLE))
  ASSERT(OrthonormalityError(U, 3) < Tolerance)

  !A normal matrix has a diagonal Schur form, so this decomposition is a
  !diagonalization: every eigenvalue has modulus one.
  ASSERT(DiagonalError(S, 3) < Tolerance)
  do i = 1, 3
    ASSERT(abs(abs(S(i, i)) - 1.0_C_DOUBLE) < Tolerance)
  enddo

  !A*U = U*S and U^H*A*U = S.
  ASSERT(SchurResidualError(AOriginal, U, S, 3) < Tolerance)
  CongruenceError = maxval(abs(matmul(conjg(transpose(U)), &
                                      matmul(AOriginal, U)) - S))
  ASSERT(CongruenceError < Tolerance)

  ASSERT(SpectrumError(S, KnownE, 3) < Tolerance)

#endif
END_TEST_E

TEST_E(LDWFortranSVDReference)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx1, CmplxI, SVDDecomposition
  use LDWFortranFunctionalSupport, only: OrthonormalityError

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zgesdd

  real(C_DOUBLE), parameter :: &
    Tolerance = 100.0_C_DOUBLE * epsilon(1.0_C_DOUBLE)

  complex(C_DOUBLE_COMPLEX) :: A(3, 3), AOriginal(3, 3), U(3, 3), VH(3, 3)
  real(C_DOUBLE)            :: S(3)

  real(C_DOUBLE) :: CongruenceError
  integer(C_INT) :: Info

  !Dense and neither Hermitian nor normal: the factors can only come from
  !ZGESDD, not from a structural shortcut.
  A(1, :)   = [ 2*Cmplx1 + CmplxI, CmplxI, Cmplx1 - CmplxI]
  A(2, :)   = [-CmplxI, 3*Cmplx1, Cmplx1 + 2*CmplxI]
  A(3, :)   = [ CmplxI, 2*Cmplx1 - CmplxI, -2*Cmplx1]
  AOriginal = A

  call SVDDecomposition(DimensionR = 3_C_SIZE_T, &
                        DimensionC = 3_C_SIZE_T, &
                        Matrix = A, &
                        UnitaryU = U, &
                        DiagSigma = S, &
                        UnitaryVH = VH, &
                        ZGESDDProcedure = zgesdd, &
                        Info = Info)

  ASSERT(Info == 0_C_INT)
  !Matrix is an input-only argument and must not be overwritten.
  ASSERT(all(abs(A - AOriginal) <= 0.0_C_DOUBLE))

  !Both factors are unitary: the columns of U and the rows of VH are
  !orthonormal.
  ASSERT(OrthonormalityError(U, 3) < Tolerance)
  ASSERT(OrthonormalityError(conjg(transpose(VH)), 3) < Tolerance)

  !The singular values are real, non-negative and in ascending order
  !The matrix is non-singular, so no singular value vanishes.
  ASSERT(S(1) > 0.0_C_DOUBLE)
  ASSERT(S(1) <= S(2) .and. S(2) <= S(3))

  !Congruence: A = U*diag(S)*VH. Because S is reversed relative to the order
  !ZGESDD produces, this also checks that column j of U and row j of VH moved
  !with S(j).
  CongruenceError = maxval(abs(matmul(U * spread(S, 1, 3), VH) - AOriginal))
  ASSERT(CongruenceError < Tolerance)

#endif
END_TEST_E

TEST_E(LDWFortranZGGESReference)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx0, Cmplx1, CmplxI, &
                                    GeneralizedSchurDecomposition
  use LDWFortranFunctionalSupport, only: FourierUnitary, &
                                         GeneralizedSpectrumError, &
                                         OrthonormalityError, PairError, &
                                         UpperTriangularError

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zgges

  real(C_DOUBLE), parameter :: &
    Tolerance = 10000.0_C_DOUBLE * epsilon(1.0_C_DOUBLE)

  complex(C_DOUBLE_COMPLEX), parameter :: &
    KnownE(4) = [2.0_C_DOUBLE * Cmplx1, &
    3.0_C_DOUBLE*Cmplx1, &
    4.0_C_DOUBLE*Cmplx1, &
    5.0_C_DOUBLE*Cmplx1]

  complex(C_DOUBLE_COMPLEX) :: F(4, 4), Atri(4, 4), Btri(4, 4)
  complex(C_DOUBLE_COMPLEX) :: A(4, 4), B(4, 4)
  complex(C_DOUBLE_COMPLEX) :: AOriginal(4, 4), BOriginal(4, 4)
  complex(C_DOUBLE_COMPLEX) :: U(4, 4), VH(4, 4), EA(4), EB(4)
  complex(C_DOUBLE_COMPLEX) :: V(4, 4), S(4, 4), T(4, 4)
  integer(C_INT)            :: Info
  integer                   :: i

  !Triangular pair with the known generalized eigenvalues 2, 3, 4 and 5.
  Atri       = Cmplx0
  Atri(1, 1) = 2.0_C_DOUBLE * Cmplx1
  Atri(2, 2) = 6.0_C_DOUBLE * Cmplx1
  Atri(3, 3) = 12.0_C_DOUBLE * Cmplx1
  Atri(4, 4) = 20.0_C_DOUBLE * Cmplx1
  Atri(1, 2) = Cmplx1 + CmplxI
  Atri(2, 4) = 2.0_C_DOUBLE * Cmplx1 - CmplxI
  Atri(3, 4) = Cmplx1

  Btri       = Cmplx0
  Btri(1, 1) = Cmplx1
  Btri(2, 2) = 2.0_C_DOUBLE * Cmplx1
  Btri(3, 3) = 3.0_C_DOUBLE * Cmplx1
  Btri(4, 4) = 4.0_C_DOUBLE * Cmplx1
  Btri(1, 3) = CmplxI
  Btri(2, 3) = Cmplx1
  Btri(3, 4) = 2.0_C_DOUBLE * CmplxI

  !A unitary congruence preserves the generalized eigenvalues and makes the
  !pair dense, so the factors can only come from ZGGES.
  call FourierUnitary(F, 4)
  A         = matmul(F, matmul(Atri, conjg(transpose(F))))
  B         = matmul(F, matmul(Btri, conjg(transpose(F))))
  AOriginal = A
  BOriginal = B

  call GeneralizedSchurDecomposition(Dimension = 4_C_SIZE_T, &
                                     MatrixA = A, &
                                     MatrixB = B, &
                                     UnitaryU = U, &
                                     EigenvaluesA = EA, &
                                     EigenvaluesB = EB, &
                                     UnitaryVH = VH, &
                                     ZGGESProcedure = zgges, &
                                     Info = Info)

  ASSERT(Info == 0_C_INT)
  !MatrixA and MatrixB are input-only and must not be overwritten.
  ASSERT(all(abs(A - AOriginal) <= 0.0_C_DOUBLE))
  ASSERT(all(abs(B - BOriginal) <= 0.0_C_DOUBLE))

  !Both factors are unitary: the columns of U and V are orthonormal.
  ASSERT(OrthonormalityError(U, 4) < Tolerance)
  ASSERT(OrthonormalityError(conjg(transpose(VH)), 4) < Tolerance)
  ASSERT(GeneralizedSpectrumError(EA, EB, KnownE, 4) < Tolerance)

  V = conjg(transpose(VH))
  S = matmul(conjg(transpose(U)), matmul(AOriginal, V))
  T = matmul(conjg(transpose(U)), matmul(BOriginal, V))

  !S and T are upper triangular with a real, non-negative diagonal in T, and
  !A = U*S*V^H, B = U*T*V^H.
  ASSERT(UpperTriangularError(S, 4) < Tolerance)
  ASSERT(UpperTriangularError(T, 4) < Tolerance)
  ASSERT(maxval(abs(matmul(U, matmul(S, VH)) - AOriginal)) < Tolerance)
  ASSERT(maxval(abs(matmul(U, matmul(T, VH)) - BOriginal)) < Tolerance)

  do i = 1, 4
    ASSERT(abs(aimag(T(i, i))) < Tolerance)
    ASSERT(real(T(i, i)) >= 0.0_C_DOUBLE)
  enddo

  !The returned pairs are the diagonal of the Schur forms, compared entry by
  !entry without forming a quotient.
  ASSERT(PairError(EA, EB, S, T, 4) < Tolerance)

#endif
END_TEST_E

TEST_E(LDWFortranDegeneracyGroupReference)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_SIZE_T, &
                                    DegeneracyGroup

  implicit none
  TSD_TEST_E_INTERFACES

  real(C_DOUBLE)    :: E(9)
  integer(C_SIZE_T) :: D(9)

  E = real([0.0, 0.2, 0.5, 0.9, 0.95, 1.1, 1.2, 7.1, 7.2], C_DOUBLE)

  call DegeneracyGroup(9_C_SIZE_T, E, 0.3_C_DOUBLE, D)

  ASSERT(all(D == int([3, 0, 0, 4, 0, 0, 0, 2, 0], C_SIZE_T)))

#endif
END_TEST_E

