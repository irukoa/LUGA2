TEST_E(LDWFortranSVDNominal1x1)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx1, CmplxI, SVDDecomposition
  use LDWFortranFunctionalSupport, only: SVResidualError

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zgesdd

  real(C_DOUBLE), parameter :: &
    Tolerance = 100.0_C_DOUBLE * epsilon(1.0_C_DOUBLE)

  complex(C_DOUBLE_COMPLEX) :: A(1, 1), U(1, 1), VH(1, 1)
  real(C_DOUBLE)            :: S(1)
  integer(C_INT)            :: Info

  !Smallest dimension: the workspace query returns the minimum size and the
  !single singular value is the modulus of the entry.
  A(1, 1) = -3.5_C_DOUBLE * Cmplx1 + 2.0_C_DOUBLE * CmplxI

  call SVDDecomposition(DimensionR = 1_C_SIZE_T, &
                        DimensionC = 1_C_SIZE_T, &
                        Matrix = A, &
                        UnitaryU = U, &
                        DiagSigma = S, &
                        UnitaryVH = VH, &
                        ZGESDDProcedure = zgesdd, &
                        Info = Info)

  ASSERT(Info == 0_C_INT)
  ASSERT(abs(S(1) - sqrt(16.25_C_DOUBLE)) < Tolerance)
  ASSERT(abs(abs(U(1, 1)) - 1.0_C_DOUBLE) < Tolerance)
  ASSERT(abs(abs(VH(1, 1)) - 1.0_C_DOUBLE) < Tolerance)
  ASSERT(SVResidualError(A, U, S, VH, 1, 1) < Tolerance)

#endif
END_TEST_E

TEST_E(LDWFortranSVDNominal2x2)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx0, Cmplx1, SVDDecomposition
  use LDWFortranFunctionalSupport, only: OrthonormalityError, SVResidualError

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zgesdd

  real(C_DOUBLE), parameter :: &
    Tolerance = 100.0_C_DOUBLE * epsilon(1.0_C_DOUBLE)

  complex(C_DOUBLE_COMPLEX) :: A(2, 2), AOriginal(2, 2), U(2, 2), VH(2, 2)
  real(C_DOUBLE)            :: S(2)
  integer(C_INT)            :: Info

  !The singular values are 3 and 4. ZGESDD reports them descending, so this
  !only holds when the wrapper reverses the sequence.
  A(1, :)   = [3.0_C_DOUBLE*Cmplx1, Cmplx0]
  A(2, :)   = [Cmplx0, -4.0_C_DOUBLE*Cmplx1]
  AOriginal = A

  call SVDDecomposition(DimensionR = 2_C_SIZE_T, &
                        DimensionC = 2_C_SIZE_T, &
                        Matrix = A, &
                        UnitaryU = U, &
                        DiagSigma = S, &
                        UnitaryVH = VH, &
                        ZGESDDProcedure = zgesdd, &
                        Info = Info)

  ASSERT(Info == 0_C_INT)
  !Matrix is an input-only argument and must not be overwritten.
  ASSERT(all(abs(A - AOriginal) <= 0.0_C_DOUBLE))

  ASSERT(abs(S(1) - 3.0_C_DOUBLE) < Tolerance)
  ASSERT(abs(S(2) - 4.0_C_DOUBLE) < Tolerance)

  !Both factors are unitary: the columns of U and the rows of VH are
  !orthonormal.
  ASSERT(OrthonormalityError(U, 2) < Tolerance)
  ASSERT(OrthonormalityError(conjg(transpose(VH)), 2) < Tolerance)

  ASSERT(SVResidualError(AOriginal, U, S, VH, 2, 2) < Tolerance)

#endif
END_TEST_E

TEST_E(LDWFortranSVDNominalRankDeficient)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx1, SVDDecomposition
  use LDWFortranFunctionalSupport, only: SVResidualError

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zgesdd

  real(C_DOUBLE), parameter :: &
    Tolerance = 100.0_C_DOUBLE * epsilon(1.0_C_DOUBLE)

  complex(C_DOUBLE_COMPLEX) :: A(3, 3), AOriginal(3, 3), U(3, 3), VH(3, 3)
  real(C_DOUBLE)            :: S(3)
  integer(C_INT)            :: Info

  !Rank one: A = u*v^H with u = [1, 2, 3] and v = [1, 1, 1], so the singular
  !values are 0, 0 and sqrt(14*3) = sqrt(42). The ascending order puts the
  !zeros first.
  A(1, :)   = [Cmplx1, Cmplx1, Cmplx1]
  A(2, :)   = [2.0_C_DOUBLE*Cmplx1, 2.0_C_DOUBLE*Cmplx1, 2.0_C_DOUBLE*Cmplx1]
  A(3, :)   = [3.0_C_DOUBLE*Cmplx1, 3.0_C_DOUBLE*Cmplx1, 3.0_C_DOUBLE*Cmplx1]
  AOriginal = A

  call SVDDecomposition(DimensionR = 3_C_SIZE_T, &
                        DimensionC = 3_C_SIZE_T, &
                        Matrix = A, &
                        UnitaryU = U, &
                        DiagSigma = S, &
                        UnitaryVH = VH, &
                        ZGESDDProcedure = zgesdd, &
                        Info = Info)

  ASSERT(Info == 0_C_INT)
  ASSERT(all(abs(A - AOriginal) <= 0.0_C_DOUBLE))

  ASSERT(abs(S(1)) < Tolerance)
  ASSERT(abs(S(2)) < Tolerance)
  ASSERT(abs(S(3) - sqrt(42.0_C_DOUBLE)) < Tolerance)

  !The factors of a rank-deficient matrix are still unitary, so the
  !decomposition remains exact up to rounding.
  ASSERT(SVResidualError(AOriginal, U, S, VH, 3, 3) < Tolerance)

#endif
END_TEST_E

TEST_E(LDWFortranSVDNominalTall)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx0, Cmplx1, SVDDecomposition
  use LDWFortranFunctionalSupport, only: OrthonormalityError, SVResidualError

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zgesdd

  real(C_DOUBLE), parameter :: &
    Tolerance = 100.0_C_DOUBLE * epsilon(1.0_C_DOUBLE)

  complex(C_DOUBLE_COMPLEX) :: A(4, 2), AOriginal(4, 2), U(4, 4), VH(2, 2)
  real(C_DOUBLE)            :: S(2)
  integer(C_INT)            :: Info

  !Orthogonal columns with squared norms 10 and 20, so the singular values
  !are sqrt(10) and sqrt(20) in ascending order.
  A(1, :)   = [Cmplx1, Cmplx0]
  A(2, :)   = [Cmplx0, 2.0_C_DOUBLE*Cmplx1]
  A(3, :)   = [3.0_C_DOUBLE*Cmplx1, Cmplx0]
  A(4, :)   = [Cmplx0, 4.0_C_DOUBLE*Cmplx1]
  AOriginal = A

  call SVDDecomposition(DimensionR = 4_C_SIZE_T, &
                        DimensionC = 2_C_SIZE_T, &
                        Matrix = A, &
                        UnitaryU = U, &
                        DiagSigma = S, &
                        UnitaryVH = VH, &
                        ZGESDDProcedure = zgesdd, &
                        Info = Info)

  ASSERT(Info == 0_C_INT)
  ASSERT(all(abs(A - AOriginal) <= 0.0_C_DOUBLE))

  ASSERT(abs(S(1) - sqrt(10.0_C_DOUBLE)) < Tolerance)
  ASSERT(abs(S(2) - sqrt(20.0_C_DOUBLE)) < Tolerance)

  !U is 4x4 and VH is 2x2: both are unitary, including the two columns of U
  !which do not take part in the product.
  ASSERT(OrthonormalityError(U, 4) < Tolerance)
  ASSERT(OrthonormalityError(conjg(transpose(VH)), 2) < Tolerance)

  ASSERT(SVResidualError(AOriginal, U, S, VH, 4, 2) < Tolerance)

#endif
END_TEST_E

TEST_E(LDWFortranSVDNominalWide)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx0, Cmplx1, SVDDecomposition
  use LDWFortranFunctionalSupport, only: OrthonormalityError, SVResidualError

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zgesdd

  real(C_DOUBLE), parameter :: &
    Tolerance = 100.0_C_DOUBLE * epsilon(1.0_C_DOUBLE)

  complex(C_DOUBLE_COMPLEX) :: A(2, 4), AOriginal(2, 4), U(2, 2), VH(4, 4)
  real(C_DOUBLE)            :: S(2)
  integer(C_INT)            :: Info

  !The transposed counterpart of the tall case: the rows are orthogonal and
  !the singular values are sqrt(10) and sqrt(20).
  A(1, :)   = [Cmplx1, Cmplx0, 3.0_C_DOUBLE*Cmplx1, Cmplx0]
  A(2, :)   = [Cmplx0, 2.0_C_DOUBLE*Cmplx1, Cmplx0, 4.0_C_DOUBLE*Cmplx1]
  AOriginal = A

  call SVDDecomposition(DimensionR = 2_C_SIZE_T, &
                        DimensionC = 4_C_SIZE_T, &
                        Matrix = A, &
                        UnitaryU = U, &
                        DiagSigma = S, &
                        UnitaryVH = VH, &
                        ZGESDDProcedure = zgesdd, &
                        Info = Info)

  ASSERT(Info == 0_C_INT)
  ASSERT(all(abs(A - AOriginal) <= 0.0_C_DOUBLE))

  ASSERT(abs(S(1) - sqrt(10.0_C_DOUBLE)) < Tolerance)
  ASSERT(abs(S(2) - sqrt(20.0_C_DOUBLE)) < Tolerance)

  !U is 2x2 and VH is 4x4: both are unitary, including the two rows of VH
  !which do not take part in the product.
  ASSERT(OrthonormalityError(U, 2) < Tolerance)
  ASSERT(OrthonormalityError(conjg(transpose(VH)), 4) < Tolerance)

  ASSERT(SVResidualError(AOriginal, U, S, VH, 2, 4) < Tolerance)

#endif
END_TEST_E

TEST_E(LDWFortranSVDNominalNoDiagSigma)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx1, CmplxI, SVDDecomposition
  use LDWFortranFunctionalSupport, only: OrthonormalityError

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zgesdd

  real(C_DOUBLE), parameter :: &
    Tolerance = 100.0_C_DOUBLE * epsilon(1.0_C_DOUBLE)

  complex(C_DOUBLE_COMPLEX) :: A(3, 3), AOriginal(3, 3), U(3, 3), VH(3, 3)
  complex(C_DOUBLE_COMPLEX) :: Sigma(3, 3)
  integer(C_INT)            :: Info
  integer                   :: i, j

  !Omitting the optional DiagSigma must not change the computation. The
  !matrix is the one used by the reference test.
  A(1, :)   = [ 2*Cmplx1 + CmplxI, CmplxI, Cmplx1 - CmplxI]
  A(2, :)   = [-CmplxI, 3*Cmplx1, Cmplx1 + 2*CmplxI]
  A(3, :)   = [ CmplxI, 2*Cmplx1 - CmplxI, -2*Cmplx1]
  AOriginal = A

  call SVDDecomposition(DimensionR = 3_C_SIZE_T, &
                        DimensionC = 3_C_SIZE_T, &
                        Matrix = A, &
                        UnitaryU = U, &
                        UnitaryVH = VH, &
                        ZGESDDProcedure = zgesdd, &
                        Info = Info)

  ASSERT(Info == 0_C_INT)
  ASSERT(all(abs(A - AOriginal) <= 0.0_C_DOUBLE))

  !Without DiagSigma the singular values are not returned, but U^H*A*V must
  !still be diagonal, non-negative and ascending. V is the adjoint of VH.
  Sigma = matmul(conjg(transpose(U)), &
                 matmul(AOriginal, conjg(transpose(VH))))

  do j = 1, 3
    do i = 1, 3
      if (i == j) then
        ASSERT(real(Sigma(i, j), C_DOUBLE) >= -Tolerance)
      else
        ASSERT(abs(Sigma(i, j)) < Tolerance)
      endif
    enddo
  enddo

  ASSERT(real(Sigma(1, 1), C_DOUBLE) <= real(Sigma(2, 2), C_DOUBLE))
  ASSERT(real(Sigma(2, 2), C_DOUBLE) <= real(Sigma(3, 3), C_DOUBLE))

  ASSERT(OrthonormalityError(U, 3) < Tolerance)
  ASSERT(OrthonormalityError(conjg(transpose(VH)), 3) < Tolerance)

#endif
END_TEST_E

TEST_E(LDWFortranSVDFastReturn)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: INT32, C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx1, SVDDecomposition
  use LDWFortranFunctionalSupport, only: ResetZGESDDStub, &
                                         GetZGESDDStubCalls, ZGESDDStub

  implicit none
  TSD_TEST_E_INTERFACES

  complex(C_DOUBLE_COMPLEX) :: A(1, 1), U(1, 1), VH(1, 1)
  real(C_DOUBLE)            :: S(1)
  integer(C_INT)            :: Info
  integer(INT32)            :: Queries, Computations

  A  = 42 * Cmplx1
  U  = 42 * Cmplx1
  S  = 42.0_C_DOUBLE
  VH = 42 * Cmplx1

  call ResetZGESDDStub()

  !Dimension zero is a fast return: the deferred procedure is never called
  !and the output arguments are left untouched.
  call SVDDecomposition(DimensionR = 0_C_SIZE_T, &
                        DimensionC = 0_C_SIZE_T, &
                        Matrix = A, &
                        UnitaryU = U, &
                        DiagSigma = S, &
                        UnitaryVH = VH, &
                        ZGESDDProcedure = ZGESDDStub, &
                        Info = Info)

  ASSERT(Info == 0_C_INT)
  ASSERT(all(abs(U - 42 * Cmplx1) <= 0.0_C_DOUBLE))
  ASSERT(all(abs(S - 42.0_C_DOUBLE) <= 0.0_C_DOUBLE))
  ASSERT(all(abs(VH - 42 * Cmplx1) <= 0.0_C_DOUBLE))

  call GetZGESDDStubCalls(Queries, Computations)
  ASSERT(Queries == 0_INT32)
  ASSERT(Computations == 0_INT32)

#endif
END_TEST_E

TEST_E(LDWFortranSVDTooLarge)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: INT32, C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx1, SVDDecomposition
  use LDWFortranFunctionalSupport, only: ResetZGESDDStub, &
                                         GetZGESDDStubCalls, ZGESDDStub

  implicit none
  TSD_TEST_E_INTERFACES

  complex(C_DOUBLE_COMPLEX) :: A(1, 1), U(1, 1), VH(1, 1)
  real(C_DOUBLE)            :: S(1)
  integer(C_INT)            :: Info
  integer(INT32)            :: Queries, Computations

  A  = 42 * Cmplx1
  U  = 42 * Cmplx1
  S  = 42.0_C_DOUBLE
  VH = 42 * Cmplx1

  call ResetZGESDDStub()

  !Dimensions beyond the LAPACK integer range are rejected before any buffer
  !is allocated or the deferred procedure is called.
  call SVDDecomposition(DimensionR = int(huge(1_INT32), C_SIZE_T) + 1_C_SIZE_T, &
                        DimensionC = 1_C_SIZE_T, &
                        Matrix = A, &
                        UnitaryU = U, &
                        DiagSigma = S, &
                        UnitaryVH = VH, &
                        ZGESDDProcedure = ZGESDDStub, &
                        Info = Info)

  ASSERT(Info == int(huge(1_INT32), C_INT))
  ASSERT(all(abs(U - 42 * Cmplx1) <= 0.0_C_DOUBLE))
  ASSERT(all(abs(S - 42.0_C_DOUBLE) <= 0.0_C_DOUBLE))
  ASSERT(all(abs(VH - 42 * Cmplx1) <= 0.0_C_DOUBLE))

  call GetZGESDDStubCalls(Queries, Computations)
  ASSERT(Queries == 0_INT32)
  ASSERT(Computations == 0_INT32)

#endif
END_TEST_E

TEST_E(LDWFortranSVDFailWorkspaceQuery)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: INT32, C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx1, SVDDecomposition
  use LDWFortranFunctionalSupport, only: &
    LDWStubFailingQuery, ResetZGESDDStub, SetZGESDDStubStatus, &
    GetZGESDDStubCalls, ZGESDDStub

  implicit none
  TSD_TEST_E_INTERFACES

  complex(C_DOUBLE_COMPLEX) :: A(3, 3), U(3, 3), VH(3, 3)
  real(C_DOUBLE)            :: S(3)
  integer(C_INT)            :: Info
  integer(INT32)            :: Queries, Computations

  A  = 0 * Cmplx1
  U  = 42 * Cmplx1
  S  = 42.0_C_DOUBLE
  VH = 42 * Cmplx1

  call ResetZGESDDStub()
  call SetZGESDDStubStatus(LDWStubFailingQuery, 0_INT32)

  !A failing workspace query is propagated unchanged and the computational
  !call is never made. The outputs are left untouched.
  call SVDDecomposition(DimensionR = 3_C_SIZE_T, &
                        DimensionC = 3_C_SIZE_T, &
                        Matrix = A, &
                        UnitaryU = U, &
                        DiagSigma = S, &
                        UnitaryVH = VH, &
                        ZGESDDProcedure = ZGESDDStub, &
                        Info = Info)

  ASSERT(Info == int(LDWStubFailingQuery, C_INT))
  ASSERT(all(abs(U - 42 * Cmplx1) <= 0.0_C_DOUBLE))
  ASSERT(all(abs(S - 42.0_C_DOUBLE) <= 0.0_C_DOUBLE))
  ASSERT(all(abs(VH - 42 * Cmplx1) <= 0.0_C_DOUBLE))

  call GetZGESDDStubCalls(Queries, Computations)
  ASSERT(Queries == 1_INT32)
  ASSERT(Computations == 0_INT32)

#endif
END_TEST_E

