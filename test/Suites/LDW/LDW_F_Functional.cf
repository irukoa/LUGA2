TEST_E(LDWFortranZGGESNominal1x1)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    GeneralizedSchurDecomposition
  use LDWFortranFunctionalSupport, only: GeneralizedSpectrumError, PairError

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zgges

  real(C_DOUBLE), parameter :: &
    Tolerance = 100.0_C_DOUBLE * epsilon(1.0_C_DOUBLE)

  complex(C_DOUBLE_COMPLEX) :: A(1, 1), B(1, 1), U(1, 1), VH(1, 1)
  complex(C_DOUBLE_COMPLEX) :: EA(1), EB(1), S(1, 1), T(1, 1), V(1, 1)
  integer(C_INT)            :: Info

  A(1, 1) = cmplx(2.0_C_DOUBLE, 0.0_C_DOUBLE, C_DOUBLE_COMPLEX)
  B(1, 1) = cmplx(3.0_C_DOUBLE, 1.0_C_DOUBLE, C_DOUBLE_COMPLEX)

  !Smallest dimension: the workspace query returns the minimum size.
  call GeneralizedSchurDecomposition(Dimension = 1_C_SIZE_T, &
                                     MatrixA = A, &
                                     MatrixB = B, &
                                     UnitaryU = U, &
                                     EigenvaluesA = EA, &
                                     EigenvaluesB = EB, &
                                     UnitaryVH = VH, &
                                     ZGGESProcedure = zgges, &
                                     Info = Info)

  ASSERT(Info == 0_C_INT)
  ASSERT(abs(abs(U(1, 1)) - 1.0_C_DOUBLE) < Tolerance)
  ASSERT(abs(abs(VH(1, 1)) - 1.0_C_DOUBLE) < Tolerance)

  !The generalized eigenvalue is the ratio of the returned pair.
  ASSERT(GeneralizedSpectrumError(EA, EB, [A(1, 1)/B(1, 1)], 1) < Tolerance)

  !The reconstructed Schur forms satisfy U^H*A*V = S, U^H*B*V = T with a
  !real, non-negative diagonal for T.
  V = conjg(transpose(VH))
  S = matmul(conjg(transpose(U)), matmul(A, V))
  T = matmul(conjg(transpose(U)), matmul(B, V))

  ASSERT(abs(S(1, 1) / T(1, 1) - A(1, 1) / B(1, 1)) < Tolerance)
  ASSERT(abs(aimag(T(1, 1))) < Tolerance)
  ASSERT(real(T(1, 1)) >= 0.0_C_DOUBLE)

  !The returned pair is the diagonal of the Schur forms, compared without
  !forming a quotient.
  ASSERT(PairError(EA, EB, S, T, 1) < Tolerance)

#endif
END_TEST_E

TEST_E(LDWFortranZGGESNominal2x2)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx0, Cmplx1, &
                                    GeneralizedSchurDecomposition
  use LDWFortranFunctionalSupport, only: GeneralizedSpectrumError, &
                                         OrthonormalityError, PairError, &
                                         UpperTriangularError

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zgges

  real(C_DOUBLE), parameter :: &
    Tolerance = 100.0_C_DOUBLE * epsilon(1.0_C_DOUBLE)

  complex(C_DOUBLE_COMPLEX), parameter :: &
    KnownE(2) = [0.5_C_DOUBLE*Cmplx1, 2.0_C_DOUBLE*Cmplx1]

  complex(C_DOUBLE_COMPLEX) :: A(2, 2), B(2, 2), U(2, 2), VH(2, 2)
  complex(C_DOUBLE_COMPLEX) :: EA(2), EB(2), V(2, 2), S(2, 2), T(2, 2)
  integer(C_INT)            :: Info

  !Diagonal pair: the generalized eigenvalues are 1/2 and 2.
  A       = Cmplx0
  A(1, 1) = Cmplx1
  A(2, 2) = 2.0_C_DOUBLE * Cmplx1
  B       = Cmplx0
  B(1, 1) = 2.0_C_DOUBLE * Cmplx1
  B(2, 2) = Cmplx1

  call GeneralizedSchurDecomposition(Dimension = 2_C_SIZE_T, &
                                     MatrixA = A, &
                                     MatrixB = B, &
                                     UnitaryU = U, &
                                     EigenvaluesA = EA, &
                                     EigenvaluesB = EB, &
                                     UnitaryVH = VH, &
                                     ZGGESProcedure = zgges, &
                                     Info = Info)

  ASSERT(Info == 0_C_INT)
  ASSERT(OrthonormalityError(U, 2) < Tolerance)
  ASSERT(OrthonormalityError(conjg(transpose(VH)), 2) < Tolerance)
  ASSERT(GeneralizedSpectrumError(EA, EB, KnownE, 2) < Tolerance)

  !Both Schur forms are upper triangular and diag(T) is real, non-negative.
  V = conjg(transpose(VH))
  S = matmul(conjg(transpose(U)), matmul(A, V))
  T = matmul(conjg(transpose(U)), matmul(B, V))

  ASSERT(UpperTriangularError(S, 2) < Tolerance)
  ASSERT(UpperTriangularError(T, 2) < Tolerance)
  ASSERT(maxval(abs(aimag([T(1, 1), T(2, 2)]))) < Tolerance)
  ASSERT(minval(real([T(1, 1), T(2, 2)])) >= 0.0_C_DOUBLE)

  !The returned pairs are the diagonal of the Schur forms.
  ASSERT(PairError(EA, EB, S, T, 2) < Tolerance)

#endif
END_TEST_E

TEST_E(LDWFortranZGGESNominal4x4)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx0, Cmplx1, CmplxI, &
                                    GeneralizedSchurDecomposition
  use LDWFortranFunctionalSupport, only: GeneralizedSpectrumError, &
                                         OrthonormalityError, PairError, &
                                         UpperTriangularError

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zgges

  real(C_DOUBLE), parameter :: &
    Tolerance = 1000.0_C_DOUBLE * epsilon(1.0_C_DOUBLE)

  complex(C_DOUBLE_COMPLEX), parameter :: &
    KnownE(4) = [2.0_C_DOUBLE * Cmplx1, &
    3.0_C_DOUBLE*Cmplx1, &
    4.0_C_DOUBLE*Cmplx1, &
    5.0_C_DOUBLE*Cmplx1]

  complex(C_DOUBLE_COMPLEX) :: A(4, 4), B(4, 4), U(4, 4), VH(4, 4)
  complex(C_DOUBLE_COMPLEX) :: EA(4), EB(4), V(4, 4), S(4, 4), T(4, 4)
  integer(C_INT)            :: Info
  integer                   :: i

  !Triangular pair with non-trivial upper triangles. The generalized
  !eigenvalues are the ratios of the diagonals: 2, 3, 4 and 5.
  A       = Cmplx0
  A(1, 1) = 2.0_C_DOUBLE * Cmplx1
  A(2, 2) = 6.0_C_DOUBLE * Cmplx1
  A(3, 3) = 12.0_C_DOUBLE * Cmplx1
  A(4, 4) = 20.0_C_DOUBLE * Cmplx1
  A(1, 2) = Cmplx1 + CmplxI
  A(2, 3) = 2.0_C_DOUBLE * Cmplx1
  A(3, 4) = 3.0_C_DOUBLE * Cmplx1 - CmplxI

  B       = Cmplx0
  B(1, 1) = Cmplx1
  B(2, 2) = 2.0_C_DOUBLE * Cmplx1
  B(3, 3) = 3.0_C_DOUBLE * Cmplx1
  B(4, 4) = 4.0_C_DOUBLE * Cmplx1
  B(1, 2) = CmplxI
  B(2, 3) = Cmplx1
  B(3, 4) = 2.0_C_DOUBLE * CmplxI

  call GeneralizedSchurDecomposition(Dimension = 4_C_SIZE_T, &
                                     MatrixA = A, &
                                     MatrixB = B, &
                                     UnitaryU = U, &
                                     EigenvaluesA = EA, &
                                     EigenvaluesB = EB, &
                                     UnitaryVH = VH, &
                                     ZGGESProcedure = zgges, &
                                     Info = Info)

  ASSERT(Info == 0_C_INT)
  ASSERT(OrthonormalityError(U, 4) < Tolerance)
  ASSERT(OrthonormalityError(conjg(transpose(VH)), 4) < Tolerance)
  ASSERT(GeneralizedSpectrumError(EA, EB, KnownE, 4) < Tolerance)

  V = conjg(transpose(VH))
  S = matmul(conjg(transpose(U)), matmul(A, V))
  T = matmul(conjg(transpose(U)), matmul(B, V))

  ASSERT(UpperTriangularError(S, 4) < Tolerance)
  ASSERT(UpperTriangularError(T, 4) < Tolerance)
  do i = 1, 4
    ASSERT(abs(aimag(T(i, i))) < Tolerance)
    ASSERT(real(T(i, i)) >= 0.0_C_DOUBLE)
  enddo

  !The returned pairs are the diagonal of the Schur forms.
  ASSERT(PairError(EA, EB, S, T, 4) < Tolerance)

#endif
END_TEST_E

TEST_E(LDWFortranZGGESNominalComplex)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx1, CmplxI, &
                                    GeneralizedSchurDecomposition
  use LDWFortranFunctionalSupport, only: DiagonalError, FourierUnitary, &
                                         GeneralizedSpectrumError, &
                                         OrthonormalityError, PairError

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zgges

  real(C_DOUBLE), parameter :: &
    Tolerance = 1000.0_C_DOUBLE * epsilon(1.0_C_DOUBLE)

  complex(C_DOUBLE_COMPLEX), parameter :: &
    KnownE(3) = [Cmplx1 + CmplxI, 2.0_C_DOUBLE * Cmplx1 - CmplxI, &
    3.0_C_DOUBLE*Cmplx1]

  complex(C_DOUBLE_COMPLEX) :: A(3, 3), B(3, 3), U(3, 3), VH(3, 3)
  complex(C_DOUBLE_COMPLEX) :: EA(3), EB(3), F(3, 3), D(3, 3)
  complex(C_DOUBLE_COMPLEX) :: V(3, 3), S(3, 3), T(3, 3)
  integer(C_INT)            :: Info
  integer                   :: i

  !Dense and non-triangular: A is a unitary similarity of a diagonal matrix,
  !so it is normal with the known spectrum, while B is the identity.
  call FourierUnitary(F, 3)
  D = cmplx(0.0_C_DOUBLE, 0.0_C_DOUBLE, C_DOUBLE_COMPLEX)
  do i = 1, 3
    D(i, i) = KnownE(i)
  enddo
  A = matmul(F, matmul(D, conjg(transpose(F))))
  B = cmplx(0.0_C_DOUBLE, 0.0_C_DOUBLE, C_DOUBLE_COMPLEX)
  do i = 1, 3
    B(i, i) = Cmplx1
  enddo

  call GeneralizedSchurDecomposition(Dimension = 3_C_SIZE_T, &
                                     MatrixA = A, &
                                     MatrixB = B, &
                                     UnitaryU = U, &
                                     EigenvaluesA = EA, &
                                     EigenvaluesB = EB, &
                                     UnitaryVH = VH, &
                                     ZGGESProcedure = zgges, &
                                     Info = Info)

  ASSERT(Info == 0_C_INT)
  ASSERT(OrthonormalityError(U, 3) < Tolerance)
  ASSERT(OrthonormalityError(conjg(transpose(VH)), 3) < Tolerance)
  ASSERT(GeneralizedSpectrumError(EA, EB, KnownE, 3) < Tolerance)

  !With B = I the generalized Schur form is the ordinary Schur form: S is
  !diagonal because A is normal, and T = U^H V is unitary and upper
  !triangular with a positive real diagonal, hence the identity.
  V = conjg(transpose(VH))
  S = matmul(conjg(transpose(U)), matmul(A, V))
  T = matmul(conjg(transpose(U)), matmul(B, V))

  ASSERT(DiagonalError(S, 3) < Tolerance)
  ASSERT(DiagonalError(T, 3) < Tolerance)
  do i = 1, 3
    ASSERT(abs(T(i, i) - Cmplx1) < Tolerance)
  enddo

  !The returned pairs are the diagonal of the Schur forms, i.e. the known
  !eigenvalues up to the ordering chosen by LAPACK.
  ASSERT(PairError(EA, EB, S, T, 3) < Tolerance)

#endif
END_TEST_E

TEST_E(LDWFortranZGGESNominalCongruence)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx0, Cmplx1, CmplxI, &
                                    GeneralizedSchurDecomposition
  use LDWFortranFunctionalSupport, only: OrthonormalityError, PairError, &
                                         UpperTriangularError

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zgges

  real(C_DOUBLE), parameter :: &
    Tolerance = 1000.0_C_DOUBLE * epsilon(1.0_C_DOUBLE)

  complex(C_DOUBLE_COMPLEX) :: A(3, 3), B(3, 3), U(3, 3), VH(3, 3)
  complex(C_DOUBLE_COMPLEX) :: EA(3), EB(3), V(3, 3), S(3, 3), T(3, 3)
  integer(C_INT)            :: Info
  integer                   :: i

  !Arbitrary dense pair: it is neither triangular nor normal, so both Schur
  !forms have a non-trivial upper triangle.
  A(1, :) = [Cmplx1 + CmplxI, 2.0_C_DOUBLE*Cmplx1, -CmplxI]
  A(2, :) = [Cmplx0, 3.0_C_DOUBLE*Cmplx1 - CmplxI, Cmplx1]
  A(3, :) = [2.0_C_DOUBLE*CmplxI, Cmplx1, 4.0_C_DOUBLE*Cmplx1]

  B(1, :) = [2.0_C_DOUBLE*Cmplx1, CmplxI, Cmplx0]
  B(2, :) = [Cmplx1, 3.0_C_DOUBLE*Cmplx1, Cmplx1 - CmplxI]
  B(3, :) = [Cmplx0, 2.0_C_DOUBLE*CmplxI, 5.0_C_DOUBLE*Cmplx1]

  call GeneralizedSchurDecomposition(Dimension = 3_C_SIZE_T, &
                                     MatrixA = A, &
                                     MatrixB = B, &
                                     UnitaryU = U, &
                                     EigenvaluesA = EA, &
                                     EigenvaluesB = EB, &
                                     UnitaryVH = VH, &
                                     ZGGESProcedure = zgges, &
                                     Info = Info)

  ASSERT(Info == 0_C_INT)
  ASSERT(OrthonormalityError(U, 3) < Tolerance)
  ASSERT(OrthonormalityError(conjg(transpose(VH)), 3) < Tolerance)

  V = conjg(transpose(VH))
  S = matmul(conjg(transpose(U)), matmul(A, V))
  T = matmul(conjg(transpose(U)), matmul(B, V))

  !Both Schur forms are upper triangular with a real, non-negative diagonal
  !in T, and they reproduce the input pair through the unitary factors.
  ASSERT(UpperTriangularError(S, 3) < Tolerance)
  ASSERT(UpperTriangularError(T, 3) < Tolerance)
  ASSERT(maxval(abs(matmul(U, matmul(S, VH)) - A)) < Tolerance)
  ASSERT(maxval(abs(matmul(U, matmul(T, VH)) - B)) < Tolerance)

  do i = 1, 3
    ASSERT(abs(aimag(T(i, i))) < Tolerance)
    ASSERT(real(T(i, i)) >= 0.0_C_DOUBLE)
  enddo

  !The returned pairs are the diagonal of the Schur forms. The comparison is
  !made pair by pair, so no quotient is formed and a vanishing Beta needs no
  !special case.
  ASSERT(PairError(EA, EB, S, T, 3) < Tolerance)

#endif
END_TEST_E

TEST_E(LDWFortranZGGESNominalInfiniteEigenvalue)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx0, Cmplx1, &
                                    GeneralizedSchurDecomposition
  use LDWFortranFunctionalSupport, only: GeneralizedSchurForms, &
                                         OrthonormalityError, PairError, &
                                         UpperTriangularError

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zgges

  real(C_DOUBLE), parameter :: &
    Tolerance = 1000.0_C_DOUBLE * epsilon(1.0_C_DOUBLE)

  complex(C_DOUBLE_COMPLEX) :: A(2, 2), B(2, 2), U(2, 2), VH(2, 2)
  complex(C_DOUBLE_COMPLEX) :: EA(2), EB(2), S(2, 2), T(2, 2)
  integer(C_INT)            :: Info, Found, i

  !Singular B: the pair has one finite eigenvalue (2) and one infinite one,
  !which LAPACK encodes as Beta == 0.
  A       = Cmplx0
  A(1, 1) = 2.0_C_DOUBLE * Cmplx1
  A(2, 2) = 3.0_C_DOUBLE * Cmplx1
  B       = Cmplx0
  B(1, 1) = Cmplx1

  call GeneralizedSchurDecomposition(Dimension = 2_C_SIZE_T, &
                                     MatrixA = A, &
                                     MatrixB = B, &
                                     UnitaryU = U, &
                                     EigenvaluesA = EA, &
                                     EigenvaluesB = EB, &
                                     UnitaryVH = VH, &
                                     ZGGESProcedure = zgges, &
                                     Info = Info)

  ASSERT(Info == 0_C_INT)
  ASSERT(OrthonormalityError(U, 2) < Tolerance)
  ASSERT(OrthonormalityError(conjg(transpose(VH)), 2) < Tolerance)

  !Exactly one denominator vanishes; the other pair carries the ratio 2.
  ASSERT(count(abs(EB) <= 0.0_C_DOUBLE) == 1)

  call GeneralizedSchurForms(A, B, U, VH, S, T, 2)

  ASSERT(UpperTriangularError(S, 2) < Tolerance)
  ASSERT(UpperTriangularError(T, 2) < Tolerance)

  !The pairs reproduce the diagonal of the Schur forms, so the vanishing
  !denominator belongs to exactly one diagonal entry of T.
  ASSERT(PairError(EA, EB, S, T, 2) < Tolerance)

  Found = 0
  do i = 1, 2
    if (abs(EB(i)) > 0.0_C_DOUBLE) then
      ASSERT(abs(EA(i) / EB(i) - 2.0_C_DOUBLE * Cmplx1) < Tolerance)
      Found = Found + 1
    endif
  enddo
  ASSERT(Found == 1)

#endif
END_TEST_E

TEST_E(LDWFortranZGGESNominalZeroEigenvalue)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx0, Cmplx1, &
                                    GeneralizedSchurDecomposition
  use LDWFortranFunctionalSupport, only: GeneralizedSchurForms, &
                                         OrthonormalityError, PairError, &
                                         UpperTriangularError

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zgges

  real(C_DOUBLE), parameter :: &
    Tolerance = 1000.0_C_DOUBLE * epsilon(1.0_C_DOUBLE)

  complex(C_DOUBLE_COMPLEX) :: A(2, 2), B(2, 2), U(2, 2), VH(2, 2)
  complex(C_DOUBLE_COMPLEX) :: EA(2), EB(2), S(2, 2), T(2, 2)
  integer(C_INT)            :: Found, Info, i

  !The pair (0, 1) is a finite generalized eigenvalue: Alpha vanishes while
  !Beta does not, so the pair stays meaningful without forming a quotient.
  A       = Cmplx0
  A(2, 2) = 2.0_C_DOUBLE * Cmplx1
  B       = Cmplx0
  B(1, 1) = Cmplx1
  B(2, 2) = Cmplx1

  call GeneralizedSchurDecomposition(Dimension = 2_C_SIZE_T, &
                                     MatrixA = A, &
                                     MatrixB = B, &
                                     UnitaryU = U, &
                                     EigenvaluesA = EA, &
                                     EigenvaluesB = EB, &
                                     UnitaryVH = VH, &
                                     ZGGESProcedure = zgges, &
                                     Info = Info)

  ASSERT(Info == 0_C_INT)
  ASSERT(OrthonormalityError(U, 2) < Tolerance)
  ASSERT(OrthonormalityError(conjg(transpose(VH)), 2) < Tolerance)

  call GeneralizedSchurForms(A, B, U, VH, S, T, 2)

  ASSERT(UpperTriangularError(S, 2) < Tolerance)
  ASSERT(UpperTriangularError(T, 2) < Tolerance)

  !The returned pairs are the diagonal of the Schur forms: exactly one pair
  !has a vanishing numerator and no pair has a vanishing denominator.
  ASSERT(PairError(EA, EB, S, T, 2) < Tolerance)
  ASSERT(count(abs(EA) <= 0.0_C_DOUBLE) == 1)
  ASSERT(count(abs(EB) <= 0.0_C_DOUBLE) == 0)

  !The other pair carries the only finite, non-zero eigenvalue, 2.
  Found = 0
  do i = 1, 2
    if (abs(EA(i)) > 0.0_C_DOUBLE) then
      ASSERT(abs(EA(i) / EB(i) - 2.0_C_DOUBLE * Cmplx1) < Tolerance)
      Found = Found + 1
    endif
  enddo
  ASSERT(Found == 1)

#endif
END_TEST_E

TEST_E(LDWFortranZGGESNominalSweep)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    C_SIZE_T, GeneralizedSchurDecomposition
  use LDWFortranFunctionalSupport, only: GeneralizedReconstructionError, &
                                         GeneralizedSchurForms, &
                                         OrthonormalityError, PairError, &
                                         RandomPair, UpperTriangularError

  implicit none
  TSD_TEST_E_INTERFACES

  external :: zgges

  integer, parameter :: MaxN = 5

  real(C_DOUBLE), parameter :: &
    Tolerance = 10000.0_C_DOUBLE * epsilon(1.0_C_DOUBLE)

  integer(C_INT)    :: Info
  integer(C_SIZE_T) :: DimensionSize
  integer(INT64)    :: Seed
  integer           :: N

  !Deterministic dense pairs for every small dimension. The thresholds are
  !scaled by the largest entry of each input, so the sweep does not depend on
  !the growth of a particular draw, and the block-scoped arrays keep every
  !call free of array sections.
  do N = 1, MaxN
    block
      complex(C_DOUBLE_COMPLEX) :: A(N, N), B(N, N), U(N, N), VH(N, N)
      complex(C_DOUBLE_COMPLEX) :: EA(N), EB(N), S(N, N), T(N, N)
      real(C_DOUBLE)            :: Bound, PairsError, ReconstructionError, &
                                   ScaleA, ScaleB

      Seed          = int(20240 + 7 * N, INT64)
      DimensionSize = int(N, C_SIZE_T)

      call RandomPair(Seed, A, B, N)

      ScaleA = max(1.0_C_DOUBLE, maxval(abs(A)))
      ScaleB = max(1.0_C_DOUBLE, maxval(abs(B)))
      Bound  = Tolerance * real(N, C_DOUBLE)

      call GeneralizedSchurDecomposition(Dimension = DimensionSize, &
                                         MatrixA = A, &
                                         MatrixB = B, &
                                         UnitaryU = U, &
                                         EigenvaluesA = EA, &
                                         EigenvaluesB = EB, &
                                         UnitaryVH = VH, &
                                         ZGGESProcedure = zgges, &
                                         Info = Info)

      ASSERT(Info == 0_C_INT)
      ASSERT(OrthonormalityError(U, N) < Bound)
      ASSERT(OrthonormalityError(conjg(transpose(VH)), N) < Bound)

      call GeneralizedSchurForms(A, B, U, VH, S, T, N)

      ASSERT(UpperTriangularError(S, N) < Bound * ScaleA)
      ASSERT(UpperTriangularError(T, N) < Bound * ScaleB)

      PairsError = PairError(EA, EB, S, T, N)

      ReconstructionError = &
        GeneralizedReconstructionError(A, U, S, VH, N)

      ASSERT(ReconstructionError < Bound)
      ASSERT(PairsError < Bound * max(ScaleA, ScaleB))
    end block
  enddo

#endif
END_TEST_E

TEST_E(LDWFortranZGGESFastReturn)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: INT32, C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx1, GeneralizedSchurDecomposition
  use LDWFortranFunctionalSupport, only: ResetZGGESStub, &
                                         GetZGGESStubCalls, ZGGESStub

  implicit none
  TSD_TEST_E_INTERFACES

  complex(C_DOUBLE_COMPLEX) :: A(1, 1), B(1, 1), U(1, 1), VH(1, 1)
  complex(C_DOUBLE_COMPLEX) :: EA(1), EB(1)
  integer(C_INT)            :: Info
  integer(INT32)            :: Queries, Computations

  A  = 42 * Cmplx1
  B  = 42 * Cmplx1
  U  = 42 * Cmplx1
  VH = 42 * Cmplx1
  EA = 42 * Cmplx1
  EB = 42 * Cmplx1

  call ResetZGGESStub()

  !Dimension zero is a fast return: the deferred procedure is never called
  !and the output arguments are left untouched.
  call GeneralizedSchurDecomposition(Dimension = 0_C_SIZE_T, &
                                     MatrixA = A, &
                                     MatrixB = B, &
                                     UnitaryU = U, &
                                     EigenvaluesA = EA, &
                                     EigenvaluesB = EB, &
                                     UnitaryVH = VH, &
                                     ZGGESProcedure = ZGGESStub, &
                                     Info = Info)

  ASSERT(Info == 0_C_INT)
  ASSERT(all(abs(U - 42 * Cmplx1) <= 0.0_C_DOUBLE))
  ASSERT(all(abs(VH - 42 * Cmplx1) <= 0.0_C_DOUBLE))
  ASSERT(all(abs(EA - 42 * Cmplx1) <= 0.0_C_DOUBLE))
  ASSERT(all(abs(EB - 42 * Cmplx1) <= 0.0_C_DOUBLE))

  call GetZGGESStubCalls(Queries, Computations)
  ASSERT(Queries == 0_INT32)
  ASSERT(Computations == 0_INT32)

#endif
END_TEST_E

TEST_E(LDWFortranZGGESTooLarge)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: INT32, C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx1, GeneralizedSchurDecomposition
  use LDWFortranFunctionalSupport, only: ResetZGGESStub, &
                                         GetZGGESStubCalls, ZGGESStub

  implicit none
  TSD_TEST_E_INTERFACES

  complex(C_DOUBLE_COMPLEX) :: A(1, 1), B(1, 1), U(1, 1), VH(1, 1)
  complex(C_DOUBLE_COMPLEX) :: EA(1), EB(1)
  integer(C_INT)            :: Info
  integer(INT32)            :: Queries, Computations

  A  = 42 * Cmplx1
  B  = 42 * Cmplx1
  U  = 42 * Cmplx1
  VH = 42 * Cmplx1
  EA = 42 * Cmplx1
  EB = 42 * Cmplx1

  call ResetZGGESStub()

  !Dimensions beyond the LAPACK integer range are rejected before any buffer
  !is allocated or the deferred procedure is called.
  call GeneralizedSchurDecomposition( &
                                     Dimension = int(huge(1_INT32), C_SIZE_T) + 1_C_SIZE_T, &
                                     MatrixA = A, &
                                     MatrixB = B, &
                                     UnitaryU = U, &
                                     EigenvaluesA = EA, &
                                     EigenvaluesB = EB, &
                                     UnitaryVH = VH, &
                                     ZGGESProcedure = ZGGESStub, &
                                     Info = Info)

  ASSERT(Info == int(huge(1_INT32), C_INT))
  ASSERT(all(abs(U - 42 * Cmplx1) <= 0.0_C_DOUBLE))
  ASSERT(all(abs(VH - 42 * Cmplx1) <= 0.0_C_DOUBLE))
  ASSERT(all(abs(EA - 42 * Cmplx1) <= 0.0_C_DOUBLE))
  ASSERT(all(abs(EB - 42 * Cmplx1) <= 0.0_C_DOUBLE))

  call GetZGGESStubCalls(Queries, Computations)
  ASSERT(Queries == 0_INT32)
  ASSERT(Computations == 0_INT32)

#endif
END_TEST_E

TEST_E(LDWFortranZGGESFailWorkspaceQuery)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: INT32, C_DOUBLE, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx1, GeneralizedSchurDecomposition
  use LDWFortranFunctionalSupport, only: &
    LDWStubFailingQuery, ResetZGGESStub, SetZGGESStubStatus, &
    GetZGGESStubCalls, ZGGESStub

  implicit none
  TSD_TEST_E_INTERFACES

  complex(C_DOUBLE_COMPLEX) :: A(3, 3), B(3, 3), U(3, 3), VH(3, 3)
  complex(C_DOUBLE_COMPLEX) :: EA(3), EB(3)
  integer(C_INT)            :: Info
  integer(INT32)            :: Queries, Computations

  A  = 0 * Cmplx1
  B  = 0 * Cmplx1
  U  = 42 * Cmplx1
  VH = 42 * Cmplx1
  EA = 42 * Cmplx1
  EB = 42 * Cmplx1

  call ResetZGGESStub()
  call SetZGGESStubStatus(LDWStubFailingQuery, 0_INT32)

  !A failing workspace query is propagated unchanged and the computational
  !call is never made. The outputs are left untouched.
  call GeneralizedSchurDecomposition(Dimension = 3_C_SIZE_T, &
                                     MatrixA = A, &
                                     MatrixB = B, &
                                     UnitaryU = U, &
                                     EigenvaluesA = EA, &
                                     EigenvaluesB = EB, &
                                     UnitaryVH = VH, &
                                     ZGGESProcedure = ZGGESStub, &
                                     Info = Info)

  ASSERT(Info == int(LDWStubFailingQuery, C_INT))
  ASSERT(all(abs(U - 42 * Cmplx1) <= 0.0_C_DOUBLE))
  ASSERT(all(abs(VH - 42 * Cmplx1) <= 0.0_C_DOUBLE))
  ASSERT(all(abs(EA - 42 * Cmplx1) <= 0.0_C_DOUBLE))
  ASSERT(all(abs(EB - 42 * Cmplx1) <= 0.0_C_DOUBLE))

  call GetZGGESStubCalls(Queries, Computations)
  ASSERT(Queries == 1_INT32)
  ASSERT(Computations == 0_INT32)

#endif
END_TEST_E

TEST_E(LDWFortranZGGESFailComputation)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: INT32, C_DOUBLE_COMPLEX, C_INT, &
                                    Cmplx1, GeneralizedSchurDecomposition
  use LDWFortranFunctionalSupport, only: ResetZGGESStub, &
                                         SetZGGESStubStatus, &
                                         GetZGGESStubCalls, ZGGESStub

  implicit none
  TSD_TEST_E_INTERFACES

  integer(INT32), parameter :: ComputeStatus = -6_INT32

  complex(C_DOUBLE_COMPLEX) :: A(3, 3), B(3, 3), U(3, 3), VH(3, 3)
  complex(C_DOUBLE_COMPLEX) :: EA(3), EB(3)
  integer(C_INT)            :: Info
  integer(INT32)            :: Queries, Computations

  A = 0 * Cmplx1
  B = 0 * Cmplx1

  call ResetZGGESStub()
  call SetZGGESStubStatus(0_INT32, ComputeStatus)

  !A nonzero status from the computational call is propagated unchanged.
  call GeneralizedSchurDecomposition(Dimension = 3_C_SIZE_T, &
                                     MatrixA = A, &
                                     MatrixB = B, &
                                     UnitaryU = U, &
                                     EigenvaluesA = EA, &
                                     EigenvaluesB = EB, &
                                     UnitaryVH = VH, &
                                     ZGGESProcedure = ZGGESStub, &
                                     Info = Info)

  ASSERT(Info == int(ComputeStatus, C_INT))

  call GetZGGESStubCalls(Queries, Computations)
  ASSERT(Queries == 1_INT32)
  ASSERT(Computations == 1_INT32)

#endif
END_TEST_E

