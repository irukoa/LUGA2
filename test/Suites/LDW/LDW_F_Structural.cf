  TSD_TEST_EF_INTERFACES

  integer(C_INT) :: Info
  type(C_PTR)    :: CCtx

  CCtx = ContextData !Unused.

  !There are exactly six multiplications, so a failure armed at the seventh
  !call must never trigger. This pins the indices used above.
  call SetFallibleMulOverflow(7_C_SIZE_T)
  call RunDiagHermitian(ZHEEVDNominal, Info)

  ASSERT(Info == 0_C_INT)
#endif
END_TEST_EF

TEST_EF(StructuralCtx, LDWStructuralNominal)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT
  use LDWStructuralZHEEVDStubs, only: RunDiagHermitianResults, ZHEEVDNominal

  implicit none
  TSD_TEST_EF_INTERFACES

  complex(C_DOUBLE_COMPLEX) :: U(3, 3)
  real(C_DOUBLE)            :: E(3)
  integer(C_INT)            :: Info
  integer                   :: i, j
  type(C_PTR)               :: CCtx

  CCtx = ContextData !Unused.

  !The stub writes LWORK/RWORK/IWORK elements, so this also verifies that
  !the three workspace buffers were sized with the right element sizes.
  call RunDiagHermitianResults(ZHEEVDNominal, U, E, Info)

  ASSERT(Info == 0_C_INT)
  ASSERT(all(abs(E - [1.0_C_DOUBLE, 2.0_C_DOUBLE, 3.0_C_DOUBLE]) < 10*epsilon(1.0_C_DOUBLE)))

  do j = 1, 3
    do i = 1, 3
      if (i == j) then
        ASSERT(abs(U(i, j) - cmplx(1.0_C_DOUBLE, 0.0_C_DOUBLE, C_DOUBLE_COMPLEX)) < 10*epsilon(1.0_C_DOUBLE))
      else
        ASSERT(abs(U(i, j)) < 10*epsilon(1.0_C_DOUBLE))
      endif
    enddo
  enddo
#endif
END_TEST_EF

TEST_EF(StructuralCtx, LDWStructuralDegeneracyNoAllocator)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_SIZE_T, DegeneracyGroup
  use CoreSupportFortran

  implicit none
  TSD_TEST_EF_INTERFACES

  real(C_DOUBLE)    :: E(3)
  integer(C_SIZE_T) :: D(3)
  type(C_PTR)       :: CCtx

  CCtx = ContextData !Unused.

  E = real([0.0, 0.1, 1.0], C_DOUBLE)

  !DegeneracyGroup is allocation-free: armed allocator failures must not
  !change its result.
  call SetFallibleMalloc(1_C_SIZE_T)
  call SetFallibleMulOverflow(1_C_SIZE_T)

  call DegeneracyGroup(3_C_SIZE_T, E, 0.2_C_DOUBLE, D)

  ASSERT(all(D == int([2, 0, 1], C_SIZE_T)))
#endif
END_TEST_EF

TEST_EF(StructuralCtx, LDWStructuralZGEESZeroDimension)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_INT, C_SIZE_T
  use LDWStructuralZGEESStubs, only: RunSchurDecompositionAtDimension

  implicit none
  TSD_TEST_EF_INTERFACES

  integer(C_INT) :: Info
  type(C_PTR)    :: CCtx

  CCtx = ContextData !Unused.

  !No workspace is needed: the routine must return before any allocation.
  call RunSchurDecompositionAtDimension(0_C_SIZE_T, Info)

  ASSERT(Info == 0_C_INT)
#endif
END_TEST_EF

TEST_EF(StructuralCtx, LDWStructuralZGEESTooLargeDimension)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_INT, C_SIZE_T
  use LDWStructuralZGEESStubs, only: RunSchurDecompositionAtDimension

  implicit none
  TSD_TEST_EF_INTERFACES

  integer(C_INT) :: Info
  type(C_PTR)    :: CCtx

  CCtx = ContextData !Unused.

  !Dimension exceeds huge(1_INT32): reject before any allocation.
  call RunSchurDecompositionAtDimension(int(huge(1_INT32), C_SIZE_T) + 1_C_SIZE_T, &
                                        Info)

  ASSERT(Info == int(huge(1_INT32), C_INT))
#endif
END_TEST_EF

