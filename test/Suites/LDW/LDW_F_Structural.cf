  type(C_PTR)    :: CCtx

  CCtx = ContextData !Unused.

  !Fourth multiplication: WORK bytes (16 * LWORK), after the query.
  call SetFallibleMulOverflow(4_C_SIZE_T)
  call RunDiagHermitian(ZHEEVDNominal, Info)

  ASSERT(Info == int(huge(1_INT32), C_INT))
#endif
END_TEST_EF

TEST_EF(StructuralCtx, LDWStructuralRWorkBytesMulOverflow)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_INT, C_SIZE_T
