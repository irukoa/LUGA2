TEST_EF(StructuralCtx, LDWStructuralZGEESNominal)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT
  use LDWStructuralZGEESStubs, only: RunSchurDecompositionResults, &
                                     ZGEESNominal

  implicit none
  TSD_TEST_EF_INTERFACES

  complex(C_DOUBLE_COMPLEX) :: U(3, 3), S(3, 3)
  integer(C_INT)            :: Info
  integer                   :: i, j
  type(C_PTR)               :: CCtx

  CCtx = ContextData !Unused.

  !The stub writes LWORK/RWORK/BWORK elements, so this also verifies that
  !the workspace buffers were sized with the right element sizes.
  call RunSchurDecompositionResults(ZGEESNominal, U, S, Info)

  ASSERT(Info == 0_C_INT)

  !U is the stub identity.
  do j = 1, 3
    do i = 1, 3
      if (i == j) then
        ASSERT(abs(U(i, j) - cmplx(1.0_C_DOUBLE, 0.0_C_DOUBLE, C_DOUBLE_COMPLEX)) < 10*epsilon(1.0_C_DOUBLE))
      else
        ASSERT(abs(U(i, j)) < 10*epsilon(1.0_C_DOUBLE))
      endif
    enddo
  enddo

  !S is the stub upper triangular matrix.
  do j = 1, 3
    do i = 1, 3
      if (i <= j) then
        ASSERT(abs(S(i, j) - cmplx(real(10*i + j, C_DOUBLE), 0.0_C_DOUBLE, C_DOUBLE_COMPLEX)) < 10*epsilon(1.0_C_DOUBLE))
      else
        ASSERT(abs(S(i, j)) < 10*epsilon(1.0_C_DOUBLE))
      endif
    enddo
  enddo
#endif
END_TEST_EF

TEST_EF(StructuralCtx, LDWStructuralZGEESNominalNoSchurForm)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT
  use LDWStructuralZGEESStubs, only: RunSchurDecompositionNoSchurForm, &
                                     ZGEESNominal

  implicit none
  TSD_TEST_EF_INTERFACES

  complex(C_DOUBLE_COMPLEX) :: U(3, 3)
  integer(C_INT)            :: Info
  integer                   :: i, j
  type(C_PTR)               :: CCtx

  CCtx = ContextData !Unused.

  !Omitting the optional SchurForm must not change the computation.
  call RunSchurDecompositionNoSchurForm(ZGEESNominal, U, Info)

  ASSERT(Info == 0_C_INT)

  do j = 1, 3
    do i = 1, 3
      if (i == j) then
        ASSERT(abs(U(i, j) - cmplx(1.0_C_DOUBLE, 0.0_C_DOUBLE, C_DOUBLE_COMPLEX)) < 10*epsilon(1.0_C_DOUBLE))
      else
        ASSERT(abs(U(i, j)) < 10*epsilon(1.0_C_DOUBLE))
      endif
    enddo
  enddo
#endif
END_TEST_EF

