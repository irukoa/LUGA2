TEST_EF(StructuralCtx, LDWStructuralZGESDDNominal)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT
  use LDWStructuralZGESDDStubs, only: RunSVDDecompositionResults, &
                                      ZGESDDNominal

  implicit none
  TSD_TEST_EF_INTERFACES

  complex(C_DOUBLE_COMPLEX) :: U(3, 3), VH(3, 3), Expected
  real(C_DOUBLE)            :: S(3)
  integer(C_INT)            :: Info
  integer                   :: i, j
  type(C_PTR)               :: CCtx

  CCtx = ContextData !Unused.

  !The stub writes LWORK/RWORK/IWORK elements, so this also verifies that
  !the workspace buffers were sized with the right element sizes.
  call RunSVDDecompositionResults(ZGESDDNominal, U, S, VH, Info)

  ASSERT(Info == 0_C_INT)

  !The stub wrote 3, 2, 1: the wrapper must return them ascending.
  do j = 1, 3
    ASSERT(abs(S(j) - real(j, C_DOUBLE)) <= 0.0_C_DOUBLE)
  enddo

  !Reversing the columns of U swaps columns 1 and 3, so column j holds
  !10*i + (4 - j).
  do j = 1, 3
    do i = 1, 3
      Expected = cmplx(real(10*i + 4 - j, C_DOUBLE), 0.0_C_DOUBLE, C_DOUBLE_COMPLEX)
      ASSERT(abs(U(i, j) - Expected) <= 0.0_C_DOUBLE)
    enddo
  enddo

  !Reversing the rows of VT swaps rows 1 and 3, so row i holds
  !100*(4 - i) + j.
  do j = 1, 3
    do i = 1, 3
      Expected = cmplx(real(100*(4 - i) + j, C_DOUBLE), 0.0_C_DOUBLE, C_DOUBLE_COMPLEX)
      ASSERT(abs(VH(i, j) - Expected) <= 0.0_C_DOUBLE)
    enddo
  enddo
#endif
END_TEST_EF

TEST_EF(StructuralCtx, LDWStructuralZGESDDNominalNoDiagSigma)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT
  use LDWStructuralZGESDDStubs, only: RunSVDDecompositionNoDiagSigma, &
                                      ZGESDDNominal

  implicit none
  TSD_TEST_EF_INTERFACES

  complex(C_DOUBLE_COMPLEX) :: U(3, 3), VH(3, 3), Expected
  integer(C_INT)            :: Info
  integer                   :: i, j
  type(C_PTR)               :: CCtx

  CCtx = ContextData !Unused.

  !Omitting the optional DiagSigma must not change the computation.
  call RunSVDDecompositionNoDiagSigma(ZGESDDNominal, U, VH, Info)

  ASSERT(Info == 0_C_INT)

  do j = 1, 3
    do i = 1, 3
      Expected = cmplx(real(10*i + 4 - j, C_DOUBLE), 0.0_C_DOUBLE, C_DOUBLE_COMPLEX)
      ASSERT(abs(U(i, j) - Expected) <= 0.0_C_DOUBLE)
    enddo
  enddo

  do j = 1, 3
    do i = 1, 3
      Expected = cmplx(real(100*(4 - i) + j, C_DOUBLE), 0.0_C_DOUBLE, C_DOUBLE_COMPLEX)
      ASSERT(abs(VH(i, j) - Expected) <= 0.0_C_DOUBLE)
    enddo
  enddo
#endif
END_TEST_EF

TEST_EF(StructuralCtx, LDWStructuralZGESDDNominalRectangular)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT
  use LDWStructuralZGESDDStubs, only: RunSVDDecompositionRectangularResults, &
                                      ZGESDDNominal

  implicit none
  TSD_TEST_EF_INTERFACES

  complex(C_DOUBLE_COMPLEX) :: U(2, 2), VH(3, 3), Expected
  real(C_DOUBLE)            :: S(2)
  integer(C_INT)            :: Info
  integer                   :: i, j
  type(C_PTR)               :: CCtx

  CCtx = ContextData !Unused.

  call RunSVDDecompositionRectangularResults(ZGESDDNominal, U, S, VH, Info)

  ASSERT(Info == 0_C_INT)

  !The stub wrote 2, 1 for a 2-by-3 matrix.
  ASSERT(abs(S(1) - 1.0_C_DOUBLE) <= 0.0_C_DOUBLE)
  ASSERT(abs(S(2) - 2.0_C_DOUBLE) <= 0.0_C_DOUBLE)

  !U is 2x2, so both of its columns are permuted.
  do j = 1, 2
    do i = 1, 2
      Expected = cmplx(real(10*i + 3 - j, C_DOUBLE), 0.0_C_DOUBLE, C_DOUBLE_COMPLEX)
      ASSERT(abs(U(i, j) - Expected) <= 0.0_C_DOUBLE)
    enddo
  enddo

  !Only the first min(2, 3) = 2 rows of VT are permuted: rows 1 and 2 are
  !swapped and row 3 keeps its position.
  do j = 1, 3
    do i = 1, 3
      if (i <= 2) then
        Expected = cmplx(real(100*(3 - i) + j, C_DOUBLE), 0.0_C_DOUBLE, C_DOUBLE_COMPLEX)
        ASSERT(abs(VH(i, j) - Expected) <= 0.0_C_DOUBLE)
      else
        Expected = cmplx(real(300 + j, C_DOUBLE), 0.0_C_DOUBLE, C_DOUBLE_COMPLEX)
        ASSERT(abs(VH(i, j) - Expected) <= 0.0_C_DOUBLE)
      endif
    enddo
  enddo
#endif
END_TEST_EF

