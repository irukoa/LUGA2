TEST_EF(StructuralCtx, LDWStructuralZGESDDAllocatorCallsExhausted)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_INT, C_SIZE_T
  use LDWStructuralZGESDDStubs, only: RunSVDDecomposition, ZGESDDNominal
  use CoreSupportFortran

  implicit none
  TSD_TEST_EF_INTERFACES

  integer(C_INT) :: Info
  type(C_PTR)    :: CCtx

  CCtx = ContextData !Unused.

  !There are exactly seven allocations, so a failure armed at the eighth
  !call must never trigger. This pins the indices used above.
  call SetFallibleMalloc(8_C_SIZE_T)
  call RunSVDDecomposition(ZGESDDNominal, Info)

  ASSERT(Info == 0_C_INT)
#endif
END_TEST_EF

