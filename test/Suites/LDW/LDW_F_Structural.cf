TEST_EF(StructuralCtx, LDWStructuralZGEESComputeStatusFail)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_INT
  use LDWStructuralZGEESStubs, only: RunSchurDecomposition, &
                                     ZGEESFailCompute, ZGEESComputeStatus

  implicit none
  TSD_TEST_EF_INTERFACES

  integer(C_INT) :: Info
  type(C_PTR)    :: CCtx

  CCtx = ContextData !Unused.

  !A nonzero status from the computational call is propagated unchanged.
  call RunSchurDecomposition(ZGEESFailCompute, Info)

  ASSERT(Info == int(ZGEESComputeStatus, C_INT))
#endif
END_TEST_EF

TEST_EF(StructuralCtx, LDWStructuralZGEESAllocatorCallsExhausted)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_INT, C_SIZE_T
  use LDWStructuralZGEESStubs, only: RunSchurDecomposition, ZGEESNominal
  use CoreSupportFortran

  implicit none
  TSD_TEST_EF_INTERFACES

  integer(C_INT) :: Info
  type(C_PTR)    :: CCtx

  CCtx = ContextData !Unused.

  !There are exactly six allocations, so a failure armed at the seventh
  !call must never trigger. This pins the indices used above.
  call SetFallibleMalloc(7_C_SIZE_T)
  call RunSchurDecomposition(ZGEESNominal, Info)

  ASSERT(Info == 0_C_INT)
#endif
END_TEST_EF

TEST_EF(StructuralCtx, LDWStructuralZGEESMultiplierCallsExhausted)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_INT, C_SIZE_T
  use LDWStructuralZGEESStubs, only: RunSchurDecomposition, ZGEESNominal
  use CoreSupportFortran

  implicit none
  TSD_TEST_EF_INTERFACES

  integer(C_INT) :: Info
  type(C_PTR)    :: CCtx

  CCtx = ContextData !Unused.

  !There are exactly eight multiplications, so a failure armed at the ninth
  !call must never trigger. This pins the indices used above.
  call SetFallibleMulOverflow(9_C_SIZE_T)
  call RunSchurDecomposition(ZGEESNominal, Info)

  ASSERT(Info == 0_C_INT)
#endif
END_TEST_EF

TEST_EF(StructuralCtx, LDWStructuralZGEESNominal)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT
  use LDWStructuralZGEESStubs, only: RunSchurDecompositionResults, &
                                     ZGEESNominal

  implicit none
  TSD_TEST_EF_INTERFACES

  complex(C_DOUBLE_COMPLEX) :: U(3, 3), S(3, 3)
  integer(C_INT)            :: Info
  integer                   :: i, j
  type(C_PTR)               :: CCtx

  CCtx = ContextData !Unused.

  !The stub writes LWORK/RWORK/BWORK elements, so this also verifies that
  !the workspace buffers were sized with the right element sizes.
  call RunSchurDecompositionResults(ZGEESNominal, U, S, Info)

  ASSERT(Info == 0_C_INT)

  !U is the stub identity.
  do j = 1, 3
    do i = 1, 3
      if (i == j) then
        ASSERT(abs(U(i, j) - cmplx(1.0_C_DOUBLE, 0.0_C_DOUBLE, C_DOUBLE_COMPLEX)) < 10*epsilon(1.0_C_DOUBLE))
      else
        ASSERT(abs(U(i, j)) < 10*epsilon(1.0_C_DOUBLE))
      endif
    enddo
  enddo

  !S is the stub upper triangular matrix.
  do j = 1, 3
    do i = 1, 3
      if (i <= j) then
        ASSERT(abs(S(i, j) - cmplx(real(10*i + j, C_DOUBLE), 0.0_C_DOUBLE, C_DOUBLE_COMPLEX)) < 10*epsilon(1.0_C_DOUBLE))
      else
        ASSERT(abs(S(i, j)) < 10*epsilon(1.0_C_DOUBLE))
      endif
    enddo
  enddo
#endif
END_TEST_EF

TEST_EF(StructuralCtx, LDWStructuralZGEESNominalNoSchurForm)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_DOUBLE, C_DOUBLE_COMPLEX, C_INT
  use LDWStructuralZGEESStubs, only: RunSchurDecompositionNoSchurForm, &
                                     ZGEESNominal

  implicit none
  TSD_TEST_EF_INTERFACES

  complex(C_DOUBLE_COMPLEX) :: U(3, 3)
  integer(C_INT)            :: Info
  integer                   :: i, j
  type(C_PTR)               :: CCtx

  CCtx = ContextData !Unused.

  !Omitting the optional SchurForm must not change the computation.
  call RunSchurDecompositionNoSchurForm(ZGEESNominal, U, Info)

  ASSERT(Info == 0_C_INT)

  do j = 1, 3
    do i = 1, 3
      if (i == j) then
        ASSERT(abs(U(i, j) - cmplx(1.0_C_DOUBLE, 0.0_C_DOUBLE, C_DOUBLE_COMPLEX)) < 10*epsilon(1.0_C_DOUBLE))
      else
        ASSERT(abs(U(i, j)) < 10*epsilon(1.0_C_DOUBLE))
      endif
    enddo
  enddo
#endif
END_TEST_EF

