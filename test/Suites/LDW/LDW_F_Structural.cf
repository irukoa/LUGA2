TEST_EF(StructuralCtx, LDWStructuralZGEESTooLargeDimension)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_INT, C_SIZE_T
  use LDWStructuralZGEESStubs, only: RunSchurDecompositionAtDimension

  implicit none
  TSD_TEST_EF_INTERFACES

  integer(C_INT) :: Info
  type(C_PTR)    :: CCtx

  CCtx = ContextData !Unused.

  !Dimension exceeds huge(1_INT32): reject before any allocation.
  call RunSchurDecompositionAtDimension(int(huge(1_INT32), C_SIZE_T) + 1_C_SIZE_T, &
                                        Info)

  ASSERT(Info == int(huge(1_INT32), C_INT))
#endif
END_TEST_EF

