#include "test/TSD/TSD_Fortran.h"
#ifdef TSD_FORTRAN_IMPL
#include "src/LDW/LapackDeferredWrappers.M90"
#include "test/CoreSupport/CoreSupportFortran.M90"
#endif
#ifdef TSD_KERNEL
#include "src/Core/Core.h"
#include "test/CoreSupport/CoreSupport.h"
#endif

#ifdef TSD_KERNEL
CONTEXT_FN(StructuralSetup) {
  (void)ContextData;
  Core_Malloc = FallibleMalloc;
  ResetFallibleMalloc();
  Core_MulOverflow = FallibleMulOverflow;
  ResetFallibleMulOverflow();
  Core_AddOverflow = FallibleAddOverflow;
  ResetFallibleAddOverflow();
}
CONTEXT_FN(StructuralTeardown) {
  (void)ContextData;
  RESET_FN(Core_Malloc);
  RESET_FN(Core_MulOverflow);
  RESET_FN(Core_AddOverflow);
}
CONTEXT(StructuralCtx,
        StructuralSetup,
        StructuralTeardown,
        (size_t)0);
#endif

#ifdef TSD_FORTRAN_IMPL

!< Deterministic ZHEEVD stand-in for the LDW structural tests.
!<
!< The workspace query reports fixed sizes (LWORK=5, LRWORK=7, LIWORK=9)
!< so that a mix-up between the element sizes of the three workspace
!< buffers is observable. The computational call writes every output
!< buffer, which also verifies that the buffers are large enough.
!<
!< StubMode selects the failure to inject. Each Run... helper assigns it
!< immediately before calling DiagHermitian, so tests do not depend on the
!< state left behind by another test.
module LDWStructuralZHEEVDStubs

  use, intrinsic :: IEEE_ARITHMETIC, only: IEEE_QUIET_NAN, IEEE_VALUE
  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, C_DOUBLE_COMPLEX
  use LapackDeferredWrappers, only: INT32, REAL64, C_INT, C_SIZE_T, &
                                    DiagHermitian

  implicit none
  private

  !Stub behaviour selectors.
  integer(INT32), parameter, public :: &
    ZHEEVDNominal       = 0_INT32, &
    ZHEEVDFailQuery     = 1_INT32, &
    ZHEEVDFailCompute   = 2_INT32, &
    ZHEEVDNegativeWork  = 3_INT32, &
    ZHEEVDNaNWork       = 4_INT32, &
    ZHEEVDHugeWork      = 5_INT32, &
    ZHEEVDNegativeRWork = 6_INT32, &
    ZHEEVDNaNRWork      = 7_INT32, &
    ZHEEVDHugeRWork     = 8_INT32, &
    ZHEEVDZeroIWork     = 9_INT32

  !Status codes reported by the failing stubs.
  integer(INT32), parameter, public :: &
    ZHEEVDQueryStatus   = 7_INT32, &
    ZHEEVDComputeStatus = -6_INT32

  !Nominal workspace sizes.
  integer(INT32), parameter :: &
    NominalLWork  = 5_INT32, &
    NominalLRWork = 7_INT32, &
    NominalLIWork = 9_INT32

  integer(INT32) :: StubMode = ZHEEVDNominal

  public :: RunDiagHermitian
  public :: RunDiagHermitianAtDimension
  public :: RunDiagHermitianResults

contains

  !< Runs DiagHermitian on a 3x3 matrix with the requested stub behaviour.
  subroutine RunDiagHermitian(Mode, Info)
    integer(INT32), intent(in)  :: Mode
    integer(C_INT), intent(out) :: Info

    complex(REAL64) :: H(3, 3), U(3, 3)
    real(REAL64)    :: E(3)

    H        = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
    StubMode = Mode

    call DiagHermitian(Dimension = 3_C_SIZE_T, &
                       Matrix = H, &
                       Unitary = U, &
                       Eigenvalues = E, &
                       ZHEEVDProcedure = ZHEEVDStub, &
                       Info = Info)
  end subroutine RunDiagHermitian

  !< Runs DiagHermitian with an arbitrary dimension and the nominal stub.
  !< The 1x1 buffers are only dereferenced when Dimension is 1.
  subroutine RunDiagHermitianAtDimension(Dimension, Info)
    integer(C_SIZE_T), intent(in)  :: Dimension
    integer(C_INT),    intent(out) :: Info

    complex(REAL64) :: H(1, 1), U(1, 1)
    real(REAL64)    :: E(1)

    H        = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
    StubMode = ZHEEVDNominal

    call DiagHermitian(Dimension = Dimension, &
                       Matrix = H, &
                       Unitary = U, &
                       Eigenvalues = E, &
                       ZHEEVDProcedure = ZHEEVDStub, &
                       Info = Info)
  end subroutine RunDiagHermitianAtDimension

  !< Runs DiagHermitian on a 3x3 matrix and returns its outputs.
  subroutine RunDiagHermitianResults(Mode, Unitary, Eigenvalues, Info)
    integer(INT32),  intent(in)  :: Mode
    complex(REAL64), intent(out) :: Unitary(3, 3)
    real(REAL64),    intent(out) :: Eigenvalues(3)
    integer(C_INT),  intent(out) :: Info

    complex(REAL64) :: H(3, 3)

    H        = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
    StubMode = Mode

    call DiagHermitian(Dimension = 3_C_SIZE_T, &
                       Matrix = H, &
                       Unitary = Unitary, &
                       Eigenvalues = Eigenvalues, &
                       ZHEEVDProcedure = ZHEEVDStub, &
                       Info = Info)
  end subroutine RunDiagHermitianResults

  !< ZHEEVD stand-in. The workspace query reports NominalLWork/LRWork/LIWork
  !< or an invalid value, depending on StubMode. The computational call
  !< returns U = I and W = [1, 2, ...] so that the copy-back can be checked.
  subroutine ZHEEVDStub(JOBZ, UPLO, &
                        N, A, LDA, &
                        W, &
                        WORK, LWORK, RWORK, LRWORK, IWORK, LIWORK, &
                        INFO)
    character,       intent(in)    :: JOBZ
    character,       intent(in)    :: UPLO
    integer(INT32),  intent(in)    :: N
    integer(INT32),  intent(in)    :: LDA
    complex(REAL64), intent(inout) :: A(LDA, N)
    real(REAL64),    intent(out)   :: W(N)
    integer(INT32),  intent(in)    :: LWORK
    complex(REAL64), intent(out)   :: WORK(max(1, LWORK))
    integer(INT32),  intent(in)    :: LRWORK
    real(REAL64),    intent(out)   :: RWORK(max(1, LRWORK))
    integer(INT32),  intent(in)    :: LIWORK
    integer(INT32),  intent(out)   :: IWORK(max(1, LIWORK))
    integer(INT32),  intent(out)   :: INFO

    integer(INT32) :: i, j

    INFO = 0_INT32

    if (JOBZ /= 'V' .or. UPLO /= 'U' .or. LDA < N) then
      INFO = -1_INT32
      return
    endif

    !Workspace query.
    if (LWORK == -1_INT32) then
      select case (StubMode)
      case (ZHEEVDFailQuery)
        INFO = ZHEEVDQueryStatus
      case (ZHEEVDNegativeWork)
        WORK(1)  = cmplx(-1.0_REAL64, 0.0_REAL64, REAL64)
        RWORK(1) = real(NominalLRWork, REAL64)
        IWORK(1) = NominalLIWork
      case (ZHEEVDNaNWork)
        WORK(1)  = cmplx(IEEE_VALUE(0.0_REAL64, IEEE_QUIET_NAN), &
                         0.0_REAL64, REAL64)
        RWORK(1) = real(NominalLRWork, REAL64)
        IWORK(1) = NominalLIWork
      case (ZHEEVDHugeWork)
        WORK(1)  = cmplx(2.0_REAL64 * real(huge(1_INT32), REAL64), &
                         0.0_REAL64, REAL64)
        RWORK(1) = real(NominalLRWork, REAL64)
        IWORK(1) = NominalLIWork
      case (ZHEEVDNegativeRWork)
        WORK(1)  = cmplx(real(NominalLWork, REAL64), 0.0_REAL64, REAL64)
        RWORK(1) = -1.0_REAL64
        IWORK(1) = NominalLIWork
      case (ZHEEVDNaNRWork)
        WORK(1)  = cmplx(real(NominalLWork, REAL64), 0.0_REAL64, REAL64)
        RWORK(1) = IEEE_VALUE(0.0_REAL64, IEEE_QUIET_NAN)
        IWORK(1) = NominalLIWork
      case (ZHEEVDHugeRWork)
        WORK(1)  = cmplx(real(NominalLWork, REAL64), 0.0_REAL64, REAL64)
        RWORK(1) = 2.0_REAL64 * real(huge(1_INT32), REAL64)
        IWORK(1) = NominalLIWork
      case (ZHEEVDZeroIWork)
        WORK(1)  = cmplx(real(NominalLWork, REAL64), 0.0_REAL64, REAL64)
        RWORK(1) = real(NominalLRWork, REAL64)
        IWORK(1) = 0_INT32
      case default
        WORK(1)  = cmplx(real(NominalLWork, REAL64), 0.0_REAL64, REAL64)
        RWORK(1) = real(NominalLRWork, REAL64)
        IWORK(1) = NominalLIWork
      end select
      return
    endif

    !Computational call. Every output is defined so that the implementation
    !never copies uninitialized data back to the caller, even on failure.
    do j = 1, N
      do i = 1, N
        if (i == j) then
          A(i, j) = cmplx(1.0_REAL64, 0.0_REAL64, REAL64)
        else
          A(i, j) = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
        endif
      enddo
      W(j) = real(j, REAL64)
    enddo

    WORK  = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
    RWORK = 0.0_REAL64
    IWORK = 0_INT32

    if (StubMode == ZHEEVDFailCompute) INFO = ZHEEVDComputeStatus

  end subroutine ZHEEVDStub

end module LDWStructuralZHEEVDStubs

#endif

#ifdef TSD_FORTRAN_IMPL

!< Deterministic ZGEES stand-in for the LDW structural tests.
!<
!< The workspace query reports a fixed complex workspace size (LWORK=5) so
!< that mistakes in the element size of the buffer are observable. The
!< computational call writes every output buffer, which also verifies that
!< the buffers are large enough.
!<
!< StubMode selects the failure to inject. Each Run... helper assigns it
!< immediately before calling SchurDecomposition, so tests do not depend on
!< the state left behind by another test.
module LDWStructuralZGEESStubs

  use, intrinsic :: IEEE_ARITHMETIC, only: IEEE_QUIET_NAN, IEEE_VALUE
  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, C_DOUBLE_COMPLEX
  use, intrinsic :: ISO_FORTRAN_ENV, only: LOGICAL32
  use LapackDeferredWrappers, only: INT32, REAL64, C_INT, C_SIZE_T, &
                                    SchurDecomposition

  implicit none
  private

  !Stub behaviour selectors.
  integer(INT32), parameter, public :: &
    ZGEESNominal      = 0_INT32, &
    ZGEESFailQuery    = 1_INT32, &
    ZGEESFailCompute  = 2_INT32, &
    ZGEESNegativeWork = 3_INT32, &
    ZGEESNaNWork      = 4_INT32, &
    ZGEESHugeWork     = 5_INT32

  !Status codes reported by the failing stubs.
  integer(INT32), parameter, public :: &
    ZGEESQueryStatus   = 7_INT32, &
    ZGEESComputeStatus = -6_INT32

  !Nominal workspace size.
  integer(INT32), parameter :: NominalLWork = 5_INT32

  integer(INT32) :: StubMode = ZGEESNominal

  public :: RunSchurDecomposition
  public :: RunSchurDecompositionNoSchurForm
  public :: RunSchurDecompositionAtDimension
  public :: RunSchurDecompositionResults

contains

  !< Runs SchurDecomposition on a 3x3 matrix with the requested stub
  !< behaviour.
  subroutine RunSchurDecomposition(Mode, Info)
    integer(INT32), intent(in)  :: Mode
    integer(C_INT), intent(out) :: Info

    complex(REAL64) :: A(3, 3), U(3, 3), S(3, 3)

    A        = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
    StubMode = Mode

    call SchurDecomposition(Dimension = 3_C_SIZE_T, &
                            Matrix = A, &
                            Unitary = U, &
                            SchurForm = S, &
                            ZGEESProcedure = ZGEESStub, &
                            Info = Info)
  end subroutine RunSchurDecomposition

  !< Runs SchurDecomposition without the optional SchurForm argument.
  subroutine RunSchurDecompositionNoSchurForm(Mode, Unitary, Info)
    integer(INT32),  intent(in)  :: Mode
    complex(REAL64), intent(out) :: Unitary(3, 3)
    integer(C_INT),  intent(out) :: Info

    complex(REAL64) :: A(3, 3)

    A        = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
    StubMode = Mode

    call SchurDecomposition(Dimension = 3_C_SIZE_T, &
                            Matrix = A, &
                            Unitary = Unitary, &
                            ZGEESProcedure = ZGEESStub, &
                            Info = Info)
  end subroutine RunSchurDecompositionNoSchurForm

  !< Runs SchurDecomposition with an arbitrary dimension and the nominal
  !< stub. The 1x1 buffers are only dereferenced when Dimension is 1.
  subroutine RunSchurDecompositionAtDimension(Dimension, Info)
    integer(C_SIZE_T), intent(in)  :: Dimension
    integer(C_INT),    intent(out) :: Info

    complex(REAL64) :: A(1, 1), U(1, 1), S(1, 1)

    A        = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
    StubMode = ZGEESNominal

    call SchurDecomposition(Dimension = Dimension, &
                            Matrix = A, &
                            Unitary = U, &
                            SchurForm = S, &
                            ZGEESProcedure = ZGEESStub, &
                            Info = Info)
  end subroutine RunSchurDecompositionAtDimension

  !< Runs SchurDecomposition on a 3x3 matrix and returns its outputs.
  subroutine RunSchurDecompositionResults(Mode, Unitary, SchurForm, Info)
    integer(INT32),  intent(in)  :: Mode
    complex(REAL64), intent(out) :: Unitary(3, 3)
    complex(REAL64), intent(out) :: SchurForm(3, 3)
    integer(C_INT),  intent(out) :: Info

    complex(REAL64) :: A(3, 3)

    A        = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
    StubMode = Mode

    call SchurDecomposition(Dimension = 3_C_SIZE_T, &
                            Matrix = A, &
                            Unitary = Unitary, &
                            SchurForm = SchurForm, &
                            ZGEESProcedure = ZGEESStub, &
                            Info = Info)
  end subroutine RunSchurDecompositionResults

  !< ZGEES stand-in. The workspace query reports NominalLWork elements or an
  !< invalid value, depending on StubMode. The computational call returns
  !< S upper triangular (S(i, j) = 10*i + j for i <= j) and U = I so that
  !< the copy-back can be checked.
  subroutine ZGEESStub(JOBVS, SORT, SELECT, &
                       N, A, LDA, &
                       SDIM, W, &
                       VS, LDVS, WORK, LWORK, RWORK, BWORK, &
                       INFO)
    character,          intent(in)    :: JOBVS
    character,          intent(in)    :: SORT
    interface
      logical(LOGICAL32) function SELECT(C)
        import REAL64, LOGICAL32
        complex(REAL64), intent(in) :: C
      end function SELECT
    end interface
    integer(INT32),     intent(in)    :: N
    integer(INT32),     intent(in)    :: LDA
    complex(REAL64),    intent(inout) :: A(LDA, N)
    integer(INT32),     intent(out)   :: SDIM
    complex(REAL64),    intent(out)   :: W(N)
    integer(INT32),     intent(in)    :: LDVS
    complex(REAL64),    intent(out)   :: VS(LDVS, N)
    integer(INT32),     intent(in)    :: LWORK
    complex(REAL64),    intent(out)   :: WORK(max(1, LWORK))
    real(REAL64),       intent(out)   :: RWORK(N)
    logical(LOGICAL32), intent(out)   :: BWORK(N)
    integer(INT32),     intent(out)   :: INFO

    integer(INT32)     :: i, j
    logical(LOGICAL32) :: Selected

    INFO = 0_INT32

    if (JOBVS /= 'V' .or. SORT /= 'N' .or. LDA < N .or. LDVS < N) then
      INFO = -1_INT32
      return
    endif

    !The callback must be callable and must reject every value: LDW never
    !requests eigenvalue sorting.
    Selected = SELECT(cmplx(0.0_REAL64, 0.0_REAL64, REAL64))
    if (Selected) then
      INFO = -2_INT32
      return
    endif

    !Workspace query.
    if (LWORK == -1_INT32) then
      select case (StubMode)
      case (ZGEESFailQuery)
        INFO = ZGEESQueryStatus
      case (ZGEESNegativeWork)
        WORK(1) = cmplx(-1.0_REAL64, 0.0_REAL64, REAL64)
      case (ZGEESNaNWork)
        WORK(1) = cmplx(IEEE_VALUE(0.0_REAL64, IEEE_QUIET_NAN), &
                        0.0_REAL64, REAL64)
      case (ZGEESHugeWork)
        WORK(1) = cmplx(2.0_REAL64 * real(huge(1_INT32), REAL64), &
                        0.0_REAL64, REAL64)
      case default
        WORK(1) = cmplx(real(NominalLWork, REAL64), 0.0_REAL64, REAL64)
      end select
      RWORK(1) = 0.0_REAL64
      BWORK(1) = .false.
      return
    endif

    !Computational call. Every output is defined so that the implementation
    !never copies uninitialized data back to the caller, even on failure.
    SDIM = 0_INT32

    A = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
    do j = 1, N
      do i = 1, j
        A(i, j) = cmplx(real(10*i + j, REAL64), 0.0_REAL64, REAL64)
      enddo
      W(j) = cmplx(real(j, REAL64), 0.0_REAL64, REAL64)
    enddo

    VS = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
    do j = 1, N
      VS(j, j) = cmplx(1.0_REAL64, 0.0_REAL64, REAL64)
    enddo

    WORK  = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
    RWORK = 0.0_REAL64
    BWORK = .false.

    if (StubMode == ZGEESFailCompute) INFO = ZGEESComputeStatus

  end subroutine ZGEESStub

end module LDWStructuralZGEESStubs

#endif

#ifdef TSD_FORTRAN_IMPL

!< Deterministic ZGESDD stand-in for the LDW structural tests.
!<
!< The workspace query reports a fixed complex workspace size (LWORK=5) so
!< that a mistake in the element size of the buffer is observable. The
!< computational call writes every output buffer, which also verifies that
!< the buffers are large enough: ZGESDD carries no RWORK/IWORK length, so
!< the stub writes the documented minimum (5*mn*mn + 5*mn reals and 8*mn
!< integers), which the wrapper must always allocate.
!<
!< The singular values are written in descending order, like the reference
!< implementation does, while U and VT are filled with distinct entries.
!< The output checks therefore also pin the reversal which makes DiagSigma
!< ascending, and the matching permutation of the two factors.
!<
!< StubMode selects the failure to inject. Each Run... helper assigns it
!< immediately before calling SVDDecomposition, so tests do not depend on
!< the state left behind by another test.
module LDWStructuralZGESDDStubs

  use, intrinsic :: IEEE_ARITHMETIC, only: IEEE_QUIET_NAN, IEEE_VALUE
  use, intrinsic :: ISO_C_BINDING, only: C_DOUBLE, C_DOUBLE_COMPLEX
  use LapackDeferredWrappers, only: INT32, REAL64, C_INT, C_SIZE_T, &
                                    SVDDecomposition

  implicit none
  private

  !Stub behaviour selectors.
  integer(INT32), parameter, public :: &
    ZGESDDNominal      = 0_INT32, &
    ZGESDDFailQuery    = 1_INT32, &
    ZGESDDFailCompute  = 2_INT32, &
    ZGESDDNegativeWork = 3_INT32, &
    ZGESDDNaNWork      = 4_INT32, &
    ZGESDDHugeWork     = 5_INT32, &
    ZGESDDZeroWork     = 6_INT32

  !Status codes reported by the failing stubs.
  integer(INT32), parameter, public :: &
    ZGESDDQueryStatus   = 7_INT32, &
    ZGESDDComputeStatus = -6_INT32

  !Nominal workspace size.
  integer(INT32), parameter :: NominalLWork = 5_INT32

  integer(INT32) :: StubMode = ZGESDDNominal

  public :: RunSVDDecomposition
  public :: RunSVDDecompositionNoDiagSigma
  public :: RunSVDDecompositionAtDimensions
  public :: RunSVDDecompositionResults
  public :: RunSVDDecompositionRectangularResults

contains

  !< Runs SVDDecomposition on a 3x3 matrix with the requested stub
  !< behaviour.
  subroutine RunSVDDecomposition(Mode, Info)
    integer(INT32), intent(in)  :: Mode
    integer(C_INT), intent(out) :: Info

    complex(REAL64) :: A(3, 3), U(3, 3), VH(3, 3)
    real(REAL64)    :: S(3)

    A        = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
    StubMode = Mode

    call SVDDecomposition(DimensionR = 3_C_SIZE_T, &
                          DimensionC = 3_C_SIZE_T, &
                          Matrix = A, &
                          UnitaryU = U, &
                          DiagSigma = S, &
                          UnitaryVH = VH, &
                          ZGESDDProcedure = ZGESDDStub, &
                          Info = Info)
  end subroutine RunSVDDecomposition

  !< Runs SVDDecomposition without the optional DiagSigma argument.
  subroutine RunSVDDecompositionNoDiagSigma(Mode, UnitaryU, UnitaryVH, Info)
    integer(INT32),  intent(in)  :: Mode
    complex(REAL64), intent(out) :: UnitaryU(3, 3)
    complex(REAL64), intent(out) :: UnitaryVH(3, 3)
    integer(C_INT),  intent(out) :: Info

    complex(REAL64) :: A(3, 3)

    A        = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
    StubMode = Mode

    call SVDDecomposition(DimensionR = 3_C_SIZE_T, &
                          DimensionC = 3_C_SIZE_T, &
                          Matrix = A, &
                          UnitaryU = UnitaryU, &
                          UnitaryVH = UnitaryVH, &
                          ZGESDDProcedure = ZGESDDStub, &
                          Info = Info)
  end subroutine RunSVDDecompositionNoDiagSigma

  !< Runs SVDDecomposition with the given dimensions and the nominal stub.
  !< The 1x1 buffers are only dereferenced when both dimensions are 1.
  subroutine RunSVDDecompositionAtDimensions(DimensionR, DimensionC, Info)
    integer(C_SIZE_T), intent(in)  :: DimensionR
    integer(C_SIZE_T), intent(in)  :: DimensionC
    integer(C_INT),    intent(out) :: Info

    complex(REAL64) :: A(1, 1), U(1, 1), VH(1, 1)
    real(REAL64)    :: S(1)

    A        = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
    StubMode = ZGESDDNominal

    call SVDDecomposition(DimensionR = DimensionR, &
                          DimensionC = DimensionC, &
                          Matrix = A, &
                          UnitaryU = U, &
                          DiagSigma = S, &
                          UnitaryVH = VH, &
                          ZGESDDProcedure = ZGESDDStub, &
                          Info = Info)
  end subroutine RunSVDDecompositionAtDimensions

  !< Runs SVDDecomposition on a 3x3 matrix and returns its outputs.
  subroutine RunSVDDecompositionResults(Mode, UnitaryU, DiagSigma, UnitaryVH, &
                                        Info)
    integer(INT32),  intent(in)  :: Mode
    complex(REAL64), intent(out) :: UnitaryU(3, 3)
    real(REAL64),    intent(out) :: DiagSigma(3)
    complex(REAL64), intent(out) :: UnitaryVH(3, 3)
    integer(C_INT),  intent(out) :: Info

    complex(REAL64) :: A(3, 3)

    A        = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
    StubMode = Mode

    call SVDDecomposition(DimensionR = 3_C_SIZE_T, &
                          DimensionC = 3_C_SIZE_T, &
                          Matrix = A, &
                          UnitaryU = UnitaryU, &
                          DiagSigma = DiagSigma, &
                          UnitaryVH = UnitaryVH, &
                          ZGESDDProcedure = ZGESDDStub, &
                          Info = Info)
  end subroutine RunSVDDecompositionResults

  !< Runs SVDDecomposition on a 2x3 matrix and returns its outputs. It pins
  !< the scope of the ascending permutation: only the first min(R, C)
  !< columns of U and rows of VH take part in it.
  subroutine RunSVDDecompositionRectangularResults(Mode, UnitaryU, DiagSigma, &
                                                   UnitaryVH, Info)
    integer(INT32),  intent(in)  :: Mode
    complex(REAL64), intent(out) :: UnitaryU(2, 2)
    real(REAL64),    intent(out) :: DiagSigma(2)
    complex(REAL64), intent(out) :: UnitaryVH(3, 3)
    integer(C_INT),  intent(out) :: Info

    complex(REAL64) :: A(2, 3)

    A        = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
    StubMode = Mode

    call SVDDecomposition(DimensionR = 2_C_SIZE_T, &
                          DimensionC = 3_C_SIZE_T, &
                          Matrix = A, &
                          UnitaryU = UnitaryU, &
                          DiagSigma = DiagSigma, &
                          UnitaryVH = UnitaryVH, &
                          ZGESDDProcedure = ZGESDDStub, &
                          Info = Info)
  end subroutine RunSVDDecompositionRectangularResults

  !< ZGESDD stand-in. The workspace query reports NominalLWork elements or an
  !< invalid value, depending on StubMode. The computational call returns
  !< descending singular values (mn, mn - 1, ..., 1), U(i, j) = 10*i + j and
  !< VT(i, j) = 100*i + j so that both the values and the permutation of the
  !< factors can be checked.
  subroutine ZGESDDStub(JOBZ, M, N, A, LDA, &
                        S, U, LDU, VT, LDVT, &
                        WORK, LWORK, RWORK, IWORK, &
                        INFO)
    character,       intent(in)    :: JOBZ
    integer(INT32),  intent(in)    :: M
    integer(INT32),  intent(in)    :: N
    integer(INT32),  intent(in)    :: LDA
    integer(INT32),  intent(in)    :: LDU
    integer(INT32),  intent(in)    :: LDVT
    integer(INT32),  intent(in)    :: LWORK
    complex(REAL64), intent(inout) :: A(LDA, N)
    real(REAL64),    intent(out)   :: S(min(M, N))
    complex(REAL64), intent(out)   :: U(LDU, *)
    complex(REAL64), intent(out)   :: VT(LDVT, N)
    complex(REAL64), intent(out)   :: WORK(max(1, LWORK))
    real(REAL64),    intent(out)   :: RWORK(*)
    integer(INT32),  intent(out)   :: IWORK(*)
    integer(INT32),  intent(out)   :: INFO

    integer(INT32) :: i, j, MinMN

    INFO  = 0_INT32
    MinMN = min(M, N)

    if (JOBZ /= 'A' .or. LDA < M .or. LDU < M .or. LDVT < N) then
      INFO = -1_INT32
      return
    endif

    !Workspace query.
    if (LWORK == -1_INT32) then
      select case (StubMode)
      case (ZGESDDFailQuery)
        INFO = ZGESDDQueryStatus
      case (ZGESDDNegativeWork)
        WORK(1) = cmplx(-1.0_REAL64, 0.0_REAL64, REAL64)
      case (ZGESDDNaNWork)
        WORK(1) = cmplx(IEEE_VALUE(0.0_REAL64, IEEE_QUIET_NAN), &
                        0.0_REAL64, REAL64)
      case (ZGESDDHugeWork)
        WORK(1) = cmplx(2.0_REAL64 * real(huge(1_INT32), REAL64), &
                        0.0_REAL64, REAL64)
      case (ZGESDDZeroWork)
        WORK(1) = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)
      case default
        WORK(1) = cmplx(real(NominalLWork, REAL64), 0.0_REAL64, REAL64)
      end select
      RWORK(1) = 0.0_REAL64
      IWORK(1) = 0_INT32
      return
    endif

    !Computational call. Every output is defined so that the implementation
    !never copies uninitialized data back to the caller, even on failure.
    do j = 1, N
      do i = 1, M
        A(i, j) = cmplx(real(10*i + j, REAL64), 0.0_REAL64, REAL64)
      enddo
    enddo

    !Descending, as the reference implementation returns them.
    do j = 1, MinMN
      S(j) = real(MinMN - j + 1, REAL64)
    enddo

    do j = 1, M
      do i = 1, M
        U(i, j) = cmplx(real(10*i + j, REAL64), 0.0_REAL64, REAL64)
      enddo
    enddo

    do j = 1, N
      do i = 1, N
        VT(i, j) = cmplx(real(100*i + j, REAL64), 0.0_REAL64, REAL64)
      enddo
    enddo

    WORK = cmplx(0.0_REAL64, 0.0_REAL64, REAL64)

    !The wrapper must provide the reference requirements even though ZGESDD
    !has no length argument for these two buffers.
    do i = 1, 5*MinMN*MinMN + 5*MinMN
      RWORK(i) = 0.0_REAL64
    enddo
    do i = 1, 8*MinMN
      IWORK(i) = 0_INT32
    enddo

    if (StubMode == ZGESDDFailCompute) INFO = ZGESDDComputeStatus

  end subroutine ZGESDDStub

end module LDWStructuralZGESDDStubs

#endif

TEST_EF(StructuralCtx, LDWStructuralZeroDimension)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_INT, C_SIZE_T
  use LDWStructuralZHEEVDStubs, only: RunDiagHermitianAtDimension

  implicit none
  TSD_TEST_EF_INTERFACES

  integer(C_INT) :: Info
  type(C_PTR)    :: CCtx

  CCtx = ContextData !Unused.

  !No workspace is needed: the routine must return before any allocation.
  call RunDiagHermitianAtDimension(0_C_SIZE_T, Info)

  ASSERT(Info == 0_C_INT)
#endif
END_TEST_EF

TEST_EF(StructuralCtx, LDWStructuralTooLargeDimension)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_INT, C_SIZE_T
  use LDWStructuralZHEEVDStubs, only: RunDiagHermitianAtDimension

