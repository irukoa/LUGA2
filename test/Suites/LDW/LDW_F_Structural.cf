  TSD_TEST_EF_INTERFACES

  integer(C_INT) :: Info
  type(C_PTR)    :: CCtx

  CCtx = ContextData !Unused.

  !Sixth multiplication: bytes per right-factor column (16 * DimensionC).
  call SetFallibleMulOverflow(6_C_SIZE_T)
  call RunSVDDecomposition(ZGESDDNominal, Info)

  ASSERT(Info == int(huge(1_INT32), C_INT))
#endif
END_TEST_EF

