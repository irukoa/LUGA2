TEST_EF(StructuralCtx, LDWStructuralAllocatorCallsExhausted)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_INT, C_SIZE_T
  use LDWStructuralZHEEVDStubs, only: RunDiagHermitian, ZHEEVDNominal
  use CoreSupportFortran

  implicit none
  TSD_TEST_EF_INTERFACES

  integer(C_INT) :: Info
  type(C_PTR)    :: CCtx

  CCtx = ContextData !Unused.

  !There are exactly five allocations, so a failure armed at the sixth
  !call must never trigger. This pins the indices used above.
  call SetFallibleMalloc(6_C_SIZE_T)
  call RunDiagHermitian(ZHEEVDNominal, Info)

  ASSERT(Info == 0_C_INT)
#endif
END_TEST_EF

