TEST_EF(StructuralCtx, LDWStructuralZGEESAllocatorCallsExhausted)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_INT, C_SIZE_T
  use LDWStructuralZGEESStubs, only: RunSchurDecomposition, ZGEESNominal
  use CoreSupportFortran

  implicit none
  TSD_TEST_EF_INTERFACES

  integer(C_INT) :: Info
  type(C_PTR)    :: CCtx

  CCtx = ContextData !Unused.

  !There are exactly six allocations, so a failure armed at the seventh
  !call must never trigger. This pins the indices used above.
  call SetFallibleMalloc(7_C_SIZE_T)
  call RunSchurDecomposition(ZGEESNominal, Info)

  ASSERT(Info == 0_C_INT)
#endif
END_TEST_EF

