TEST_EF(StructuralCtx, LDWStructuralIWorkBytesMulOverflow)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_INT, C_SIZE_T
  use LDWStructuralZHEEVDStubs, only: RunDiagHermitian, ZHEEVDNominal
