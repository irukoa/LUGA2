TEST_EF(StructuralCtx, LDWStructuralZGEESNegativeWorkQuery)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_INT
  use LDWStructuralZGEESStubs, only: RunSchurDecomposition, &
                                     ZGEESNegativeWork

  implicit none
  TSD_TEST_EF_INTERFACES

  integer(C_INT) :: Info
  type(C_PTR)    :: CCtx

  CCtx = ContextData !Unused.

  !A negative LWORK must be rejected after the query.
  call RunSchurDecomposition(ZGEESNegativeWork, Info)

  ASSERT(Info == int(huge(1_INT32), C_INT))
#endif
END_TEST_EF

