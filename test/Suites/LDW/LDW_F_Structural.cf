  TSD_TEST_EF_INTERFACES

  integer(C_INT) :: Info
  type(C_PTR)    :: CCtx

  CCtx = ContextData !Unused.

  !Sixth multiplication: IWORK bytes (4 * LIWORK), after the query.
  call SetFallibleMulOverflow(6_C_SIZE_T)
  call RunDiagHermitian(ZHEEVDNominal, Info)

  ASSERT(Info == int(huge(1_INT32), C_INT))
#endif
END_TEST_EF

TEST_EF(StructuralCtx, LDWStructuralMatrixCopyAllocFail)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_INT, C_SIZE_T
  use LDWStructuralZHEEVDStubs, only: RunDiagHermitian, ZHEEVDNominal
  use CoreSupportFortran

  implicit none
  TSD_TEST_EF_INTERFACES

  integer(C_INT) :: Info
  type(C_PTR)    :: CCtx

  CCtx = ContextData !Unused.

  !First allocation: the matrix copy buffer.
  call SetFallibleMalloc(1_C_SIZE_T)
  call RunDiagHermitian(ZHEEVDNominal, Info)

  ASSERT(Info == int(huge(1_INT32), C_INT))
#endif
END_TEST_EF

TEST_EF(StructuralCtx, LDWStructuralEigenvaluesAllocFail)
#ifdef TSD_FORTRAN_IMPL
  use LapackDeferredWrappers, only: C_INT, C_SIZE_T
  use LDWStructuralZHEEVDStubs, only: RunDiagHermitian, ZHEEVDNominal
  use CoreSupportFortran

  implicit none
  TSD_TEST_EF_INTERFACES

  integer(C_INT) :: Info
  type(C_PTR)    :: CCtx

  CCtx = ContextData !Unused.

  !Second allocation: the eigenvalue buffer.
  call SetFallibleMalloc(2_C_SIZE_T)
  call RunDiagHermitian(ZHEEVDNominal, Info)

  ASSERT(Info == int(huge(1_INT32), C_INT))
#endif
END_TEST_EF

