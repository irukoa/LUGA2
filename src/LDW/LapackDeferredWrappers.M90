#ifndef LapackDeferredWrappers_FH
#define LapackDeferredWrappers_FH

module LapackDeferredWrappers

  use, intrinsic :: ISO_FORTRAN_ENV, only: INT32, &
                                           REAL64

  use, intrinsic :: ISO_C_BINDING, only: C_INT, &
                                         C_SIZE_T, &
                                         C_DOUBLE, &
                                         C_DOUBLE_COMPLEX

  implicit none

  private

  complex(C_DOUBLE_COMPLEX), parameter, public :: &
    Cmplx0 = cmplx(0.0_C_DOUBLE, 0.0_C_DOUBLE, C_DOUBLE_COMPLEX), &
    CmplxI = cmplx(0.0_C_DOUBLE, 1.0_C_DOUBLE, C_DOUBLE_COMPLEX), &
    Cmplx1 = cmplx(1.0_C_DOUBLE, 0.0_C_DOUBLE, C_DOUBLE_COMPLEX)

  public :: INT32
  public :: REAL64
  public :: C_INT
  public :: C_SIZE_T
  public :: C_DOUBLE
  public :: C_DOUBLE_COMPLEX

  abstract interface
    !< Abstract interface for the reference LAPACK ZHEEVD routine.
    !<
    !< Type mapping (reference LAPACK, LP64):
    !<   COMPLEX*16       -> complex(REAL64)
    !<   DOUBLE PRECISION -> real(REAL64)
    !<   INTEGER          -> integer(INT32)
    !<
    !< ILP64 LAPACK is not compatible with this interface.
    !<
    !< Reference documentation:
    !< https://www.netlib.org/lapack/explore-html/d8/d30/group__heevd_gae0a1270d44544514b5e0bf375dd83374.html
    subroutine ZHEEVDInterface(JOBZ, UPLO, &
                               N, A, LDA, &
                               W, &
                               WORK, LWORK, RWORK, LRWORK, IWORK, LIWORK, &
                               INFO)
      import INT32, REAL64
      character,       intent(in)    :: JOBZ
      character,       intent(in)    :: UPLO
      integer(INT32),  intent(in)    :: N
      complex(REAL64), intent(inout) :: A(LDA, N)
      integer(INT32),  intent(in)    :: LDA
      real(REAL64),    intent(out)   :: W(N)
      complex(REAL64), intent(out)   :: WORK(max(1, LWORK))
      integer(INT32),  intent(in)    :: LWORK
      real(REAL64),    intent(out)   :: RWORK(max(1, LRWORK))
      integer(INT32),  intent(in)    :: LRWORK
      integer(INT32),  intent(out)   :: IWORK(max(1, LIWORK))
      integer(INT32),  intent(in)    :: LIWORK
      integer(INT32),  intent(out)   :: INFO
    end subroutine ZHEEVDInterface
  end interface

  !< DiagHermitian computes the eigenvalues and orthonormal eigenvectors
  !< of a complex Hermitian matrix. The LAPACK ZHEEVD implementation is
  !< supplied by the caller at run time.
  !<
  !< -------------------------------------------------------------------------
  !< MATHEMATICAL PROBLEM
  !< -------------------------------------------------------------------------
  !<
  !< For a complex Hermitian matrix A of order N,
  !<
  !<     A = A^H,
  !<
  !< the routine computes
  !<
  !<     U^H * A * U = diag(W),   U^H * U = I,
  !<
  !< where W contains the eigenvalues in ascending order and the columns
  !< of U are the corresponding orthonormal eigenvectors.
  !<
  !< The working set is O(Dimension^2).
  !<
  !< -------------------------------------------------------------------------
  !< DEFERRED LAPACK BINDING AND ABI CONTRACT
  !< -------------------------------------------------------------------------
  !<
  !< The caller supplies ZHEEVDProcedure, a procedure with the interface
  !< ZHEEVDInterface.
  !<
  !< -------------------------------------------------------------------------
  !< Info
  !< -------------------------------------------------------------------------
  !< LAPACKs Status code. 0 on success. A nonzero status from the workspace
  !< query or from the computational call is propagated unchanged.
  !< If Dimension > huge(1_INT32), Info is set to huge(1_INT32).
  !< If Dimension == 0, Info is 0.
  !<
  !< NOTES
  !< -----
  !< - Unitary and Eigenvalues are valid only when Info == 0.
  !< - The routine has no global state. Concurrent calls are safe provided
  !<   the supplied ZHEEVD implementation is thread-safe.
  !<
  interface
    module subroutine DiagHermitian(Dimension, Matrix, Unitary, Eigenvalues, ZHEEVDProcedure, Info)
      integer(C_SIZE_T),          intent(in)            :: Dimension
      complex(C_DOUBLE_COMPLEX),  intent(in)            :: Matrix(Dimension, Dimension)
      complex(C_DOUBLE_COMPLEX),  intent(out)           :: Unitary(Dimension, Dimension)
      real(C_DOUBLE),             intent(out), optional :: Eigenvalues(Dimension)
      procedure(ZHEEVDInterface)                        :: ZHEEVDProcedure
      integer(C_INT),             intent(out)           :: Info
    end subroutine DiagHermitian
  end interface

  public :: ZHEEVDInterface
  public :: DiagHermitian

  !< Identifies degenerate levels in an ascending list of eigenvalues.
  !< Consecutive levels belong to the same group if their difference is
  !< less than or equal to DegeneracyThreshold.
  !< Degeneracy propagates transitively along consecutive levels.
  !< If Degeneracies(i) = N, then Eigenvalues(i:i+N-1) forms a degenerate
  !< group.
  !< The first element of each group stores the group size;
  !< the remaining ones are zero.
  !< DegeneracyThreshold <= 0 is a no-op.
  !<
  interface
    pure module subroutine DegeneracyGroup(Dimension, Eigenvalues, DegeneracyThreshold, Degeneracies)
      integer(C_SIZE_T), intent(in)  :: Dimension
      real(C_DOUBLE),    intent(in)  :: Eigenvalues(Dimension)
      real(C_DOUBLE),    intent(in)  :: DegeneracyThreshold
      integer(C_SIZE_T), intent(out) :: Degeneracies(Dimension)
    end subroutine DegeneracyGroup
  end interface

  public :: DegeneracyGroup

end module LapackDeferredWrappers

#endif
