#ifndef LapackDeferredWrappers_FH
#define LapackDeferredWrappers_FH

module LapackDeferredWrappers

  use, intrinsic :: ISO_FORTRAN_ENV, only: INT32, &
                                           REAL64, &
                                           LOGICAL32

  use, intrinsic :: ISO_C_BINDING, only: C_INT, &
                                         C_SIZE_T, &
                                         C_DOUBLE, &
                                         C_DOUBLE_COMPLEX

  implicit none

  private

  complex(C_DOUBLE_COMPLEX), parameter, public :: &
    Cmplx0 = cmplx(0.0_C_DOUBLE, 0.0_C_DOUBLE, C_DOUBLE_COMPLEX), &
    CmplxI = cmplx(0.0_C_DOUBLE, 1.0_C_DOUBLE, C_DOUBLE_COMPLEX), &
    Cmplx1 = cmplx(1.0_C_DOUBLE, 0.0_C_DOUBLE, C_DOUBLE_COMPLEX)

  public :: INT32
  public :: REAL64
  public :: LOGICAL32
  public :: C_INT
  public :: C_SIZE_T
  public :: C_DOUBLE
  public :: C_DOUBLE_COMPLEX

  abstract interface
    !< Abstract interface for the reference LAPACK ZHEEVD routine.
    !<
    !< Type mapping (reference LAPACK, LP64):
    !<   COMPLEX*16       -> complex(REAL64)
    !<   DOUBLE PRECISION -> real(REAL64)
    !<   INTEGER          -> integer(INT32)
    !<
    !< ILP64 LAPACK is not compatible with this interface.
    !<
    !< Reference documentation:
    !< https://www.netlib.org/lapack/explore-html/d8/d30/group__heevd_gae0a1270d44544514b5e0bf375dd83374.html
    subroutine ZHEEVDInterface(JOBZ, UPLO, &
                               N, A, LDA, &
                               W, &
                               WORK, LWORK, RWORK, LRWORK, IWORK, LIWORK, &
                               INFO)
      import INT32, REAL64
      character,       intent(in)    :: JOBZ
      character,       intent(in)    :: UPLO
      integer(INT32),  intent(in)    :: N
      complex(REAL64), intent(inout) :: A(LDA, N)
      integer(INT32),  intent(in)    :: LDA
      real(REAL64),    intent(out)   :: W(N)
      complex(REAL64), intent(out)   :: WORK(max(1_INT32, LWORK))
      integer(INT32),  intent(in)    :: LWORK
      real(REAL64),    intent(out)   :: RWORK(max(1_INT32, LRWORK))
      integer(INT32),  intent(in)    :: LRWORK
      integer(INT32),  intent(out)   :: IWORK(max(1_INT32, LIWORK))
      integer(INT32),  intent(in)    :: LIWORK
      integer(INT32),  intent(out)   :: INFO
    end subroutine ZHEEVDInterface
  end interface

  !< DiagHermitian computes the eigenvalues and orthonormal eigenvectors
  !< of a complex Hermitian matrix. The LAPACK ZHEEVD implementation is
  !< supplied by the caller at run time.
  !<
  !< -------------------------------------------------------------------------
  !< MATHEMATICAL PROBLEM
  !< -------------------------------------------------------------------------
  !<
  !< For a complex Hermitian matrix A of order N,
  !<
  !<     A = A^H,
  !<
  !< the routine computes
  !<
  !<     U^H * A * U = diag(W),   U^H * U = I,
  !<
  !< where W contains the eigenvalues in ascending order and the columns
  !< of U are the corresponding orthonormal eigenvectors.
  !<
  !< The working set is O(Dimension^2).
  !<
  !< -------------------------------------------------------------------------
  !< DEFERRED LAPACK BINDING AND ABI CONTRACT
  !< -------------------------------------------------------------------------
  !<
  !< The caller supplies ZHEEVDProcedure, a procedure with the interface
  !< ZHEEVDInterface.
  !<
  !< -------------------------------------------------------------------------
  !< Info
  !< -------------------------------------------------------------------------
  !<
  !< LAPACKs Status code. 0 on success. A nonzero status from the workspace
  !< query or from the computational call is propagated unchanged.
  !< If Dimension > huge(1_INT32), Info is set to huge(1_INT32).
  !< If Dimension == 0, Info is 0.
  !<
  !< -------------------------------------------------------------------------
  !< NOTES
  !< -------------------------------------------------------------------------
  !<
  !< - Unitary and Eigenvalues are valid only when Info == 0.
  !< - The routine has no global state. Concurrent calls are safe provided
  !<   the supplied ZHEEVD implementation is thread-safe.
  !<
  interface
    module subroutine DiagHermitian(Dimension, Matrix, &
                                    Unitary, Eigenvalues, &
                                    ZHEEVDProcedure, &
                                    Info)
      integer(C_SIZE_T),          intent(in)            :: Dimension
      complex(C_DOUBLE_COMPLEX),  intent(in)            :: Matrix(Dimension, Dimension)
      complex(C_DOUBLE_COMPLEX),  intent(out)           :: Unitary(Dimension, Dimension)
      real(C_DOUBLE),             intent(out), optional :: Eigenvalues(Dimension)
      procedure(ZHEEVDInterface)                        :: ZHEEVDProcedure
      integer(C_INT),             intent(out)           :: Info
    end subroutine DiagHermitian
  end interface

  public :: ZHEEVDInterface
  public :: DiagHermitian

  abstract interface
    !< Abstract interface for the reference LAPACK ZGEES routine.
    !<
    !< Type mapping (reference LAPACK, LP64):
    !<   COMPLEX*16       -> complex(REAL64)
    !<   DOUBLE PRECISION -> real(REAL64)
    !<   INTEGER          -> integer(INT32)
    !<   LOGICAL          -> logical(LOGICAL32)
    !<
    !< ILP64 LAPACK is not compatible with this interface.
    !<
    !< Reference documentation:
    !< https://netlib.org/lapack/explore-html/d5/d38/group__gees_gac426d99ddc8ac986de2a17e7ad3f2512.html
    subroutine ZGEESInterface(JOBVS, SORT, SELECT, &
                              N, A, LDA, &
                              SDIM, W, &
                              VS, LDVS, WORK, LWORK, RWORK, BWORK, &
                              INFO)
      import INT32, REAL64, LOGICAL32
      character,           intent(in)    :: JOBVS
      character,           intent(in)    :: SORT
      interface
        logical(LOGICAL32) function SELECT(C)
          import REAL64, LOGICAL32
          complex(REAL64), intent(in)    :: C
        end function SELECT
      end interface
      integer(INT32),      intent(in)    :: N
      complex(REAL64),     intent(inout) :: A(LDA, N)
      integer(INT32),      intent(in)    :: LDA
      integer(INT32),      intent(out)   :: SDIM
      complex(REAL64),     intent(out)   :: W(N)
      complex(REAL64),     intent(out)   :: VS(LDVS, N)
      integer(INT32),      intent(in)    :: LDVS
      complex(REAL64),     intent(out)   :: WORK(max(1_INT32, LWORK))
      integer(INT32),      intent(in)    :: LWORK
      real(REAL64),        intent(out)   :: RWORK(N)
      logical(LOGICAL32),  intent(out)   :: BWORK(N)
      integer(INT32),      intent(out)   :: INFO
    end subroutine ZGEESInterface
  end interface

  !< SchurDecomposition computes the Schur form and orthonormal eigenvectors
  !< of a complex matrix. The LAPACK ZGEES implementation is
  !< supplied by the caller at run time.
  !<
  !< -------------------------------------------------------------------------
  !< MATHEMATICAL PROBLEM
  !< -------------------------------------------------------------------------
  !<
  !< For a complex matrix A of order N, the routine computes
  !<
  !<     U^H * A * U = S,   U^H * U = I,
  !<
  !< where S is the upper triangular Schur form, and the columns
  !< of U are the corresponding orthonormal eigenvectors.
  !<
  !< The working set is O(Dimension^2).
  !<
  !< -------------------------------------------------------------------------
  !< DEFERRED LAPACK BINDING AND ABI CONTRACT
  !< -------------------------------------------------------------------------
  !<
  !< The caller supplies ZGEESProcedure, a procedure with the interface
  !< ZGEESInterface.
  !<
  !< -------------------------------------------------------------------------
  !< Info
  !< -------------------------------------------------------------------------
  !<
  !< LAPACKs Status code. 0 on success. A nonzero status from the workspace
  !< query or from the computational call is propagated unchanged.
  !< If Dimension > huge(1_INT32), Info is set to huge(1_INT32).
  !< If Dimension == 0, Info is 0.
  !<
  !< -------------------------------------------------------------------------
  !< NOTES
  !< -------------------------------------------------------------------------
  !<
  !< - Unitary and SchurForm are valid only when Info == 0.
  !< - The routine has no global state. Concurrent calls are safe provided
  !<   the supplied ZGEES implementation is thread-safe.
  !<
  interface
    module subroutine SchurDecomposition(Dimension, Matrix, &
                                         Unitary, SchurForm, &
                                         ZGEESProcedure, &
                                         Info)
      integer(C_SIZE_T),          intent(in)            :: Dimension
      complex(C_DOUBLE_COMPLEX),  intent(in)            :: Matrix(Dimension, Dimension)
      complex(C_DOUBLE_COMPLEX),  intent(out)           :: Unitary(Dimension, Dimension)
      complex(C_DOUBLE_COMPLEX),  intent(out), optional :: SchurForm(Dimension, Dimension)
      procedure(ZGEESInterface)                         :: ZGEESProcedure
      integer(C_INT),             intent(out)           :: Info
    end subroutine SchurDecomposition
  end interface

  public :: ZGEESInterface
  public :: SchurDecomposition

  abstract interface
    !< Abstract interface for the reference LAPACK ZGESDD routine.
    !<
    !< Type mapping (reference LAPACK, LP64):
    !<   COMPLEX*16       -> complex(REAL64)
    !<   DOUBLE PRECISION -> real(REAL64)
    !<   INTEGER          -> integer(INT32)
    !<
    !< ILP64 LAPACK is not compatible with this interface.
    !<
    !< Reference documentation:
    !< https://netlib.org/lapack/explore-html/df/d22/group__gesdd_ga58d8bb0bce9bb2d6224d1955cef7462c.html
    subroutine ZGESDDInterface(JOBZ, &
                               M, N, A, LDA, &
                               S, U, LDU, VT, LDVT, &
                               WORK, LWORK, RWORK, IWORK, &
                               INFO)
      import INT32, REAL64
      character,       intent(in)    :: JOBZ
      integer(INT32),  intent(in)    :: M
      integer(INT32),  intent(in)    :: N
      complex(REAL64), intent(inout) :: A(LDA, N)
      integer(INT32),  intent(in)    :: LDA
      real(REAL64),    intent(out)   :: S(min(M, N))
      complex(REAL64), intent(out)   :: U(LDU, *)
      integer(INT32),  intent(in)    :: LDU
      complex(REAL64), intent(out)   :: VT(LDVT, N)
      integer(INT32),  intent(in)    :: LDVT
      complex(REAL64), intent(out)   :: WORK(max(1_INT32, LWORK))
      integer(INT32),  intent(in)    :: LWORK
      real(REAL64),    intent(out)   :: RWORK(*)
      integer(INT32),  intent(out)   :: IWORK(*)
      integer(INT32),  intent(out)   :: INFO
    end subroutine ZGESDDInterface
  end interface

  !< SVDDecomposition computes the singular value decomposition of a
  !< complex matrix. The LAPACK ZGESDD implementation is supplied by the
  !< caller at run time.
  !<
  !< -------------------------------------------------------------------------
  !< MATHEMATICAL PROBLEM
  !< -------------------------------------------------------------------------
  !<
  !< For a complex DimensionR-by-DimensionC matrix A, the routine computes
  !<
  !<     U^H * A * V = diag(S),   U^H * U = I, V^H * V = I,
  !<
  !< where S contains the singular values in ascending order, and the columns
  !< of U and V are the corresponding orthonormal left and right singular
  !< vectors. For j = 1 .. min(DimensionR, DimensionC), DiagSigma(j) pairs
  !< with column j of UnitaryU and row j of UnitaryVH; the remaining columns
  !< of U and V complete the orthonormal bases.
  !<
  !< The working set is O(DimensionR * DimensionC).
  !<
  !< -------------------------------------------------------------------------
  !< DEFERRED LAPACK BINDING AND ABI CONTRACT
  !< -------------------------------------------------------------------------
  !<
  !< The caller supplies ZGESDDProcedure, a procedure with the interface
  !< ZGESDDInterface.
  !<
  !< -------------------------------------------------------------------------
  !< Info
  !< -------------------------------------------------------------------------
  !<
  !< LAPACKs Status code. 0 on success. A nonzero status from the workspace
  !< query or from the computational call is propagated unchanged.
  !< If either dimension exceeds huge(1_INT32), Info is set to huge(1_INT32).
  !< If either dimension is 0, Info is 0.
  !<
  !< -------------------------------------------------------------------------
  !< NOTES
  !< -------------------------------------------------------------------------
  !<
  !< - UnitaryU, DiagSigma and UnitaryVH are valid only when Info == 0.
  !< - This routine returns conjugate(transpose(V)) = V^(-1), not V.
  !< - The routine has no global state. Concurrent calls are safe provided
  !<   the supplied ZGESDD implementation is thread-safe.
  !<
  interface
    module subroutine SVDDecomposition(DimensionR, DimensionC, Matrix, &
                                       UnitaryU, DiagSigma, UnitaryVH, &
                                       ZGESDDProcedure, &
                                       Info)
      integer(C_SIZE_T),         intent(in)            :: DimensionR
      integer(C_SIZE_T),         intent(in)            :: DimensionC
      complex(C_DOUBLE_COMPLEX), intent(in)            :: Matrix(DimensionR, DimensionC)
      complex(C_DOUBLE_COMPLEX), intent(out)           :: UnitaryU(DimensionR, DimensionR)
      real(C_DOUBLE),            intent(out), optional :: DiagSigma(min(DimensionR, DimensionC))
      complex(C_DOUBLE_COMPLEX), intent(out)           :: UnitaryVH(DimensionC, DimensionC)
      procedure(ZGESDDInterface)                       :: ZGESDDProcedure
      integer(C_INT),            intent(out)           :: Info
    end subroutine SVDDecomposition
  end interface

  public :: ZGESDDInterface
  public :: SVDDecomposition

  abstract interface
    !< Abstract interface for the reference LAPACK ZGGES routine.
    !<
    !< Type mapping (reference LAPACK, LP64):
    !<   COMPLEX*16       -> complex(REAL64)
    !<   DOUBLE PRECISION -> real(REAL64)
    !<   INTEGER          -> integer(INT32)
    !<   LOGICAL          -> logical(LOGICAL32)
    !<
    !< ILP64 LAPACK is not compatible with this interface.
    !<
    !< Reference documentation:
    !< https://netlib.org/lapack/explore-html/d7/d25/group__gges_ga4943e11fd632761e645ce1e5161f9f51.html
    subroutine ZGGESInterface(JOBVSL, JOBVSR, SORT, SELCTG, &
                              N, A, LDA, B, LDB, &
                              SDIM, ALPHA, BETA, &
                              VSL, LDVSL, VSR, LDVSR, &
                              WORK, LWORK, RWORK, BWORK, INFO)
      import INT32, REAL64, LOGICAL32
      character,           intent(in)    :: JOBVSL
      character,           intent(in)    :: JOBVSR
      character,           intent(in)    :: SORT
      interface
        logical(LOGICAL32) function SELCTG(ALPHA, BETA)
          import REAL64, LOGICAL32
          complex(REAL64), intent(in)    :: ALPHA
          complex(REAL64), intent(in)    :: BETA
        end function SELCTG
      end interface
      integer(INT32),      intent(in)    :: N
      complex(REAL64),     intent(inout) :: A(LDA, N)
      integer(INT32),      intent(in)    :: LDA
      complex(REAL64),     intent(inout) :: B(LDB, N)
      integer(INT32),      intent(in)    :: LDB
      integer(INT32),      intent(out)   :: SDIM
      complex(REAL64),     intent(out)   :: ALPHA(N)
      complex(REAL64),     intent(out)   :: BETA(N)
      complex(REAL64),     intent(out)   :: VSL(LDVSL, N)
      integer(INT32),      intent(in)    :: LDVSL
      complex(REAL64),     intent(out)   :: VSR(LDVSR, N)
      integer(INT32),      intent(in)    :: LDVSR
      complex(REAL64),     intent(out)   :: WORK(max(1_INT32, LWORK))
      integer(INT32),      intent(in)    :: LWORK
      real(REAL64),        intent(out)   :: RWORK(8 * N)
      logical(LOGICAL32),  intent(out)   :: BWORK(N)
      integer(INT32),      intent(out)   :: INFO
    end subroutine ZGGESInterface
  end interface

  !< GeneralizedSchurDecomposition computes the generalized Schur
  !< decomposition of the complex matrix pair (A, B). The LAPACK ZGGES
  !< implementation is supplied by the caller at run time.
  !<
  !< -------------------------------------------------------------------------
  !< MATHEMATICAL PROBLEM
  !< -------------------------------------------------------------------------
  !<
  !< For a pair of complex matrices A, B of order N, the routine computes
  !<
  !<     U^H * A * V = S,   U^H * B * V = T
  !<
  !<     U^H * U = I,   V^H * V = I,
  !<
  !< where S, T are the upper triangular Schur forms, and the columns
  !< of U and V are the corresponding orthonormal left and right
  !< eigenvectors.
  !<
  !< The working set is O(Dimension^2).
  !<
  !< -------------------------------------------------------------------------
  !< DEFERRED LAPACK BINDING AND ABI CONTRACT
  !< -------------------------------------------------------------------------
  !<
  !< The caller supplies ZGGESProcedure, a procedure with the interface
  !< ZGGESInterface.
  !<
  !< -------------------------------------------------------------------------
  !< Info
  !< -------------------------------------------------------------------------
  !<
  !< LAPACKs Status code. 0 on success. A nonzero status from the workspace
  !< query or from the computational call is propagated unchanged.
  !< If Dimension exceeds huge(1_INT32), Info is set to huge(1_INT32).
  !< If Dimension == 0, Info is 0.
  !<
  !< -------------------------------------------------------------------------
  !< NOTES
  !< -------------------------------------------------------------------------
  !<
  !< - UnitaryU, EigenvaluesA, EigenvaluesB and UnitaryVH are valid only
  !<   when Info == 0.
  !< - This routine returns conjugate(transpose(V)) = V^(-1), not V.
  !< - The routine has no global state. Concurrent calls are safe provided
  !<   the supplied ZGGES implementation is thread-safe.
  !<
  interface
    module subroutine GeneralizedSchurDecomposition(Dimension, MatrixA, MatrixB, &
                                                    UnitaryU, EigenvaluesA, EigenvaluesB, UnitaryVH, &
                                                    ZGGESProcedure, &
                                                    Info)
      integer(C_SIZE_T),         intent(in)            :: Dimension
      complex(C_DOUBLE_COMPLEX), intent(in)            :: MatrixA(Dimension, Dimension)
      complex(C_DOUBLE_COMPLEX), intent(in)            :: MatrixB(Dimension, Dimension)
      complex(C_DOUBLE_COMPLEX), intent(out)           :: UnitaryU(Dimension, Dimension)
      complex(C_DOUBLE_COMPLEX), intent(out), optional :: EigenvaluesA(Dimension)
      complex(C_DOUBLE_COMPLEX), intent(out), optional :: EigenvaluesB(Dimension)
      complex(C_DOUBLE_COMPLEX), intent(out)           :: UnitaryVH(Dimension, Dimension)
      procedure(ZGGESInterface)                        :: ZGGESProcedure
      integer(C_INT),            intent(out)           :: Info
    end subroutine GeneralizedSchurDecomposition
  end interface

  public :: ZGGESInterface
  public :: GeneralizedSchurDecomposition

  !< Identifies degenerate levels in an ascending list of eigenvalues.
  !< Consecutive levels belong to the same group if their difference is
  !< less than or equal to DegeneracyThreshold.
  !< Degeneracy propagates transitively along consecutive levels.
  !< If Degeneracies(i) = N, then Eigenvalues(i:i+N-1) forms a degenerate
  !< group.
  !< The first element of each group stores the group size;
  !< the remaining ones are zero.
  !< DegeneracyThreshold <= 0 is a no-op.
  !<
  interface
    pure module subroutine DegeneracyGroup(Dimension, &
                                           Eigenvalues, &
                                           DegeneracyThreshold, &
                                           Degeneracies)
      integer(C_SIZE_T), intent(in)  :: Dimension
      real(C_DOUBLE),    intent(in)  :: Eigenvalues(Dimension)
      real(C_DOUBLE),    intent(in)  :: DegeneracyThreshold
      integer(C_SIZE_T), intent(out) :: Degeneracies(Dimension)
    end subroutine DegeneracyGroup
  end interface

  public :: DegeneracyGroup

  !< DiagHermitian, as called from C.
  !<
  !< Matrix, Unitary and Eigenvalues are C pointers to Dimension-sized
  !< arrays; Info receives the LAPACK error code, and a dimension that does
  !< not fit a default integer is reported there. A null pointer makes the
  !< wrapper return without touching the other arguments.
  !<
  interface
    module subroutine DiagHermitian_C(Dimension, Matrix, Unitary, &
                                      Eigenvalues, ZHEEVDProcedure, Info) &
      bind(C, name="DiagHermitian")
      use, intrinsic :: ISO_C_BINDING, only: C_PTR, &
                                             C_FUNPTR

      integer(C_SIZE_T), intent(in), value :: Dimension
      type(C_PTR),       intent(in), value :: Matrix
      type(C_PTR),       intent(in), value :: Unitary
      type(C_PTR),       intent(in), value :: Eigenvalues
      type(C_FUNPTR),    intent(in), value :: ZHEEVDProcedure
      type(C_PTR),       intent(in), value :: Info
    end subroutine DiagHermitian_C
  end interface

  !< SchurDecomposition, as called from C.
  !<
  !< Unitary receives the Schur vectors when it is associated, while
  !< SchurForm is the triangular factor. Null pointers behave as in
  !< DiagHermitian_C.
  !<
  interface
    module subroutine SchurDecomposition_C(Dimension, Matrix, Unitary, &
                                           SchurForm, ZGEESProcedure, &
                                           Info) &
      bind(C, name="SchurDecomposition")
      use, intrinsic :: ISO_C_BINDING, only: C_PTR, &
                                             C_FUNPTR

      integer(C_SIZE_T), intent(in), value :: Dimension
      type(C_PTR),       intent(in), value :: Matrix
      type(C_PTR),       intent(in), value :: Unitary
      type(C_PTR),       intent(in), value :: SchurForm
      type(C_FUNPTR),    intent(in), value :: ZGEESProcedure
      type(C_PTR),       intent(in), value :: Info
    end subroutine SchurDecomposition_C
  end interface

  !< SVDDecomposition, as called from C.
  !<
  !< Matrix is a DimensionR by DimensionC C array; DiagSigma receives the
  !< smallest of the two dimensions singular values, while UnitaryU and
  !< UnitaryVH receive the unitary factors when they are associated. Null
  !< pointers behave as in DiagHermitian_C.
  !<
  interface
    module subroutine SVDDecomposition_C(DimensionR, DimensionC, Matrix, &
                                         UnitaryU, DiagSigma, UnitaryVH, &
                                         ZGESDDProcedure, Info) &
      bind(C, name="SVDDecomposition")
      use, intrinsic :: ISO_C_BINDING, only: C_PTR, &
                                             C_FUNPTR

      integer(C_SIZE_T), intent(in), value :: DimensionR
      integer(C_SIZE_T), intent(in), value :: DimensionC
      type(C_PTR),       intent(in), value :: Matrix
      type(C_PTR),       intent(in), value :: UnitaryU
      type(C_PTR),       intent(in), value :: DiagSigma
      type(C_PTR),       intent(in), value :: UnitaryVH
      type(C_FUNPTR),    intent(in), value :: ZGESDDProcedure
      type(C_PTR),       intent(in), value :: Info
    end subroutine SVDDecomposition_C
  end interface

  !< GeneralizedSchurDecomposition, as called from C.
  !<
  !< UnitaryU and UnitaryVH receive the unitary factors when they are associated,
  !< while EigenvaluesA/B are the generalized eigenvalues.
  !< Null pointers behave as in DiagHermitian_C.
  interface
    module subroutine GeneralizedSchurDecomposition_C(Dimension, MatrixA, MatrixB, &
                                                      UnitaryU, EigenvaluesA, EigenvaluesB, UnitaryVH, &
                                                      ZGGESProcedure, &
                                                      Info) &
      bind(C, name="GeneralizedSchurDecomposition")
      use, intrinsic :: ISO_C_BINDING, only: C_PTR, &
                                             C_FUNPTR

      integer(C_SIZE_T), intent(in), value :: Dimension
      type(C_PTR),       intent(in), value :: MatrixA
      type(C_PTR),       intent(in), value :: MatrixB
      type(C_PTR),       intent(in), value :: UnitaryU
      type(C_PTR),       intent(in), value :: EigenvaluesA
      type(C_PTR),       intent(in), value :: EigenvaluesB
      type(C_PTR),       intent(in), value :: UnitaryVH
      type(C_FUNPTR),    intent(in), value :: ZGGESProcedure
      type(C_PTR),       intent(in), value :: Info
    end subroutine GeneralizedSchurDecomposition_C
  end interface

  !< DegeneracyGroup, as called from C.
  !<
  !< Eigenvalues is a C array of Dimension doubles and Degeneracies
  !< receives, for each eigenvalue, the index of the group it belongs to.
  !< Either pointer being null makes the wrapper return immediately.
  !<
  interface
    module subroutine DegeneracyGroup_C(Dimension, Eigenvalues, &
                                        DegeneracyThreshold, Degeneracies) &
      bind(C, name="DegeneracyGroup")
      use, intrinsic :: ISO_C_BINDING, only: C_PTR

      integer(C_SIZE_T), intent(in), value :: Dimension
      type(C_PTR),       intent(in), value :: Eigenvalues
      real(C_DOUBLE),    intent(in), value :: DegeneracyThreshold
      type(C_PTR),       intent(in), value :: Degeneracies
    end subroutine DegeneracyGroup_C
  end interface

end module LapackDeferredWrappers

#endif
